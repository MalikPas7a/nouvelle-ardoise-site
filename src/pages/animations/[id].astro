---
// Une animation au défilement, seule sur sa page et en plein écran.
// Ouverte depuis les onglets « Vos plats, en mouvement » de l'accueil.
import Base from '../../layouts/Base.astro';
import { ANIMATIONS } from '../../data/animations.js';

export function getStaticPaths() {
  return ANIMATIONS.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const autres = ANIMATIONS.filter((x) => x.id !== a.id);
---
<Base page="animation" title={`${a.titre} | Nouvelle Ardoise`} description={a.resume}>

<section class={`sequence sequence--${a.id}`} data-sequence={a.id} data-images={a.images} data-tailles="m,g" data-couvre aria-label={a.titre}>
  <div class="sequence__colle">
    <canvas class="sequence__toile" aria-hidden="true"></canvas>
    <div class="sequence__voile" aria-hidden="true"></div>
    <!-- Chocolat : la création finie, photographiée seule sur fond blanc, remplace la vidéo en fondu -->
    {a.id === 'chocolat' && (
      <div class="sequence__finale" aria-hidden="true">
        <img src="/artisans/tarte-finale.webp" srcset="/artisans/tarte-finale-900.webp 900w, /artisans/tarte-finale.webp 1600w" sizes="(min-width: 900px) 62vw, 100vw" alt="" width="1600" height="1279" decoding="async" />
      </div>
    )}
    <div class="cadre sequence__textes">
      {a.id === 'sushi' && (
        <Fragment>
          <div class="sequence__texte" data-de="-0.1" data-a="0.2">
            <h1 class="titre-2">Le riz, vinaigré maison.</h1>
            <p class="chapo">Étalé à la main sur la natte de bambou.</p>
            <p class="sequence__indice"><span></span>Faites défiler</p>
          </div>
          <div class="sequence__texte" data-de="0.22" data-a="0.44">
            <p class="titre-2">Le saumon, tranché à la main.</p>
            <p class="chapo">Posé sur le maki, une tranche après l’autre.</p>
          </div>
          <div class="sequence__texte" data-de="0.46" data-a="0.67">
            <p class="titre-2">Dressé à la minute.</p>
          </div>
          <div class="sequence__texte" data-de="0.69" data-a="1.01">
            <p class="titre-2">Prêt à déguster.</p>
            <p class="chapo">Nous filmons votre chef et vos plats, puis nous construisons le site autour.</p>
            <div class="actions"><a class="btn btn--jaune" href="/contact/">Demander un devis</a></div>
          </div>
        </Fragment>
      )}
      {a.id === 'chocolat' && (
        <Fragment>
          <div class="sequence__texte" data-de="-0.1" data-a="0.17">
            <h1 class="titre-2">Le chocolat, tempéré.</h1>
            <p class="chapo">À la bonne température, au degré près.</p>
            <p class="sequence__indice"><span></span>Faites défiler</p>
          </div>
          <div class="sequence__texte" data-de="0.2" data-a="0.38"><p class="titre-2">Coulé dans le moule.</p></div>
          <div class="sequence__texte" data-de="0.41" data-a="0.57"><p class="titre-2">Chaque coque, à la bonne épaisseur.</p></div>
          <div class="sequence__texte" data-de="0.6" data-a="0.77"><p class="titre-2">Le surplus, raclé d’un geste.</p></div>
          <div class="sequence__texte sequence__texte--clair" data-de="0.8" data-a="1.01">
            <p class="titre-2">Puis la création.</p>
            <p class="chapo">C’est ce que vos clients ne voient jamais. Nous le filmons chez vous, puis nous construisons le site autour.</p>
            <div class="actions"><a class="btn btn--jaune" href="/contact/">Demander un devis</a></div>
          </div>
        </Fragment>
      )}
    </div>
  </div>
</section>

<section class="bloc bloc--ardoise anim-fin">
  <div class="cadre anim-fin__in">
    <h2 class="titre-2">La même chose avec votre plat ?</h2>
    <p>Nous filmons chez vous, ou nous créons l’animation de votre plat signature, puis nous l’installons sur votre site.</p>
    <div class="actions">
      <a class="btn btn--jaune" href="/contact/">Demander un devis</a>
      {autres.map((x) => <a class="lien" href={`/animations/${x.id}/`}>Voir l’animation {x.onglet.toLowerCase()}</a>)}
      <a class="lien" href="/realisations/#en-mouvement">Retour aux exemples</a>
    </div>
    {a.credit && <p class="anim-fin__credit"><a href={a.creditLien}>{a.credit}</a></p>}
  </div>
</section>

</Base>

<script>
  import '../../scripts/defilement.js';
</script>
