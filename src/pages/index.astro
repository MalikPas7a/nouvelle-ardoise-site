  .ecran--ouvert .ecran__mesure { animation: none; }
  .carte *, .bi__voyants li::before, .g__item--vous, .g__pin--vous, .faq__plus::before, .faq__plus::after, .spe, .spe__fleche { transition: none !important; animation: none !important; }
