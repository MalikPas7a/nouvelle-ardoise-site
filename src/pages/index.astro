.pan { position: relative; flex: none; width: var(--vw, 100vw); height: 100%; overflow: hidden; box-sizing: border-box; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 14px; padding-top: calc(env(safe-area-inset-top, 0px) + 84px); padding-bottom: calc(var(--barre-bas) + 24px + 100lvh - 100svh); }
.pan--papier { background: var(--papier); color: var(--ardoise); --trait: var(--ardoise); --fond-fig: var(--papier-clair); --mot: var(--ardoise); }
