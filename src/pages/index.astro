.m-ens .vitre { position: absolute; left: 11%; right: 11%; bottom: 0; height: 30%; background: linear-gradient(rgb(255 196 120 / .25), rgb(255 160 90 / .08)); border: 3px solid #0d0f12; border-bottom: 0; }
.m-sac { background: #D8D1C4; }
.m-sac .sac { position: relative; width: 46%; aspect-ratio: .78; background: linear-gradient(100deg, #b98c5c, #cfa474 45%, #b5895a); border-radius: 3px 3px 6px 6px; box-shadow: 18px 24px 30px -18px rgb(0 0 0 / .45); display: grid; place-items: center; margin-top: 14%; }
.m-sac .sac::before { content: ""; position: absolute; top: -26%; left: 30%; width: 40%; height: 34%; border: 7px solid #a77c4f; border-bottom: 0; border-radius: 60px 60px 0 0; }
.m-sac .sac::after { content: ""; position: absolute; inset: 0 0 auto; height: 9%; background: rgb(0 0 0 / .08); }
.m-sac .sac .iz-img { width: 60%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; mix-blend-mode: multiply; }
.m-box { background: #2B2B2B; }
.m-box .boite { width: 58%; aspect-ratio: 1.35; background: linear-gradient(160deg, #c99a68, #a97b4c); border-radius: 4px; position: relative; display: grid; place-items: center; box-shadow: 0 40px 40px -24px rgb(0 0 0 / .8); transform: perspective(700px) rotateX(28deg); }
.m-box .boite .iz-img { width: 46%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 4px solid var(--iz-creme); }
.m-carte { background: #3b2f27; }
.m-carte .feuille { width: 56%; aspect-ratio: .7; background: var(--iz-creme); color: var(--iz-vert); padding: 7% 7%; display: grid; align-content: start; gap: 8px; box-shadow: 0 30px 40px -20px rgb(0 0 0 / .7); transform: rotate(-3deg); }
.m-carte .feuille .iz-img { width: 34%; aspect-ratio: 1; object-fit: cover; margin: 0 auto 6px; }
