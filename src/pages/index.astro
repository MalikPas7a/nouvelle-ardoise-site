---
// Accueil « Papier et encre » (refonte du 21.10.2026) : une seule police, le jaune craie pour surligner,
// l'accompagnement en 5 étapes, l'équipe, les canaux, Pasta Mo' (cas réel) et Izgara 35 (démonstration fictive).
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/800.css';
import { SITE } from '../config.js';
import { OFFRES, PROMOTION_ACTIVE, catalogueOffres, montant, prixActuel } from '../data/offres.js';
const title = 'Agence marketing restaurants Genève | Nouvelle Ardoise';
const description = 'Agence de marketing et de communication pour la restauration et les métiers de bouche à Genève et Vaud : étude de marché, stratégie, identité, site, réseaux, publicité et commande en ligne.';
const canonical = SITE.url + '/';
const image = SITE.url + '/partage.jpg';
const PRIX = [
  { id: 'essentiel', etiquette: 'Site', nom: 'Site sur mesure', texte: 'Pour téléphone, carte en ligne, horaires, plan et fiche Google.' },
  { id: 'reseauxEssentiel', etiquette: 'Réseaux', nom: 'Réseaux sociaux', mois: true, texte: 'Shooting chaque mois, quatre réels, plat du jour publié.' },
  { id: 'lancement', etiquette: 'Lancement', nom: 'Pack lancement', texte: 'Deux heures de tournage, quatre réels montés, photos des plats.' },
];
const jsonLd = JSON.stringify({
  '@context':'https://schema.org', '@type':'ProfessionalService', '@id':SITE.url+'/#agence',
  name:SITE.nom, url:canonical, description, email:SITE.email, telephone:'+41782133868', image,
  founder:{'@type':'Person',name:SITE.responsable},
  address:{'@type':'PostalAddress',streetAddress:SITE.adresse,postalCode:SITE.localite.split(' ')[0],addressLocality:'Genève',addressCountry:'CH'},
  areaServed:[{'@type':'AdministrativeArea',name:'Genève'},{'@type':'AdministrativeArea',name:'Vaud'}],
  sameAs:['https://www.instagram.com/'+SITE.instagram+'/'],
  hasOfferCatalog:catalogueOffres(SITE.url),
});
---
<!doctype html>
<html lang="fr-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#F4F4F0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.nom} />
  <meta property="og:locale" content="fr_CH" />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <style is:global>
/* Grille suisse 12 colonnes, papier et encre ; le jaune craie ne sert qu'à surligner. Un seul thème, voulu (papier).
   Les couleurs vert/or ne servent qu'à l'identité fictive du client (Izgara 35). */
:root {
  --papier: #F4F4F0;
  --encre: #121211;
  --gris: #5E5E58;
  --filet: #D6D6CF;
  --craie: #FFD23F;
  --blanc: #FFFFFF;
  --iz-vert: #1E3A5F;
  --iz-or: #BF5734;
  --iz-creme: #EFE6D2;
  --grotesk: 'Schibsted Grotesk Variable', 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif;
  --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
  --iz-serif: 'Playfair Display', Georgia, serif;
  --max: 1240px;
  color-scheme: light;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--papier); color: var(--encre); font-family: var(--grotesk); font-size: 17px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
a { color: inherit; }
img { display: block; max-width: 100%; height: auto; }
:focus-visible { outline: 2px solid var(--encre); outline-offset: 3px; }
.cadre { max-width: var(--max); margin-inline: auto; padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px)); }
.etiquette { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--gris); margin: 0; }
.surligne { background: linear-gradient(transparent 58%, var(--craie) 58%, var(--craie) 92%, transparent 92%); padding-inline: .06em; }

.maquette { background: var(--encre); color: var(--papier); font-family: var(--mono); font-size: 12px; text-align: center; padding-block: 6px; padding-inline: 16px; }
.promo { display: block; background: var(--craie); color: var(--encre); text-align: center; font-size: 14px; padding-block: 9px; padding-inline: 16px; text-decoration: none; }
.promo b { font-weight: 700; }

body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--papier); }
.tete { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--papier); border-bottom: 1px solid var(--filet); }
.tete .cadre { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; }
.marque { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; letter-spacing: -.01em; white-space: nowrap; }
.marque svg { width: 22px; height: 25px; }
.marque svg path { fill: none; stroke: var(--encre); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.nav { display: flex; gap: 28px; align-items: center; font-size: 15px; }
.nav a { text-decoration: none; }
.nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
.nav .tel { font-family: var(--mono); font-size: 13px; padding: 8px 12px; border: 1px solid var(--encre); border-radius: 999px; white-space: nowrap; }
.nav .tel:hover { background: var(--encre); color: var(--papier); text-decoration: none; }

/* Ouverture */
.ouv { padding-block: clamp(44px, 8vw, 110px) clamp(40px, 6vw, 72px); }
.ouv h1 { font-size: clamp(52px, 11.5vw, 168px); line-height: .9; letter-spacing: -.055em; font-weight: 800; margin: 18px 0 0; text-wrap: balance; }
.trait { position: relative; display: inline-block; }
.trait svg { position: absolute; left: -2%; bottom: -.08em; width: 104%; height: .32em; overflow: visible; }
.trait path { fill: none; stroke: var(--craie); stroke-width: 14; stroke-linecap: round; stroke-dasharray: 1000; animation: craie 1.1s cubic-bezier(.6,0,.2,1) .25s both; }
.trait > span { position: relative; }
@keyframes craie { from { stroke-dashoffset: 1000; } to { stroke-dashoffset: 0; } }
.ouv__bas { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; margin-top: clamp(28px, 4vw, 56px); align-items: end; }
.ouv__bas p { grid-column: 1 / span 6; margin: 0; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.35; max-width: 36ch; }
.ouv__bas .actions { grid-column: 8 / span 5; display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; }
.btn { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px; background: var(--encre); color: var(--papier); text-decoration: none; font-weight: 600; font-size: 15px; border: 1px solid var(--encre); }
.btn:hover { background: var(--craie); color: var(--encre); }
.btn--creux { background: transparent; color: var(--encre); }

/* Mur animé (en attendant la vidéo) */
.mur { margin-top: clamp(32px, 5vw, 56px); display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: 260px 260px; gap: 8px; }
.tuile { position: relative; overflow: hidden; background: var(--encre); min-width: 0; }
.tuile > img { width: 100%; height: 100%; object-fit: cover; animation: lent 18s ease-in-out infinite alternate; }
@keyframes lent { from { transform: scale(1); } to { transform: scale(1.12); } }
.tuile__nom { position: absolute; left: 12px; bottom: 12px; background: var(--papier); color: var(--encre); font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 5px 9px; }
.t-photo { grid-row: span 2; }
.t-logo { background: var(--iz-or); display: grid; place-items: center; }
.t-logo .iz-img { width: 100%; height: 100%; object-fit: contain; }
.iz-img { display: block; }
.t-site { background: #D9D4C7; display: grid; place-items: center; grid-row: span 2; }
.t-cmd { background: var(--blanc); border: 1px solid var(--encre); padding: 14px; display: flex; flex-direction: column; gap: 8px; justify-content: flex-end; }
.t-cmd .tuile__nom { position: static; align-self: flex-start; border: 1px solid var(--filet); }

/* Logo Izgara (fictif) : traits qui se dessinent */
.iz-trait { fill: none; stroke: var(--iz-or); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 220; animation: dessin 2.4s ease .4s both; }
.iz-flamme { fill: var(--iz-or); animation: flamme 2.6s ease-in-out infinite; transform-origin: 100px 34px; }
.iz-txt { fill: var(--iz-creme); font-family: var(--iz-serif); font-weight: 800; }
.iz-or-txt { fill: var(--iz-or); font-family: var(--iz-serif); font-weight: 700; }
.iz-petit { fill: var(--iz-or); font-family: var(--grotesk); font-size: 9px; letter-spacing: 3px; font-weight: 600; }
@keyframes dessin { from { stroke-dashoffset: 220; } to { stroke-dashoffset: 0; } }
@keyframes flamme { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08, 1.14); } }

/* Téléphone (site du client) */
.tel-cadre { width: min(220px, 78%); aspect-ratio: 9 / 18.5; background: var(--iz-vert); border: 6px solid var(--encre); border-radius: 30px; overflow: hidden; position: relative; }
.tel-defile { animation: defile 14s ease-in-out infinite; padding: 16px 14px; display: grid; gap: 12px; color: var(--iz-creme); }
@keyframes defile { 0%, 12% { transform: translateY(0); } 45%, 60% { transform: translateY(-46%); } 92%, 100% { transform: translateY(0); } }
.tel-defile .iz-img { width: 70%; border-radius: 8px; margin: 6px auto 0; display: block; }
.tel-defile h4 { margin: 0; font-family: var(--iz-serif); font-size: 20px; line-height: 1.05; text-align: center; }
.tel-defile .bouton { background: var(--iz-or); color: var(--iz-creme); text-align: center; border-radius: 999px; padding: 8px; font-size: 12px; font-weight: 700; }
.tel-defile .plat { display: flex; justify-content: space-between; border-top: 1px solid rgb(239 230 210 / .2); padding-top: 8px; font-size: 12px; gap: 8px; }
.tel-defile .plat small { display: block; opacity: .6; font-size: 10px; }

/* Notifications */
.notif { display: flex; gap: 10px; align-items: center; background: var(--papier); border: 1px solid var(--filet); padding: 9px 10px; font-size: 13px; line-height: 1.25; animation: entre .5s cubic-bezier(.2,.8,.2,1) both; }
.notif i { width: 8px; height: 8px; border-radius: 50%; background: var(--craie); box-shadow: 0 0 0 1px var(--encre); flex: none; }
.notif small { display: block; color: var(--gris); font-size: 11px; }
.notif b { margin-left: auto; font-variant-numeric: tabular-nums; white-space: nowrap; }
@keyframes entre { from { transform: translateY(14px); opacity: .2; } to { transform: none; opacity: 1; } }

/* Sections */
.sec { padding-block: clamp(64px, 10vw, 140px); border-top: 1px solid var(--filet); }
.sec__tete { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }
.sec__tete .etiquette { grid-column: 1 / span 3; padding-top: 12px; }
.sec__tete h2 { grid-column: 4 / span 9; margin: 0; font-size: clamp(36px, 5.6vw, 80px); line-height: .98; letter-spacing: -.045em; font-weight: 750; text-wrap: balance; }
.sec__tete p.chapo { grid-column: 4 / span 6; margin: 0; font-size: 19px; color: var(--gris); max-width: 46ch; }

/* Accompagnement */
.etapes { border-top: 1px solid var(--encre); }
.etape { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; padding-block: 28px; border-bottom: 1px solid var(--filet); align-items: center; }
.etape .n { grid-column: 1 / span 1; font-family: var(--mono); font-size: 13px; align-self: start; padding-top: 10px; }
.etape h3 { grid-column: 2 / span 4; margin: 0; font-size: clamp(26px, 2.8vw, 38px); letter-spacing: -.035em; line-height: 1.02; font-weight: 750; }
.etape .detail { grid-column: 6 / span 4; min-width: 0; }
.etape .detail p { margin: 0 0 12px; color: var(--gris); }
.puces { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; list-style: none; }
.puces li { font-family: var(--mono); font-size: 12px; border: 1px solid var(--encre); border-radius: 999px; padding: 4px 10px; }
.etape figure { grid-column: 10 / span 3; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--encre); }
.etape figure img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.8,.2,1); }
.etape:hover figure img { transform: scale(1.06); }
.etape:hover h3 .surv { background: linear-gradient(transparent 60%, var(--craie) 60%, var(--craie) 92%, transparent 92%); }

/* Moment tableau de bord */
.soir { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; align-items: center; }
.soir__chiffre { grid-column: 1 / span 6; min-width: 0; }
.soir__chiffre .grand { font-size: clamp(120px, 20vw, 280px); line-height: .8; letter-spacing: -.07em; font-weight: 800; font-variant-numeric: tabular-nums; display: block; margin-top: 16px; }
.soir__chiffre p.phrase { font-size: clamp(22px, 2.4vw, 32px); letter-spacing: -.025em; line-height: 1.1; font-weight: 650; margin: 20px 0 0; max-width: 18ch; }
.soir__flux { grid-column: 8 / span 5; display: grid; gap: 8px; min-width: 0; }
.soir__flux .liste { display: grid; gap: 8px; min-height: 236px; align-content: end; }
.courbe { border-top: 1px solid var(--encre); padding-top: 12px; }
.courbe svg { width: 100%; height: 100px; display: block; overflow: visible; }
.courbe .ligne { fill: none; stroke: var(--encre); stroke-width: 2.5; stroke-dasharray: 600; stroke-dashoffset: 0; }
.courbe .aire { fill: var(--craie); opacity: .55; }
.courbe .pt { fill: var(--encre); }
.courbe .lbl { font-family: var(--mono); font-size: 11px; fill: var(--gris); }
.courbe.anime .ligne { animation: trace 2s ease both; }
@keyframes trace { from { stroke-dashoffset: 600; } to { stroke-dashoffset: 0; } }
.exemple { font-family: var(--mono); font-size: 11px; color: var(--gris); margin: 0; }

/* Cas Izgara */
.cas { background: var(--encre); color: var(--papier); }
.cas .sec__tete .etiquette, .cas .sec__tete .chapo { color: #A7A79F; }
.identite { display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-template-rows: 240px 240px; gap: 8px; }
.identite > div { overflow: hidden; position: relative; min-width: 0; }
.i-logo { grid-row: span 2; background: var(--iz-or); display: grid; place-items: center; }
.i-logo .iz-img { width: 100%; height: 100%; object-fit: contain; }
.i-carte { background: var(--iz-creme); color: var(--iz-vert); padding: 22px; display: grid; align-content: start; gap: 8px; }
.i-carte h5 { margin: 0 0 4px; font-family: var(--iz-serif); font-size: 22px; }
.i-carte .l { display: flex; justify-content: space-between; border-bottom: 1px dotted rgb(42 49 34 / .35); padding-bottom: 5px; font-size: 13px; gap: 8px; }
.i-carte .l span:last-child { font-variant-numeric: tabular-nums; }
.i-box { background: #B88B5A; display: grid; place-items: center; }
.i-box .eti { width: min(62%, 170px); aspect-ratio: 1; border-radius: 50%; background: var(--iz-vert); display: grid; place-items: center; box-shadow: 0 10px 26px -10px rgb(0 0 0 / .45); }
.i-box .eti .iz-img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.i-fid { background: #3A3F33; display: grid; place-items: center; }
.i-fid .c { width: 78%; aspect-ratio: 1.6; border-radius: 12px; background: var(--iz-vert); border: 1px solid var(--iz-or); padding: 14px; display: grid; gap: 8px; align-content: space-between; color: var(--iz-creme); }
.i-fid .c b { font-family: var(--iz-serif); font-size: 16px; }
.tampons { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
.tampons span { aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--iz-or); }
.tampons span.ok { background: var(--iz-or); }
.i-insta { background: var(--iz-creme); display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3px; padding: 3px; }
.i-insta span { background: var(--iz-vert); display: grid; place-items: center; color: var(--iz-creme); font-family: var(--iz-serif); font-size: 13px; text-align: center; padding: 4px; }
.i-insta span:nth-child(2n) { background: var(--iz-or); color: var(--iz-creme); }
.cas__etapes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
.cas__etapes div { border-top: 1px solid var(--papier); padding-top: 12px; min-width: 0; }
.cas__etapes .n { font-family: var(--mono); font-size: 12px; color: var(--craie); }
.cas__etapes b { display: block; font-size: 20px; letter-spacing: -.02em; margin-top: 10px; }
.cas__etapes span { color: #A7A79F; font-size: 15px; }
.fictif { margin-top: 28px; color: #A7A79F; }


/* Équipe en onglets */
.onglets { display: flex; gap: 0; border-bottom: 1px solid var(--encre); overflow-x: auto; scrollbar-width: none; }
.onglets button { font: inherit; font-weight: 650; font-size: clamp(17px, 1.6vw, 21px); letter-spacing: -.015em; background: none; border: 0; padding: 14px 20px 12px; cursor: pointer; color: var(--gris); border-bottom: 3px solid transparent; margin-bottom: -1px; white-space: nowrap; }
.onglets button[aria-selected="true"] { color: var(--encre); border-bottom-color: var(--craie); }
.onglets button:hover { color: var(--encre); }
.panneau { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; padding-top: 28px; align-items: end; }
.panneau__media { grid-column: 1 / span 8; aspect-ratio: 16 / 9; overflow: hidden; background: var(--encre); min-width: 0; position: relative; }
.panneau__media img, .panneau__media video { width: 100%; height: 100%; object-fit: cover; animation: apparait .6s ease both; }
.panneau__media.vertical video { object-fit: contain; background: var(--encre); }
@keyframes apparait { from { opacity: .3; transform: scale(1.03); } to { opacity: 1; transform: none; } }
.panneau__texte { grid-column: 9 / span 4; min-width: 0; }
.panneau__texte h3 { font-size: clamp(26px, 2.6vw, 36px); letter-spacing: -.035em; line-height: 1.02; margin: 10px 0 12px; }
.panneau__texte p { color: var(--gris); margin: 0 0 14px; }

/* Cas Pasta Mo' */
.pm { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; align-items: start; }
.pm__film { grid-column: 1 / span 6; margin: 0; position: sticky; top: 90px; min-width: 0; }
.pm__film img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #1d1a17; }
.pm__film figcaption { margin-top: 10px; }
.pm__canaux { grid-column: 8 / span 5; display: grid; min-width: 0; border-top: 1px solid var(--encre); }
.canal { padding-block: 20px; border-bottom: 1px solid var(--filet); }
.canal h3 { font-size: 22px; letter-spacing: -.02em; margin: 8px 0 6px; }
.canal p { margin: 0; color: var(--gris); }
.canal .chiffre { font-weight: 800; color: var(--encre); font-variant-numeric: tabular-nums; }

/* Canaux */
.canaux { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--encre); border-left: 1px solid var(--filet); }
.canaux article { border-right: 1px solid var(--filet); border-bottom: 1px solid var(--filet); padding: 24px 22px; display: grid; gap: 10px; align-content: start; min-width: 0; transition: background .2s; }
.canaux article:hover { background: var(--blanc); }
.canaux h3 { margin: 0; font-size: clamp(22px, 2.2vw, 30px); letter-spacing: -.03em; line-height: 1.05; }
.canaux p { margin: 0; color: var(--gris); }
.canaux .mesure { font-family: var(--mono); font-size: 12px; color: var(--encre); border-top: 1px dashed var(--filet); padding-top: 10px; margin-top: 6px; }
.canaux .mesure b { background: var(--craie); font-weight: 500; padding: 1px 5px; }
@media (max-width: 900px) { .canaux { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .canaux { grid-template-columns: 1fr; } }


/* Identité Izgara : défilement horizontal de mises en situation (épinglé sur ordinateur, au doigt sur téléphone) */
.mes { position: relative; margin-top: 8px; }
.mes__colle { position: relative; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.mes__colle::-webkit-scrollbar { display: none; }
.mes__piste { display: flex; gap: 12px; width: max-content; padding-bottom: 4px; }
.mes__piste > figure { scroll-snap-align: start; margin: 0; width: min(78vw, 520px); height: min(62vh, 480px); position: relative; overflow: hidden; flex: none; display: grid; place-items: center; }
.mes__piste figcaption { position: absolute; left: 12px; bottom: 12px; background: var(--papier); color: var(--encre); font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 5px 9px; }
.mes__barre { height: 2px; background: #3A3A37; margin-top: 16px; }
.mes__barre i { display: block; height: 100%; width: 0; background: var(--craie); }
.mes.epingle { height: var(--h, 300vh); }
.mes.epingle .mes__colle { position: sticky; top: 90px; overflow: hidden; }
.mes.epingle .mes__piste { will-change: transform; }
.m-logo { background: var(--iz-or); }
.m-logo .iz-img { width: 92%; height: 92%; object-fit: contain; }
.m-ens { background: linear-gradient(#262a30, #15181c); }
