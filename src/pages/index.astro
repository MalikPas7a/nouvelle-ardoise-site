html.anime [data-trace].vu .qui__trait path { stroke-dashoffset: 0; }
/* Bandes jaune et encre : elles arrivent en carte arrondie et se déplient jusqu'aux bords pendant qu'on défile (navigateurs récents) */
@supports (animation-timeline: view()) {
  html.anime .bande { background: none; isolation: isolate; }
  html.anime .bande::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--fond); animation: deplie linear both; animation-timeline: view(); animation-range: entry 0% entry 75%; }
}
@keyframes deplie { from { transform: scaleX(.94); border-radius: 28px; } to { transform: none; border-radius: 0; } }
/* Le surligné jaune passe sous « Qu'on vous choisisse. » une fois les mots posés */
html.anime #titre em { background-size: 0% .2em; transition: background-size .8s cubic-bezier(.65, 0, .35, 1) 1.05s; }
html.anime #titre.vu em { background-size: 100% .2em; }
@media print { html.anime [data-mots], html.anime [data-monte], html.anime .mot > span, html.anime [data-devoile], html.anime [data-devoile] img { opacity: 1 !important; transform: none !important; clip-path: none !important; } }
</style>

<script>
// Mouvement de l'accueil : écrans d'exemple, titres mot à mot, récit du savoir-faire, défilement doux. Sans JavaScript, tout est visible tel quel.
import Lenis from 'lenis';

window.__anime = true;
const html = document.documentElement;
const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
const souris = matchMedia('(hover: hover) and (pointer: fine)').matches;
const large = matchMedia('(min-width: 1081px)');
const vu = (el, f, options) => {
  if (!('IntersectionObserver' in window)) return f(el);
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting || e.boundingClientRect.bottom < 0) { f(e.target); io.unobserve(e.target); } }), options);
  io.observe(el);
};

// Relevé : chaque ligne d'un écran d'exemple reçoit son rang, pour se poser dans l'ordre de lecture quand l'écran s'allume.
const LIGNES = '.ecran__chip, .g__barre, .g__carte, .g__item, .ia__q, .ia__r, .ia__chip, .ad__tag, .ad__url, .ad__titre, .ad__texte, .ad__liens, .ad__suivi li, .ig__tete, .ig__media, .ig__texte, .ig__cta, .ph__tete, .ph__liste li, .ph__quand, .ph__btn, .ph__note, .bi__tete, .bi__voyants li, .bi__suite, .bi__qui';
document.querySelectorAll('.exp .ecran').forEach((ecran) => { const lignes = ecran.querySelectorAll(LIGNES); lignes.forEach((el, i) => { el.classList.add('rl'); el.style.setProperty('--l', String(i)); }); ecran.style.setProperty('--n', String(lignes.length)); });

// La loupe « Ce qu'on mesure » : un seul écran ouvert à la fois ; Échap ou un tap ailleurs referme.
const fermer = () => document.querySelectorAll('.ecran--ouvert').forEach((f) => { f.classList.remove('ecran--ouvert'); f.querySelector('.ecran__loupe')?.setAttribute('aria-expanded', 'false'); });
document.querySelectorAll('.ecran__loupe').forEach((b) => b.addEventListener('click', () => { const f = b.closest('.ecran'), on = !f.classList.contains('ecran--ouvert'); fermer(); if (on) { f.classList.add('ecran--ouvert'); b.setAttribute('aria-expanded', 'true'); } }));
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fermer(); });
document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.ecran--ouvert')) fermer(); });

// Titres découpés en mots (les <em> et <br> restent ; l'étiquette au-dessus du h1 garde son propre mouvement).
function decouper(el) {
  el.setAttribute('aria-label', el.textContent.replace(/\s+/g, ' ').trim());
  let k = 0;
  const parcourir = (noeud) => [...noeud.childNodes].forEach((n) => {
    if (n.nodeType === 1) { if (!n.matches('.etiquette')) parcourir(n); return; }
    if (n.nodeType !== 3 || !n.textContent.trim()) return;
    const frag = document.createDocumentFragment();
    n.textContent.split(/([ \t\n\r]+)/).forEach((morceau) => {
      if (!morceau) return;
      if (/^[ \t\n\r]+$/.test(morceau)) return frag.append(morceau);
      const mot = document.createElement('span'), dedans = document.createElement('span');
      mot.className = 'mot'; dedans.textContent = morceau; dedans.style.setProperty('--k', String(k++));
      mot.append(dedans); frag.append(mot);
    });
    n.replaceWith(frag);
  });
  parcourir(el);
  el.classList.add('decoupe');
}
if (!calme) {
  document.querySelectorAll('[data-mots]').forEach(decouper);
  const marge = { rootMargin: '0px 0px -12% 0px' };
  document.querySelectorAll('[data-mots], [data-devoile], [data-trace]').forEach((el) => vu(el, (x) => x.classList.add('vu'), marge));
  // Une fois arrivés, les blocs rendent la main à leurs propres transitions (survol des cartes, test qui s'agrandit).
  document.querySelectorAll('[data-monte]').forEach((el) => vu(el, (x) => {
    x.classList.add('vu');
    setTimeout(() => { x.removeAttribute('data-monte'); x.classList.remove('vu'); }, (parseInt(x.style.getPropertyValue('--d'), 10) || 0) + 1000);
  }, marge));
}

// Écrans d'exemple et carte : ils s'allument quand on arrive dessus (un cinquième visible, ou haut passé au milieu de la fenêtre).
const allumer = (el) => (el.closest('.exp') || el).classList.add('allume');
const ioAllume = 'IntersectionObserver' in window && !calme ? new IntersectionObserver((entrees) => entrees.forEach((e) => {
  const r = e.boundingClientRect;
  if (e.intersectionRatio >= .2 || (e.isIntersecting && r.top < innerHeight * .5) || r.bottom < 0) { allumer(e.target); ioAllume.unobserve(e.target); }
}), { threshold: [0, .1, .2], rootMargin: '0px 0px -8% 0px' }) : null;
const observerAllume = (el) => (ioAllume ? ioAllume.observe(el) : allumer(el));
document.querySelectorAll('.carte').forEach(observerAllume);

// Récit du savoir-faire, à l'ordinateur : l'expertise au milieu de la fenêtre allume son écran, l'écran précédent s'efface.
const exps = [...document.querySelectorAll('.exp')];
const rail = document.querySelector('.recit__rail');
let actif = null, ioRecit = null, minuteries = new Map();
function activer(li) {
  if (li === actif) return;
  const avant = actif; actif = li;
  exps.forEach((e) => e.classList.toggle('actif', e === li));
  if (avant) {
    avant.classList.add('sortie'); avant.querySelector('.ecran').inert = true;
    clearTimeout(minuteries.get(avant));
    minuteries.set(avant, setTimeout(() => { avant.classList.remove('sortie'); if (avant !== actif) avant.classList.remove('allume'); }, calme ? 0 : 280));
  }
  clearTimeout(minuteries.get(li));
  li.classList.remove('sortie', 'allume'); li.querySelector('.ecran').inert = false;
  void li.querySelector('.ecran').offsetWidth; // repart de zéro : les lignes se reposent à chaque passage
  li.classList.add('allume');
  if (rail) {
    const n = exps.indexOf(li);
    rail.querySelector('.recit__compte b').textContent = String(n + 1).padStart(2, '0');
    rail.querySelectorAll('.recit__barre i').forEach((b, i) => b.classList.toggle('fait', i <= n));
    rail.querySelector('.recit__nom').textContent = li.dataset.nom || '';
  }
}
function recit(on) {
  ioRecit?.disconnect(); ioRecit = null; actif = null;
  exps.forEach((e) => { e.classList.remove('actif', 'sortie'); e.querySelector('.ecran').inert = false; });
  if (on && 'IntersectionObserver' in window) {
    html.classList.add('recit');
    exps.forEach((e) => { e.classList.remove('allume'); e.querySelector('.ecran').inert = true; ioAllume?.unobserve(e.querySelector('.ecran')); });
    activer(exps[0]);
    ioRecit = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) activer(e.target.closest('.exp')); }), { rootMargin: '-48% 0px -51% 0px' });
    exps.forEach((e) => ioRecit.observe(e.querySelector('.exp__texte')));
  } else {
    html.classList.remove('recit');
    exps.forEach((e) => observerAllume(e.querySelector('.ecran')));
  }
}
recit(large.matches);
large.addEventListener('change', (e) => recit(e.matches));

// Défilement doux à la souris seulement (le défilement natif reste le meilleur au doigt), jamais si « mouvement réduit ».
if (!calme && souris) {
  const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 0.9 });
  window.lenis = lenis;
  const tourner = (t) => { lenis.raf(t); requestAnimationFrame(tourner); };
  requestAnimationFrame(tourner);
  // Les liens vers une section de la page glissent jusqu'à elle (le bouton du test a son propre geste).
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const a = e.target.closest('a[href*="#"]'); if (!a) return;
    const url = new URL(a.href, location.href);
    if (url.pathname !== location.pathname || !url.hash) return;
    const cible = document.getElementById(decodeURIComponent(url.hash.slice(1))); if (!cible) return;
    e.preventDefault(); lenis.scrollTo(cible, { offset: -84 }); history.pushState(null, '', url.hash);
  });
}
</script>
