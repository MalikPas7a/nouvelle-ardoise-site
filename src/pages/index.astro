.o-tel .ok b { font-size: 28px; letter-spacing: -.03em; }
.f-cc { background: #E6E3DA; }
.f-qr { background: linear-gradient(#cfb38f, #b8966d); }
.chevalet { background: var(--blanc); width: 170px; padding: 18px 16px; display: grid; justify-items: center; gap: 10px; text-align: center; box-shadow: 0 30px 30px -20px rgb(0 0 0 / .55); transform: perspective(600px) rotateX(8deg); }
.chevalet canvas { width: 120px; height: 120px; image-rendering: pixelated; }
