  .metier { grid-template-columns: 34px minmax(0, 1fr) auto; gap: 6px 10px; }
  .metier h3, .metier__besoin, .metier__module { grid-column: 2; grid-row: auto; }
  .metier__lien { grid-column: 3; grid-row: 1; }
