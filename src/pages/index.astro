---
// Accueil « Cartographe » (29.10.2026) : l'agence s'ouvre à tous les commerces, la restauration reste la spécialité (/restauration/).
// Le test de visibilité en direct dès l'ouverture, les 4 voyants, la zone d'intervention (Genève, Vaud), les 8 métiers et la méthode.
import Cartographe from '../layouts/Cartographe.astro';
import TestVisibilite from '../components/TestVisibilite.astro';
import carte from '../data/carte-romande.json';
import { SITE } from '../config.js';

const title = 'Agence marketing Genève & Vaud pour commerces et PME | Nouvelle Ardoise';
const description = 'Agence de marketing et de communication à Genève et dans le canton de Vaud : fiche Google, site, Instagram, vente en ligne et publicité locale pour commerces, artisans, cabinets et PME. Spécialiste de la restauration. Testez votre visibilité en 30 secondes.';

// Les 8 métiers accompagnés (même liste que l'appli de prospection). Jamais : bars et alcool, esthétique, onglerie, coiffure, fiduciaires, jeux, crédit.
const METIERS = [
  { nom: 'Restauration & cafés', besoin: 'Être trouvé à midi et recevoir des commandes sans commission.', module: 'Click & Collect, paiement par QR code, Uber Eats', lien: '/restauration/', specialite: true },
  { nom: 'Artisans de bouche & épiceries', besoin: 'Montrer le savoir-faire et prendre les commandes à l’avance.', module: 'Précommande en ligne, réels du geste', lien: '/artisans/' },
  { nom: 'Santé & bien-être', besoin: 'Des avis Google et des rendez-vous en ligne.', module: 'Prise de rendez-vous, fiche Google soignée' },
  { nom: 'Mode & boutiques', besoin: 'Vendre aussi en ligne, pas seulement en vitrine.', module: 'E-shop ou Click & Collect, catalogue Instagram' },
  { nom: 'Services de quartier', besoin: 'Être trouvé au moment où l’on a besoin de vous.', module: 'Fiche Google, avis, site avec prise de contact' },
  { nom: 'Hébergement & loisirs', besoin: 'Plus de réservations en direct, moins de commissions.', module: 'Réservation directe, photos pro' },
  { nom: 'Artisans & bâtiment', besoin: 'Recevoir des demandes de devis sérieuses.', module: 'Google Ads local, portfolio de chantiers' },
  { nom: 'Entreprises & bureaux', besoin: 'Inspirer confiance et recruter.', module: 'LinkedIn, site institutionnel, contenu régulier' },
];

const VOYANTS = [
  { titre: 'Google', question: 'Quand un client tape votre métier à deux rues de chez vous, sortez-vous dans les trois premiers ?', on: 'Fiche Google, photos, horaires, avis' },
  { titre: 'Site', question: 'Votre site s’ouvre-t-il vite sur téléphone, et dit-il en trois secondes ce que vous vendez ?', on: 'Vitesse, clarté, appel, itinéraire' },
  { titre: 'Instagram', question: 'Un compte vivant, qui montre votre savoir-faire et vos visages chaque semaine ?', on: 'Réels tournés chez vous, régularité' },
  { titre: 'Vente en ligne', question: 'Peut-on acheter, réserver ou demander un devis sans vous appeler ?', on: 'Commande, rendez-vous, e-shop, devis' },
];

const ETAPES = [
  { n: '01', titre: 'Le diagnostic', texte: 'Les quatre voyants, en direct, puis sur place : votre quartier, vos concurrents, ce que vos clients tapent sur Google.' },
  { n: '02', titre: 'Les trois priorités', texte: 'On ne fait pas tout. On choisit les trois actions qui rapportent le plus chez vous, avec un objectif chiffré fixé dès le départ.' },
  { n: '03', titre: 'La mise en place', texte: 'Photos, vidéos, site, fiche Google, publicité : on produit et on installe. Chaque mois, un bilan simple : on teste, on apprend, on ajuste.' },
];

// La route le long du Léman, de Genève à Montreux (ordre des villes sur la carte)
const ROUTE = ['Genève', 'Versoix', 'Nyon', 'Gland', 'Rolle', 'Morges', 'Lausanne', 'Vevey', 'Montreux'];
const ville = Object.fromEntries(carte.villes.map((v) => [v.nom, v]));
const route = 'M' + ROUTE.map((n) => `${ville[n].x} ${ville[n].y}`).join(' L');
const GAUCHE = ['Meyrin', 'Morges'];
const ordre = (n) => { const i = ROUTE.indexOf(n); return i < 0 ? ROUTE.length + 1 : i; };

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': ['ProfessionalService', 'LocalBusiness'], '@id': SITE.url + '/#agence', name: SITE.nom, url: SITE.url + '/', description,
      email: SITE.email, telephone: '+41782133868', image: SITE.url + '/partage.jpg', logo: SITE.url + '/apple-touch-icon.png',
      founder: { '@type': 'Person', name: SITE.responsable },
      address: { '@type': 'PostalAddress', streetAddress: SITE.adresse, postalCode: SITE.localite.split(' ')[0], addressLocality: 'Genève', addressRegion: 'GE', addressCountry: 'CH' },
      areaServed: ['Genève', 'Carouge', 'Onex', 'Meyrin', 'Lancy', 'Versoix', 'Nyon', 'Gland', 'Rolle', 'Morges', 'Lausanne', 'Vevey', 'Montreux', 'Yverdon-les-Bains', 'Canton de Vaud', 'Suisse romande'].map((n) => ({ '@type': 'Place', name: n })),
      knowsAbout: ['Marketing local', 'Référencement local Google', 'Fiche Google', 'Site web', 'Instagram et réels', 'Publicité Google et Meta', 'Vente en ligne', 'Prise de rendez-vous en ligne', 'Identité visuelle', 'Photo et vidéo', 'Marketing de restaurant'],
      sameAs: ['https://www.instagram.com/' + SITE.instagram + '/'], inLanguage: 'fr-CH' },
    { '@type': 'WebSite', '@id': SITE.url + '/#site', url: SITE.url + '/', name: SITE.nom, inLanguage: 'fr-CH', publisher: { '@id': SITE.url + '/#agence' } },
    { '@type': 'WebPage', '@id': SITE.url + '/#page', url: SITE.url + '/', name: title, description, isPartOf: { '@id': SITE.url + '/#site' }, about: { '@id': SITE.url + '/#agence' }, inLanguage: 'fr-CH' },
  ],
});
---
<Cartographe title={title} description={description} jsonLd={jsonLd}>
  <section class="ouv cadre" aria-labelledby="titre">
    <div class="ouv__texte">
      <p class="etiquette">Agence de marketing et de communication · Commerces, artisans et PME · Genève &amp; Vaud</p>
      <h1 id="titre">Qu’on vous trouve.<br /><em>Qu’on vous choisisse.</em></h1>
      <p class="ouv__chapo">Google, site, Instagram, vente en ligne : on mesure où vos clients vous perdent, on règle les trois points qui rapportent le plus, puis on suit les résultats avec vous, chaque mois.</p>
      <ul class="ouv__preuves" aria-label="Nos engagements">
        <li><b>Sur place</b><span>de Genève à Montreux</span></li>
        <li><b>Un objectif chiffré</b><span>fixé dès le départ</span></li>
        <li><b>Un bilan</b><span>chaque mois</span></li>
      </ul>
    </div>
    <div class="ouv__test"><TestVisibilite /></div>
  </section>

  <section class="sec cadre" id="voyants" aria-labelledby="voy-titre">
    <div class="sec__tete">
      <p class="etiquette">Ce que le test regarde</p>
      <h2 id="voy-titre">Quatre voyants.<br /><em>Trois priorités.</em></h2>
      <p class="chapo">Un client vous cherche, vous compare, puis achète ou réserve. Chaque voyant est une marche où il peut partir chez le voisin.</p>
    </div>
    <ol class="voyants">
      {VOYANTS.map((v, i) => (
        <li class="voyant" style={`--i:${i}`}>
          <span class="voyant__n">0{i + 1}</span>
          <h3>{v.titre}</h3>
          <p>{v.question}</p>
          <p class="voyant__on"><span class="etiquette">On s’en occupe</span>{v.on}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="nuit" id="carte" aria-labelledby="carte-titre">
    <div class="cadre nuit__grille">
      <div class="nuit__texte">
        <p class="etiquette">Zone d’intervention</p>
        <h2 id="carte-titre">De Genève à Montreux,<br /><em>on vient chez vous.</em></h2>
        <p>Étude du quartier, shooting, tournage, rendez-vous : on se déplace dans tout le canton de Genève et dans le canton de Vaud. Ailleurs en Suisse romande, on travaille en visio et on vient pour les tournages.</p>
        <ul class="villes" aria-label="Villes où nous intervenons">
          {['Genève', 'Carouge', 'Onex', 'Meyrin', 'Lancy', 'Versoix', 'Nyon', 'Gland', 'Rolle', 'Morges', 'Lausanne', 'Vevey', 'Montreux', 'Yverdon'].map((n) => <li>{n}</li>)}
        </ul>
        <a class="btn btn--craie" href="#test" data-cta>Tester ma visibilité</a>
      </div>
      <figure class="carte" aria-label="Carte du canton de Genève, du Léman et du canton de Vaud avec les villes où nous intervenons">
        <svg viewBox={`0 0 ${carte.w} ${carte.h}`} role="img" aria-hidden="true">
          <path class="carte__vd" d={carte.vd} />
          <path class="carte__ge" d={carte.ge} />
          <path class="carte__lac" d={carte.lac} />
          <path class="carte__route" d={route} pathLength="1" />
          {carte.villes.map((v) => (
            <g class:list={['carte__ville', { 'carte__ville--siege': v.nom === 'Genève', 'carte__ville--petit': v.petit }]} style={`--o:${ordre(v.nom)}`} transform={`translate(${v.x} ${v.y})`}>
              {v.nom === 'Genève' && <circle class="carte__onde" r="10" />}
              <circle class="carte__point" r={v.petit ? 5 : 8} />
              {!v.petit && <text x={GAUCHE.includes(v.nom) ? -14 : 14} y={v.nom === 'Morges' ? -8 : 8} text-anchor={GAUCHE.includes(v.nom) ? 'end' : 'start'}>{v.nom}</text>}
            </g>
          ))}
          <text class="carte__lac-nom" x="430" y="610">Léman</text>
        </svg>
        <figcaption><span class="carte__cle carte__cle--ge"></span>Canton de Genève, notre base · <span class="carte__cle"></span>Canton de Vaud</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec cadre" id="metiers" aria-labelledby="met-titre">
    <div class="sec__tete">
      <p class="etiquette">Huit métiers</p>
      <h2 id="met-titre">Un socle commun.<br /><em>Un outil par métier.</em></h2>
      <p class="chapo">Tout commerce doit être trouvé, inspirer confiance et vendre. Ce qui change d’un métier à l’autre, c’est l’outil qui fait vendre : on l’ajoute au socle.</p>
    </div>
    <p class="socle"><span class="etiquette">Le socle</span><span>Fiche Google</span><span>Site</span><span>Instagram</span><span>Photo et vidéo</span><span>Bilan mensuel</span></p>
    <ul class="metiers">
      {METIERS.map((m, i) => (
        <li class:list={['metier', { 'metier--phare': m.specialite }]}>
          <span class="metier__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{m.nom}{m.specialite && <span class="metier__badge">Notre spécialité</span>}</h3>
          <p class="metier__besoin">{m.besoin}</p>
          <p class="metier__module"><span class="etiquette">+ module</span>{m.module}</p>
          {m.lien && <a class="metier__lien" href={m.lien} aria-label={`Voir la page ${m.nom}`}>Voir <span aria-hidden="true">→</span></a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="sec cadre" id="methode" aria-labelledby="meth-titre">
    <div class="sec__tete">
      <p class="etiquette">La méthode</p>
      <h2 id="meth-titre">Peu de choses,<br /><em>bien faites, mesurées.</em></h2>
    </div>
    <ol class="etapes">
      {ETAPES.map((e) => (
        <li class="etape"><span class="etape__n">{e.n}</span><h3>{e.titre}</h3><p>{e.texte}</p></li>
      ))}
    </ol>
  </section>

  <section class="sec cadre" id="specialite" aria-labelledby="spe-titre">
    <a class="spe" href="/restauration/">
      <div>
        <p class="etiquette">Notre spécialité</p>
        <h2 id="spe-titre">La restauration et les métiers de bouche.</h2>
        <p>Une branche à part, née dans une cuisine : carte, Click &amp; Collect sans commission, paiement par QR code, Uber Eats, shootings et réels tournés pendant le service.</p>
      </div>
      <span class="spe__fleche" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="fin cadre" id="contact" aria-labelledby="fin-titre">
    <p class="etiquette">On en parle</p>
    <h2 id="fin-titre">Trente secondes de test,<br /><em>un café pour le reste.</em></h2>
    <div class="fin__actions">
      <a class="btn btn--craie" href="#test" data-cta>Tester ma visibilité</a>
      <a class="btn btn--creux" href="tel:+41782133868">078 213 38 68</a>
      <a class="btn btn--creux" href={'mailto:' + SITE.email}>{SITE.email}</a>
    </div>
  </section>
</Cartographe>

<style>
.ouv { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; padding-block: clamp(36px, 6vw, 88px) clamp(56px, 8vw, 112px); }
.ouv__texte { padding-top: clamp(0px, 2vw, 24px); }
h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(46px, 7.6vw, 112px); line-height: .92; letter-spacing: -.035em; margin: 22px 0 0; text-wrap: balance; }
h1 em, h2 em { font-style: italic; }
.ouv__chapo { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.4; max-width: 34ch; margin: 28px 0 0; }
.ouv__preuves { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 0; border-top: 1px solid var(--encre); }
.ouv__preuves li { padding: 14px 28px 0 0; margin-right: 28px; border-right: 1px solid var(--filet); display: grid; font-size: 14px; }
.ouv__preuves li:last-child { border-right: 0; margin-right: 0; }
.ouv__preuves b { font-weight: 600; }
.ouv__preuves span { color: var(--gris); }
.ouv__test { position: relative; }

.sec { padding-block: clamp(72px, 10vw, 136px); border-top: 1px solid var(--filet); }
.sec__tete { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }
.sec__tete .etiquette { grid-column: 1 / span 3; padding-top: 14px; }
.sec__tete h2 { grid-column: 4 / span 9; }
.sec__tete .chapo { grid-column: 4 / span 6; margin: 0; font-size: 19px; color: var(--gris); max-width: 46ch; }
h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(42px, 5.6vw, 84px); line-height: .96; letter-spacing: -.03em; margin: 0; text-wrap: balance; }
h3 { margin: 0; }

.voyants { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--encre); }
.voyant { padding: 22px 22px 8px 0; display: grid; align-content: start; gap: 10px; }
.voyant + .voyant { padding-left: 22px; border-left: 1px solid var(--filet); }
.voyant__n { font-family: var(--mono); font-size: 12px; color: var(--gris); }
.voyant h3 { font-size: 26px; font-weight: 650; letter-spacing: -.025em; display: flex; align-items: center; gap: 10px; }
.voyant h3::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--filet); transition: background-color .6s, box-shadow .6s; transition-delay: calc(var(--i) * 180ms); }
.voyants.allume .voyant h3::before { background: var(--craie); box-shadow: 0 0 0 4px rgb(255 210 63 / .25); }
.voyant p { margin: 0; color: var(--gris); }
.voyant__on { display: grid; gap: 4px; color: var(--encre) !important; font-size: 15px; padding-top: 10px; }

.nuit { background: var(--encre); color: var(--papier); padding-block: clamp(72px, 10vw, 136px); overflow: hidden; }
.nuit .etiquette { color: var(--gris-nuit); }
.nuit__grille { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
.nuit__texte p:not(.etiquette) { color: #CFC7B8; max-width: 44ch; margin: 24px 0 0; }
.nuit h2 { margin-top: 18px; }
.villes { list-style: none; padding: 0; margin: 28px 0 32px; display: flex; flex-wrap: wrap; gap: 6px; }
.villes li { font-family: var(--mono); font-size: 12px; border: 1px solid var(--filet-nuit); border-radius: 999px; padding: 4px 10px; color: #CFC7B8; }
.carte { margin: 0; }
.carte svg { width: 100%; height: auto; display: block; overflow: visible; }
.carte__vd { fill: #24211C; stroke: #5A5347; stroke-width: 1.4; stroke-linejoin: round; }
.carte__ge { fill: rgb(255 210 63 / .16); stroke: var(--craie); stroke-width: 1.6; stroke-linejoin: round; }
.carte__lac { fill: #34434A; }
.carte__lac-nom { fill: #7F939B; font-family: var(--serif); font-style: italic; font-size: 34px; letter-spacing: .04em; }
.carte__route { fill: none; stroke: var(--craie); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: .9; }
.carte.allume .carte__route { stroke-dashoffset: 0; transition: stroke-dashoffset 2.4s cubic-bezier(.6, 0, .2, 1) .2s; }
.carte__ville text { fill: var(--papier); font-family: var(--grotesk); font-size: 30px; font-weight: 550; paint-order: stroke; stroke: var(--encre); stroke-width: 5px; stroke-linejoin: round; opacity: .35; transition: opacity .5s; transition-delay: calc(.2s + var(--o) * 260ms); }
.carte__point { fill: #6E675B; transition: fill .5s; transition-delay: calc(.2s + var(--o) * 260ms); }
.carte.allume .carte__point { fill: var(--craie); }
.carte.allume .carte__ville text { opacity: 1; }
.carte__onde { fill: none; stroke: var(--craie); stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; }
.carte.allume .carte__onde { animation: onde 2.6s ease-out 1s infinite; }
@keyframes onde { 0% { opacity: .9; transform: scale(.6); } 100% { opacity: 0; transform: scale(3.2); } }
.carte figcaption { font-family: var(--mono); font-size: 12px; color: var(--gris-nuit); margin-top: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.carte__cle { width: 12px; height: 12px; border: 1px solid #5A5347; background: #24211C; display: inline-block; }
.carte__cle--ge { border-color: var(--craie); background: rgb(255 210 63 / .16); }

.socle { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 28px; }
.socle .etiquette { margin-right: 8px; }
.socle span:not(.etiquette) { font-size: 14px; background: var(--encre); color: var(--papier); border-radius: 999px; padding: 6px 12px; }
.metiers { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--encre); }
.metier { position: relative; display: grid; grid-template-columns: 56px minmax(0, 4fr) minmax(0, 4fr) minmax(0, 3.4fr) 60px; gap: 20px; align-items: baseline; padding-block: 22px; border-bottom: 1px solid var(--filet); transition: background-color .25s; }
.metier__n { font-family: var(--mono); font-size: 12px; color: var(--gris); }
.metier h3 { font-size: clamp(22px, 2.2vw, 28px); font-weight: 650; letter-spacing: -.025em; line-height: 1.1; }
.metier__badge { display: inline-block; vertical-align: middle; margin-left: 10px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; background: var(--craie); padding: 3px 8px; border-radius: 999px; }
.metier__besoin { margin: 0; color: var(--gris); }
.metier__module { margin: 0; display: grid; gap: 2px; font-size: 15px; }
.metier__lien { justify-self: end; font-weight: 600; text-decoration: none; }
.metier__lien::after { content: ""; position: absolute; inset: 0; }
.metier:has(.metier__lien):hover { background: var(--papier-2); }
.metier--phare h3 { font-family: var(--serif); font-weight: 400; font-style: italic; font-size: clamp(28px, 2.8vw, 36px); letter-spacing: -.02em; }

.etapes { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.etape { border-top: 1px solid var(--encre); padding-top: 18px; display: grid; gap: 12px; align-content: start; }
.etape__n { font-family: var(--serif); font-size: 64px; line-height: 1; color: var(--encre); }
.etape h3 { font-size: 26px; font-weight: 650; letter-spacing: -.025em; }
.etape p { margin: 0; color: var(--gris); max-width: 36ch; }

.spe { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 24px; text-decoration: none; background: var(--craie); border-radius: 22px; padding: clamp(28px, 5vw, 64px); transition: transform .3s var(--sortie); }
.spe:hover { transform: translateY(-3px); }
.spe h2 { font-size: clamp(36px, 4.6vw, 68px); margin: 14px 0 0; max-width: 16ch; }
.spe .etiquette { color: var(--encre); }
.spe p:not(.etiquette) { margin: 18px 0 0; max-width: 52ch; }
.spe__fleche { font-size: clamp(48px, 6vw, 88px); line-height: 1; transition: transform .3s var(--sortie); }
.spe:hover .spe__fleche { transform: translateX(8px); }
#specialite { border-top: 0; padding-top: 0; }

.fin { padding-block: clamp(72px, 10vw, 136px); border-top: 1px solid var(--filet); text-align: center; }
.fin h2 { margin-top: 18px; }
.fin__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 36px; }

@media (max-width: 1080px) {
  .ouv { grid-template-columns: minmax(0, 1fr); }
  .ouv__test { max-width: 640px; }
  .nuit__grille { grid-template-columns: minmax(0, 1fr); }
  .voyants { grid-template-columns: 1fr 1fr; }
  .voyant:nth-child(3) { padding-left: 0; border-left: 0; }
  .voyant:nth-child(n+3) { border-top: 1px solid var(--filet); margin-top: 12px; }
  .metier { grid-template-columns: 44px minmax(0, 1fr) minmax(0, 1fr) 40px; }
  .metier__module { grid-column: 3; }
  .metier__besoin { grid-column: 3; grid-row: 1; }
  .metier__lien { grid-column: 4; grid-row: 1; }
  .metier__module { grid-row: 2; }
}
@media (max-width: 760px) {
  .sec__tete { display: block; }
  .sec__tete h2 { margin-top: 14px; }
  .sec__tete .chapo { margin-top: 18px; }
  .ouv__preuves { grid-template-columns: 1fr 1fr 1fr; }
  .ouv__preuves li { padding-right: 10px; margin-right: 10px; font-size: 13px; min-width: 0; }
  h2 { font-size: clamp(38px, 10vw, 56px); }
