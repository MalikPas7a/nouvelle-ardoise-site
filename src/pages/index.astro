/* Sur la craie (ruban des métiers), le bouton fixe passe en ardoise pour rester visible */
body[data-fond="craie"] .tete__cta, body[data-fond="craie"] .barre .btn--craie { background: var(--ardoise); color: var(--craie); border-color: var(--ardoise); }
body[data-fond="craie"] .tete__cta .cta__duree, body[data-fond="craie"] .barre .btn--craie .cta__duree { background: var(--craie); color: var(--ardoise); }
.tete__cta, .barre .btn--craie { transition: background-color .3s, color .3s, transform .16s var(--sortie); }
/* En attendant le script : rien ne s'affiche puis ne saute (3 s au plus, ensuite tout reste visible) */
html.attente:not(.mvt) .titre .l > span, html.attente:not(.mvt) .ouv__sur, html.attente:not(.mvt) .ouv__bas > * { opacity: 0; }

/* 1. Ouverture sur l'ardoise */
.ouv { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; background: var(--ardoise); color: var(--papier); overflow: hidden; padding-top: 96px; box-sizing: border-box; }
