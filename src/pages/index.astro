/* Équipe en onglets */
.onglets { display: flex; gap: 0; border-bottom: 1px solid var(--encre); overflow-x: auto; scrollbar-width: none; }
.onglets button { font: inherit; font-weight: 650; font-size: clamp(17px, 1.6vw, 21px); letter-spacing: -.015em; background: none; border: 0; padding: 14px 20px 12px; cursor: pointer; color: var(--gris); border-bottom: 3px solid transparent; margin-bottom: -1px; white-space: nowrap; }
.onglets button[aria-selected="true"] { color: var(--encre); border-bottom-color: var(--craie); }
