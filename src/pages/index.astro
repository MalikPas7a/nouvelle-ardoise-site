.o-tel { width: 190px; height: 330px; border: 6px solid var(--encre); border-radius: 28px; background: var(--blanc); padding: 18px 14px; display: flex; flex-direction: column; gap: 9px; font-size: 13px; box-shadow: 0 24px 30px -22px rgb(0 0 0 / .5); }
.o-tel .h { font-weight: 800; font-size: 15px; letter-spacing: -.01em; }
