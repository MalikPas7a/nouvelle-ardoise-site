.m-box .boite .iz-img { width: 46%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 4px solid var(--iz-creme); }
.m-carte { background: #3b2f27; }
.m-carte .feuille { width: 56%; aspect-ratio: .7; background: var(--iz-creme); color: var(--iz-vert); padding: 7% 7%; display: grid; align-content: start; gap: 8px; box-shadow: 0 30px 40px -20px rgb(0 0 0 / .7); transform: rotate(-3deg); }
