<script>
// Accueil « Ardoise vivante » : un seul moteur de défilement (Lenis, à la souris seulement), GSAP pour les scènes.
// Rien ne bouge si « mouvement réduit » : la page reste empilée et entièrement lisible, comme sans JavaScript.
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import Lenis from 'lenis';

const q = (s, r) => (r || document).querySelector(s);
const qa = (s, r) => Array.from((r || document).querySelectorAll(s));

// Un rechargement repart du haut : les animations reprennent depuis le début
if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

// Rubans des métiers : contenu doublé pour une boucle sans couture
qa('.defile').forEach((d) => { d.innerHTML += d.innerHTML; });

// Roue du numéro : une colonne de chiffres par position
const roue = q('.numero__roue');
if (roue) '078 213 38 68'.split('').forEach((c) => {
  if (c === ' ') { roue.insertAdjacentHTML('beforeend', '<span class="espace"></span>'); return; }
  let pile = '';
  for (let k = 0; k < 10; k++) pile += '<span>' + k + '</span>';
  roue.insertAdjacentHTML('beforeend', '<span class="col" data-n="' + c + '"><span>' + pile + '</span></span>');
});

// Couleur réelle sous le bouton fixe visible : il passe en ardoise sur le ruban jaune
function fond(f) { if (document.body.dataset.fond !== f) document.body.dataset.fond = f; }
fond('ardoise');
const barreBas = q('#barre');
function majFond() {
  const bas = barreBas && getComputedStyle(barreBas).display !== 'none' && barreBas.classList.contains('visible');
  const c = bas ? q('#barre .btn--craie') : q('.tete__cta');
  if (!c) return;
  const r = c.getBoundingClientRect();
  if (!r.width) return;
  const els = document.elementsFromPoint(r.left + r.width / 2, r.top + r.height / 2);
  for (const el of els) {
    if (el.closest('.tete, .barre')) continue;
    const sec = el.closest('[data-fond]');
    if (sec && sec !== document.body) { fond(sec.dataset.fond); return; }
  }
}
let image = 0;
(function boucle() { if (++image % 2 === 0) majFond(); requestAnimationFrame(boucle); })();

// Fondu en bas d'une figure seulement si elle déborde vraiment
function majDebord() {
  qa('.pan__fig').forEach((f) => {
    const der = f.lastElementChild, h = f.clientHeight;
    const bas = der ? der.offsetTop + der.offsetHeight - f.offsetTop : 0;
    f.classList.toggle('deborde', h > 0 && bas > h + 1);
  });
}

const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (!calme) demarrer();

function demarrer() {
  document.documentElement.classList.add('mvt');
  window.__vivante = true;
  window.scrollTo(0, 0);
  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });
  // ScrollTrigger remet le réglage du navigateur après chaque recalcul : on lui donne le nôtre
  ScrollTrigger.clearScrollMemory('manual');

  // Un seul moteur de défilement, et seulement à la souris (le défilement natif reste le meilleur au doigt)
  let lenis = null;
  if (matchMedia('(pointer: fine)').matches) {
    lenis = new Lenis({ lerp: 0.12, wheelMultiplier: 0.95 });
    window.lenis = lenis;
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);
    // Les liens vers une section de la page glissent jusqu'à elle (le bouton du test a son propre geste)
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const a = e.target.closest('a[href*="#"]'); if (!a) return;
      const url = new URL(a.href, location.href);
      if (url.pathname !== location.pathname || !url.hash) return;
      const cible = document.getElementById(decodeURIComponent(url.hash.slice(1))); if (!cible) return;
      e.preventDefault(); lenis.scrollTo(cible); history.pushState(null, '', url.hash);
    });
  }
  const allerA = (y) => { if (lenis) lenis.scrollTo(y, { immediate: true, force: true }); else window.scrollTo(0, y); };

  // Largeur visible réelle (sans la barre de défilement de Windows), pour que chaque chapitre tombe pile
  const majVw = () => document.documentElement.style.setProperty('--vw', document.documentElement.clientWidth + 'px');
  majVw();
  ScrollTrigger.addEventListener('refreshInit', majVw);

  function taper(el) {
    const txt = el.dataset.texte, o = { n: 0 };
    el.textContent = '';
    return gsap.to(o, { n: txt.length, duration: Math.min(txt.length * 0.035, 1.1), ease: 'none', onUpdate: () => { el.textContent = txt.slice(0, Math.round(o.n)); } });
  }

  // 1. Ouverture : les lignes arrivent de côtés opposés, puis le trait se dessine
  const trait = q('.trait path'), longueur = q('.trait').getBoundingClientRect().width * 1.15 + 20;
  gsap.set(trait, { strokeDasharray: longueur, strokeDashoffset: longueur });
  gsap.timeline({ defaults: { ease: 'expo.out' } })
    .from('.l > span', { xPercent: (i) => (i % 2 ? 70 : -70), opacity: 0, duration: 1.25, stagger: 0.09 })
    .from('.ouv__sur', { y: 16, opacity: 0, duration: 0.8 }, 0.25)
    .to(trait, { strokeDashoffset: 0, duration: 0.9, ease: 'power2.inOut', onComplete: () => gsap.set(trait, { clearProps: 'strokeDasharray,strokeDashoffset' }) }, 0.9)
    .from('.ouv__bas > *', { y: 24, opacity: 0, duration: 0.9, stagger: 0.1 }, 0.7)
    .from('.rang', { xPercent: (i) => (i ? 30 : -30), duration: 1.4 }, 0.5);

  // Au défilement, l'ardoise s'écarte, puis la brique recouvre tout
  const sortie = { trigger: '.ouv', start: 'bottom bottom', end: '+=100%', scrub: true };
  ScrollTrigger.create({ trigger: '.ouv', start: 'bottom bottom', end: '+=100%', pin: true, pinSpacing: false });
  gsap.to(['.l1', '.l3'], { xPercent: -16, ease: 'none', scrollTrigger: sortie });
  gsap.to(['.l2', '.l4'], { xPercent: 16, ease: 'none', scrollTrigger: sortie });
  gsap.to('.titre', { scale: 1.1, transformOrigin: '50% 100%', ease: 'none', scrollTrigger: sortie });

  // 2. Manifeste : bord en biais qui se redresse, phrases qui se croisent, pastilles qui tombent
  gsap.fromTo('.mani', { clipPath: 'polygon(0% 12%, 100% 0%, 100% 100%, 0% 100%)' }, { clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)', ease: 'none', scrollTrigger: { trigger: '.mani', start: 'top bottom', end: 'top 30%', scrub: true } });
  const traverse = { trigger: '.mani', start: 'top bottom', end: 'bottom top', scrub: true };
  gsap.fromTo('.mani h2 .a', { xPercent: 14 }, { xPercent: -4, ease: 'none', scrollTrigger: traverse });
  gsap.fromTo('.mani h2 .b', { xPercent: -14 }, { xPercent: 4, ease: 'none', scrollTrigger: traverse });
  gsap.fromTo('.mani__un', { rotation: -10, yPercent: 8 }, { rotation: 6, yPercent: -10, ease: 'none', scrollTrigger: traverse });
  gsap.from('.puces li', { y: -120, rotation: () => gsap.utils.random(-24, 24), opacity: 0, duration: 1, ease: 'back.out(1.5)', stagger: 0.07, scrollTrigger: { trigger: '.puces', start: 'top 92%', once: true } });

  // 3. Chapitres
  const rail = q('.piste__rail'), pans = qa('.pan'), compteur = q('.compteur'), num = q('.compteur b');
  const n = pans.length;
  const scenes = {
    trouve: (p) => gsap.timeline({ paused: true })
      .add(taper(q('.tape', p)))
      .from(qa('.chute', p), { y: -40, opacity: 0, duration: 0.5, ease: 'bounce.out', stagger: 0.06 }, '-=0.2')
      .fromTo(q('.halo', p), { scale: 0.4, opacity: 0.9, transformOrigin: '50% 50%' }, { scale: 1.8, opacity: 0, duration: 0.9, ease: 'power2.out', immediateRender: false }, '<0.35')
      .from(q('.fiche', p), { y: 36, opacity: 0, duration: 0.7, ease: 'expo.out' }, '<0.05')
      .from(q('.rang-1', p), { yPercent: 100, opacity: 0, duration: 0.6, ease: 'back.out(2)' }, '-=0.4')
      .from(qa('.etoiles svg', p), { scale: 0, rotation: -40, duration: 0.45, ease: 'back.out(2.4)', stagger: 0.07 }, '-=0.45'),
    cite: (p) => gsap.timeline({ paused: true })
      .from(q('.bulle', p), { scale: 0.6, opacity: 0, transformOrigin: '100% 100%', duration: 0.45, ease: 'back.out(1.8)' })
      .add(taper(q('.tape', p)))
      .from(q('.reponse', p), { y: 26, opacity: 0, duration: 0.6, ease: 'expo.out' }, '-=0.2')
      .from(q('.reponse mark', p), { backgroundSize: '0% 100%', color: '#F2EDE4', duration: 0.6, ease: 'power2.inOut' }, '-=0.15'),
    vu: (p) => gsap.timeline({ paused: true })
      .fromTo(q('.photo__cadre', p), { clipPath: 'inset(0% 0% 100% 0% round 22px)' }, { clipPath: 'inset(0% 0% 0% 0% round 22px)', duration: 1.1, ease: 'expo.inOut' })
      .from(q('.photo__cadre img', p), { scale: 1.3, duration: 1.8, ease: 'expo.out' }, 0.2)
      .from(qa('.photo__qui span', p), { y: 18, scale: 0.7, opacity: 0, duration: 0.5, ease: 'back.out(1.8)', stagger: 0.1 }, 0.8),
    choisi: (p) => gsap.timeline({ paused: true })
      .from(q('.ecran', p), { y: 60, rotation: 4, opacity: 0, duration: 0.9, ease: 'expo.out' })
      .from(q('figcaption', p), { opacity: 0, duration: 0.4 }, '-=0.3'),
    mesure: (p) => {
      const courbes = qa('.courbe', p);
      gsap.set(courbes, { strokeDasharray: 1, strokeDashoffset: 1 });
      return gsap.timeline({ paused: true })
        .from(qa('.tuile', p), { y: 24, opacity: 0, duration: 0.6, ease: 'expo.out', stagger: 0.08 })
        .to(courbes, { strokeDashoffset: 0, duration: 1, ease: 'power2.inOut', stagger: 0.08 }, 0.2)
        .from(qa('.aire', p), { opacity: 0, duration: 0.6, stagger: 0.08 }, 0.7)
        .from(qa('.point', p), { scale: 0, transformOrigin: '50% 50%', duration: 0.4, ease: 'back.out(2.5)', stagger: 0.08 }, 1)
        .from(qa('.tdb__barres i', p), { scaleY: 0, duration: 0.7, ease: 'expo.out', stagger: 0.04 }, 0.4)
        .from(qa('.tdb__prio li', p), { x: -16, opacity: 0, duration: 0.5, ease: 'expo.out', stagger: 0.12 }, 0.9)
        .from(qa('.tdb__prio .coche', p), { strokeDashoffset: 1, duration: 0.35, ease: 'power2.out', stagger: 0.12 }, 1.15);
    },
  };

  // Où en est-on dans les chapitres (gardé pendant une rotation ou un redimensionnement)
  const etat = { dedans: false, chap: 0 };
  let fige = null, piste = null;
  const figer = () => { if (!fige) fige = { dedans: etat.dedans, chap: etat.chap }; };
  window.addEventListener('resize', figer);
  const mqBas = matchMedia('(max-height: 520px)');
  if (mqBas.addEventListener) mqBas.addEventListener('change', figer);

  // Gestes : chaque geste vise le chapitre voisin ; un geste enchaîné avant l'arrivée du précédent part de la cible du précédent
  let depart = -1, base = -1, vise = null, resolu = true, cibleSnap = 0, dernierGeste = 0, debutPrec = 0, snapLance = false;
  function position() {
    const st = piste && piste.scrollTrigger;
    if (!st) return -1;
    const y = st.scroll();
    if (y < st.start - 1) return -1;
    if (y > st.end + 1) return n;
    return st.progress * (n - 1);
  }
  const borne = (i) => Math.max(0, Math.min(n - 1, i));
  const voisin = (b, sens) => (sens > 0 ? Math.floor(b) + 1 : Math.ceil(b) - 1);
  function debutGeste(e) {
    if (e.type === 'keydown' && e.target.closest && e.target.closest('input, textarea, select, [contenteditable]')) return;
    const t = Date.now(), nouveau = t - dernierGeste > 280;
    dernierGeste = t;
    let sens = 0;
    if (e.type === 'wheel') sens = e.deltaY > 0 ? 1 : e.deltaY < 0 ? -1 : 0;
    else if (e.type === 'keydown') sens = { ArrowDown: 1, PageDown: 1, ' ': e.shiftKey ? -1 : 1, ArrowUp: -1, PageUp: -1 }[e.key] || 0;
    if (!nouveau) return;
    depart = position();
    const dedans = depart >= 0 && depart <= n - 1, recent = t - debutPrec < 1600;
    debutPrec = t;
    if (dedans && !resolu && recent) base = snapLance ? cibleSnap : (vise !== null ? vise : Math.round(depart));
    else base = dedans ? Math.round(depart) : depart;
    vise = sens ? voisin(base, sens) : null;
    resolu = false; snapLance = false;
    // Le défilement doux repart de la position réelle, pas de celle d'avant l'aimantation
    if (lenis) lenis.scrollTo(window.scrollY, { immediate: true, force: true });
  }
  ['wheel', 'touchstart', 'keydown'].forEach((ev) => window.addEventListener(ev, debutGeste, { passive: true, capture: true }));
  function cibler(x) {
    const st = piste.scrollTrigger, segPx = (st.end - st.start) / (n - 1), eps = segPx > 0 ? 24 / segPx : 0.05;
    let i;
    if (Math.abs(x - depart) < eps) i = Math.round(base); // effleurement : on reste
    else {
      const sens = x > depart ? 1 : -1;
      i = vise !== null && (vise - base) * sens > 0 ? vise : voisin(base, sens);
      // un très grand geste peut aller plus loin, sans jamais revenir en arrière
      if (sens > 0) i = Math.max(i, Math.floor(x)); else i = Math.min(i, Math.ceil(x));
    }
    i = borne(i);
    cibleSnap = i; snapLance = true;
    return i;
  }

  const mm = gsap.matchMedia();
  mm.add({ grand: '(min-height: 521px)', bas: '(max-height: 520px)' }, (ctx) => {
    const tls = pans.map((pan) => scenes[pan.dataset.fig](pan));
    const jouer = (i) => () => tls[i].play();

    if (ctx.conditions.bas) {
      // Écran bas : chapitres empilés, chaque scène joue en arrivant
      piste = null;
      pans.forEach((pan, i) => ScrollTrigger.create({ trigger: pan, start: 'top 75%', onEnter: jouer(i), onEnterBack: jouer(i) }));
      ScrollTrigger.create({
        trigger: '.piste', start: 'top 50%', end: 'bottom 50%',
        onToggle: (s) => { if (!fige) etat.dedans = s.isActive; },
        onUpdate: () => {
          if (fige) return;
          const mi = innerHeight / 2;
          pans.forEach((pan, i) => { const r = pan.getBoundingClientRect(); if (r.top <= mi && r.bottom > mi) etat.chap = i; });
        },
      });
      return;
    }

    const dist = () => rail.scrollWidth - document.documentElement.clientWidth;
    piste = gsap.to(rail, {
      x: () => -dist(), ease: 'none',
      scrollTrigger: {
        trigger: '.piste', start: 'top top', end: () => '+=' + dist() * 1.2, pin: true, scrub: 0.5, invalidateOnRefresh: true,
        // Un geste mène au chapitre suivant ou précédent ; un très grand geste peut aller plus loin
        snap: {
          snapTo: (v) => cibler(v * (n - 1)) / (n - 1),
          inertia: false, duration: { min: 0.3, max: 0.6 }, delay: 0.08, ease: 'power2.out',
          onComplete: () => { resolu = true; vise = null; if (lenis) lenis.scrollTo(window.scrollY, { immediate: true, force: true }); },
        },
        onToggle: (s) => { if (!fige) etat.dedans = s.isActive; },
        onUpdate: (s) => {
          const i = Math.min(n - 1, Math.round(s.progress * (n - 1)));
          if (!fige) etat.chap = i;
          num.textContent = String(i + 1).padStart(2, '0');
          compteur.style.setProperty('--p', (i + 1) / n);
        },
      },
    });
    pans.forEach((pan, i) => {
      // Le mot géant glisse un peu moins vite que l'écran : léger relief
      gsap.fromTo(q('.pan__mot', pan), { xPercent: 18 }, { xPercent: -18, ease: 'none', scrollTrigger: { trigger: pan, containerAnimation: piste, start: 'left right', end: 'right left', scrub: true } });
      if (i === 0) ScrollTrigger.create({ trigger: '.piste', start: 'top 60%', onEnter: jouer(0), onEnterBack: jouer(0) });
      else ScrollTrigger.create({ trigger: pan, containerAnimation: piste, start: 'left 35%', end: 'right 35%', onEnter: jouer(i), onEnterBack: jouer(i), onLeave: jouer(i) });
    });
    return () => { piste = null; };
  });

  // Après une rotation ou un redimensionnement : on revient sur le même chapitre
  ScrollTrigger.addEventListener('refresh', () => {
    majDebord();
    if (!fige) return;
    const f = fige;
    fige = null;
    if (!f.dedans) return;
    const st = piste && piste.scrollTrigger;
    const y = st ? st.start + (st.end - st.start) * f.chap / (n - 1) : pans[f.chap].getBoundingClientRect().top + window.scrollY - 1;
    allerA(y);
    depart = base = cibleSnap = f.chap; vise = null; resolu = true;
    etat.dedans = true; etat.chap = f.chap;
  });
  // Sur téléphone, un retour à la taille de départ n'est pas toujours vu : on recalcule à chaque changement de largeur
  let largeur = innerWidth, attente = null;
  window.addEventListener('resize', () => {
    if (innerWidth === largeur) return;
    largeur = innerWidth;
    clearTimeout(attente);
    attente = setTimeout(() => { figer(); ScrollTrigger.refresh(); }, 220);
  });

  // 4. Le test : le titre arrive en deux temps, la carte du test s'ouvre depuis son bord haut
  const arrivee = (trigger) => ({ trigger, start: 'top 80%', once: true });
  gsap.from('.essai h2 > span', { xPercent: (i) => (i ? 24 : -24), opacity: 0, duration: 1.1, ease: 'expo.out', stagger: 0.1, scrollTrigger: arrivee('.essai') });
  // (sans décalage vertical : le bouton « Tester ma visibilité » vise le haut de la carte avant qu'elle ne soit arrivée)
  gsap.from('.essai__test', { scale: 0.92, opacity: 0, transformOrigin: '50% 0%', duration: 1.1, ease: 'expo.out', scrollTrigger: arrivee('.essai') });

  // 5. Métiers : chaque ligne entre par son côté
  gsap.from('.metiers h2', { y: 60, opacity: 0, duration: 1, ease: 'expo.out', scrollTrigger: arrivee('.metiers') });
  qa('.metier').forEach((m, i) => gsap.from(m, { x: i % 2 ? 90 : -90, opacity: 0, duration: 1, ease: 'expo.out', scrollTrigger: { trigger: m, start: 'top 92%', once: true } }));

  // 6. Zone : la carte se dessine depuis Genève quand on arrive dessus
  const carte = q('.carte');
  if (carte) ScrollTrigger.create({ trigger: carte, start: 'top 75%', once: true, onEnter: () => carte.classList.add('allume') });
  gsap.from('.zone h2', { x: -80, opacity: 0, duration: 1.1, ease: 'expo.out', scrollTrigger: arrivee('.zone') });

  // 7. Branches : les deux cartes arrivent l'une après l'autre, légèrement penchées
  gsap.from('.branche', { y: 90, rotation: (i) => (i ? 3 : -3), opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.12, scrollTrigger: arrivee('.branches') });

  // 8. Questions
  gsap.from('.questions h2', { x: -80, opacity: 0, duration: 1.1, ease: 'expo.out', scrollTrigger: arrivee('.questions') });

  // 9. Fin : le numéro roule, une colonne vers le haut, la suivante vers le bas
  const cols = qa('.col');
  cols.forEach((c, i) => gsap.set(c.firstChild, { y: i % 2 ? '-10em' : '1em' }));
  gsap.from('.fin h2', { y: 50, opacity: 0, duration: 1, ease: 'expo.out', scrollTrigger: { trigger: '.fin', start: 'top 70%', once: true } });
  ScrollTrigger.create({
    trigger: '.numero', start: 'top 90%', once: true,
    onEnter: () => cols.forEach((c, i) => gsap.to(c.firstChild, { y: (-c.dataset.n) + 'em', duration: 1.5, delay: i * 0.06, ease: 'power4.out' })),
  });
  gsap.from('.mois li', { y: 30, opacity: 0, duration: 0.8, ease: 'expo.out', stagger: 0.1, scrollTrigger: { trigger: '.mois', start: 'top 90%', once: true } });

  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => ScrollTrigger.refresh());
}
</script>
