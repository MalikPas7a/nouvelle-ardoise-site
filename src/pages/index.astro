.m-tel { background: #CFC8BA; }
.m-tel .tel-cadre { width: min(230px, 54%); }
.m-insta { background: var(--iz-creme); }
.m-insta .grille { width: 74%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
.m-insta .grille span { aspect-ratio: 1; background: var(--iz-vert); color: var(--iz-creme); display: grid; place-items: center; text-align: center; font-weight: 750; font-size: clamp(11px, 1.2vw, 14px); padding: 6px; letter-spacing: -.01em; }
