.m-ens .caisson { position: relative; width: 78%; aspect-ratio: 2.4; background: var(--iz-or); border-radius: 6px; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 16px; padding: 12px 20px; box-shadow: 0 0 60px 10px rgb(191 87 52 / .45), 0 30px 40px -20px rgb(0 0 0 / .8); }
.m-ens .caisson .iz-img { height: 100%; width: auto; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
.m-ens .caisson b { font-family: var(--grotesk); color: var(--iz-creme); font-size: clamp(16px, 2.4vw, 26px); letter-spacing: .18em; font-weight: 800; }
.m-ens .vitre { position: absolute; left: 11%; right: 11%; bottom: 0; height: 30%; background: linear-gradient(rgb(255 196 120 / .25), rgb(255 160 90 / .08)); border: 3px solid #0d0f12; border-bottom: 0; }
.m-sac { background: #D8D1C4; }
.m-sac .sac { position: relative; width: 46%; aspect-ratio: .78; background: linear-gradient(100deg, #b98c5c, #cfa474 45%, #b5895a); border-radius: 3px 3px 6px 6px; box-shadow: 18px 24px 30px -18px rgb(0 0 0 / .45); display: grid; place-items: center; margin-top: 14%; }
.m-sac .sac::before { content: ""; position: absolute; top: -26%; left: 30%; width: 40%; height: 34%; border: 7px solid #a77c4f; border-bottom: 0; border-radius: 60px 60px 0 0; }
