<script is:inline>
// Les écrans d'exemple, la carte et le bilan s'allument quand on arrive dessus (état final direct si mouvement réduit ou sans observateur).
(function () {
  document.documentElement.classList.add('js');
  // Relevé : chaque ligne d'un écran d'exemple reçoit son rang, pour se poser dans l'ordre de lecture quand l'écran s'allume.
  const LIGNES = '.ecran__chip, .g__barre, .g__carte, .g__item, .ia__q, .ia__r, .ia__chip, .ad__tag, .ad__url, .ad__titre, .ad__texte, .ad__liens, .ad__suivi li, .ig__tete, .ig__media, .ig__texte, .ig__cta, .ph__tete, .ph__liste li, .ph__quand, .ph__btn, .ph__note, .bi__tete, .bi__voyants li, .bi__suite, .bi__qui';
  document.querySelectorAll('.exp .ecran').forEach((ecran) => { const lignes = ecran.querySelectorAll(LIGNES); lignes.forEach((el, i) => { el.classList.add('rl'); el.style.setProperty('--l', i); }); ecran.style.setProperty('--n', lignes.length); });
  // La loupe « Ce qu'on mesure » : un seul écran ouvert à la fois ; Échap ou un tap ailleurs referme.
  const fermer = () => document.querySelectorAll('.ecran--ouvert').forEach((f) => { f.classList.remove('ecran--ouvert'); f.querySelector('.ecran__loupe').setAttribute('aria-expanded', 'false'); });
  document.querySelectorAll('.ecran__loupe').forEach((b) => b.addEventListener('click', () => { const f = b.closest('.ecran'), on = !f.classList.contains('ecran--ouvert'); fermer(); if (on) { f.classList.add('ecran--ouvert'); b.setAttribute('aria-expanded', 'true'); } }));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fermer(); });
  document.addEventListener('pointerdown', (e) => { if (!e.target.closest('.ecran--ouvert')) fermer(); });
  // On observe les écrans eux-mêmes (sur téléphone, l'écran vient après le texte) ; la section s'allume quand un cinquième de l'écran est visible,
  // ou dès que son haut dépasse la moitié de la fenêtre (écrans très hauts), ou s'il est déjà passé (arrivée par une ancre, retour arrière).
  const cibles = document.querySelectorAll('.exp .ecran, .carte');
  const allumer = (el) => (el.closest('.exp') || el).classList.add('allume');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) { cibles.forEach(allumer); return; }
  const io = new IntersectionObserver((entrees) => entrees.forEach((e) => {
    const r = e.boundingClientRect;
    if (e.intersectionRatio >= .2 || (e.isIntersecting && r.top < innerHeight * .5) || r.bottom < 0) { allumer(e.target); io.unobserve(e.target); }
  }), { threshold: [0, .1, .2], rootMargin: '0px 0px -8% 0px' });
  cibles.forEach((el) => io.observe(el));
})();
</script>
