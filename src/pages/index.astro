---
// Accueil « Cartographe » v2 (30.10.2026) : l'agence s'ouvre à tous les commerces, la restauration reste la spécialité (/restauration/).
// Le test de visibilité en direct dès l'ouverture, puis le savoir-faire montré plutôt que raconté (fiche Google, assistants IA,
// publicité Google et Meta, développeur, photographe, bilan mensuel), la preuve Pasta Mo', les 8 métiers, la zone (Genève, Vaud),
// la méthode, l'interlocuteur unique et les questions fréquentes (balisées FAQPage pour Google et pour les moteurs de réponse).
// Règles : jamais de chiffres inventés ni de prix, jamais d'image de plat générée par IA, les exemples d'écrans sont étiquetés « exemple fictif ».
import Cartographe from '../layouts/Cartographe.astro';
import TestVisibilite from '../components/TestVisibilite.astro';
import carte from '../data/carte-romande.json';
import { SITE } from '../config.js';
import { FAQ_GENERALE as FAQ } from '../data/questions-generales.js';
import { EXPERTS } from '../data/savoir-faire.js';
import { AGENCE, SITE_WEB } from '../data/agence.js';

const title = 'Agence marketing Genève et Vaud · Nouvelle Ardoise';
const description = 'Agence marketing Genève et Vaud : fiche Google, site, Instagram, publicité, un seul interlocuteur pour commerces et cabinets. Test gratuit en 30 secondes.';
const TEL = '078 213 38 68';


// Les 8 métiers accompagnés (même liste que l'appli de prospection). Jamais : bars et alcool, esthétique, onglerie, coiffure, fiduciaires, jeux, crédit.
const METIERS = [
  { nom: 'Restauration et cafés', besoin: 'Être trouvé à midi et recevoir des commandes sans commission.', plus: 'Commande à retirer, paiement par QR code à table, carte en ligne', lien: '/restauration/', ancre: 'Agence marketing restaurant', specialite: true },
  { nom: 'Artisans de bouche et épiceries', besoin: 'Montrer le savoir-faire et prendre les commandes à l’avance.', plus: 'Précommande en ligne, courtes vidéos du geste', lien: '/artisans/', ancre: 'Boulangers, pâtissiers, chocolatiers, traiteurs' },
  { nom: 'Santé et bien-être', besoin: 'Être trouvé par les patients du quartier et prendre les rendez-vous en ligne.', plus: 'Agenda en ligne relié au site et à la fiche Google, dans le respect des règles de la profession' },
  { nom: 'Mode et boutiques', besoin: 'Vendre aussi en ligne, pas seulement en vitrine.', plus: 'Boutique en ligne ou retrait en magasin, catalogue Instagram' },
  { nom: 'Services de quartier', besoin: 'Être trouvé au moment où l’on a besoin de vous.', plus: 'Fiche Google, avis, site avec demande de devis' },
  { nom: 'Hébergement et loisirs', besoin: 'Plus de réservations en direct, moins de commissions.', plus: 'Réservation directe, photos et vidéo drone' },
  { nom: 'Bâtiment et second œuvre', besoin: 'Recevoir des demandes de devis sérieuses.', plus: 'Google Ads local, chantiers en photos avant et après' },
  { nom: 'Entreprises et bureaux', besoin: 'Inspirer confiance et recruter.', plus: 'LinkedIn, site institutionnel, contenu régulier' },
];

const ETAPES = [
  { titre: 'Le diagnostic', texte: 'Quatre voyants en direct (Google, site, Instagram, vente en ligne), puis sur place : votre quartier, vos concurrents, ce que vos clients tapent.' },
  { titre: 'Trois priorités', texte: 'On ne fait pas tout. On choisit les trois actions qui rapportent le plus chez vous, avec un objectif chiffré fixé dès le départ.' },
  { titre: 'La mise en place, puis le bilan', texte: 'Photos, vidéos, site, fiche Google, publicité : on produit et on installe. Chaque mois, un bilan simple : on teste, on apprend, on ajuste.' },
];

// La route le long du Léman, de Genève à Montreux : chaque ville s'allume quand le trait l'atteint.
const ROUTE = ['Genève', 'Versoix', 'Nyon', 'Gland', 'Rolle', 'Morges', 'Lausanne', 'Vevey', 'Montreux'];
const ville = Object.fromEntries(carte.villes.map((v) => [v.nom, v]));
const route = 'M' + ROUTE.map((n) => `${ville[n].x} ${ville[n].y}`).join(' L');
const GAUCHE = ['Meyrin', 'Morges'];
const dist = (a, b) => Math.hypot(ville[a].x - ville[b].x, ville[a].y - ville[b].y);
const cumul = ROUTE.map((n, i) => (i === 0 ? 0 : dist(ROUTE[i - 1], n)));
const total = cumul.reduce((s, d) => s + d, 0);
let acc = 0;
const fraction = Object.fromEntries(ROUTE.map((n, i) => { acc += cumul[i]; return [n, acc / total]; }));
// Délai d'allumage en secondes : la part du trait parcourue (2,4 s au total), les villes hors route après la fin.
const delai = (n) => (n in fraction ? 0.2 + fraction[n] * 2.4 : 2.9).toFixed(2);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    AGENCE,
    SITE_WEB,
    { '@type': 'WebPage', '@id': SITE.url + '/#page', url: SITE.url + '/', name: title, description, isPartOf: { '@id': SITE.url + '/#site' }, about: { '@id': SITE.url + '/#agence' }, inLanguage: 'fr-CH' },
    { '@type': 'FAQPage', '@id': SITE.url + '/#faq', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })) },
  ],
});
---
<Cartographe title={title} description={description} jsonLd={jsonLd} image="/partage-commerces.jpg" imageAlt="Qu’on vous trouve. Qu’on vous choisisse. Nouvelle Ardoise, agence de marketing à Genève et Vaud">
  <section class="ouv cadre" aria-labelledby="titre">
    <div class="ouv__texte">
      <h1 id="titre"><span class="etiquette h1__sur">Agence de marketing<span class="ouv__long"> et de communication</span> · Genève &amp; Vaud</span>Qu’on vous trouve.<br /><em>Qu’on vous choisisse.</em></h1>
      <p class="ouv__chapo">Google, site, Instagram, vente en ligne&#8239;: on mesure où vous perdez des clients, on règle ce qui rapporte le plus, et on le prouve chaque mois.</p>
      <ul class="ouv__preuves" aria-label="Nos engagements">
        <li><b>Sur place</b><span>de Genève à Montreux</span></li>
        <li><b>Un objectif chiffré</b><span>fixé dès le départ</span></li>
        <li><b>Un bilan</b><span>chaque mois</span></li>
      </ul>
    </div>
    <div class="ouv__test"><TestVisibilite /></div>
  </section>

  <section class="sec cadre" id="savoir-faire" aria-labelledby="sf-titre">
    <div class="sec__tete">
      <p class="etiquette">Le savoir-faire, montré</p>
      <h2 id="sf-titre">Visible partout où l’on vous cherche.</h2>
      <p class="chapo">Google, les assistants IA, Instagram, la publicité&#8239;: chaque canal a son expert dans l’équipe. Vous, vous n’avez qu’un interlocuteur.</p>
    </div>
    <ol class="exps">
      {EXPERTS.map((e) => (
        <li class="exp" id={'sf-' + e.id}>
          <div class="exp__texte">
            <p class="etiquette">{e.expert}</p>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
            <p class="exp__objectif"><span class="etiquette">Objectif</span>{e.objectif}</p>
          </div>

          {e.id === 'google' && (
            <figure class="ecran" aria-label="Exemple fictif de résultats Google locaux où le commerce accompagné apparaît en premier">
              <span class="ecran__chip" aria-hidden="true">Exemple fictif</span>
              <div class="g">
                <div class="g__barre"><span class="g__loupe" aria-hidden="true"></span>boulangerie carouge</div>
                <div class="g__carte" aria-hidden="true"><span class="g__pin g__pin--vous"></span><span class="g__pin g__pin--2"></span><span class="g__pin g__pin--3"></span></div>
                <ol class="g__liste">
                  <li class="g__item g__item--vous"><span class="g__nom">Maison Fève</span><span class="g__note"><span class="g__etoiles" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span>4,8 · 212 avis</span><span class="g__meta">Boulangerie · Carouge · Ouvert · Précommande en ligne</span><span class="g__vous">Vous</span></li>
                  <li class="g__item"><span class="g__trait g__trait--nom"></span><span class="g__note"><span class="g__etoiles" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i class="g__etoile--vide">☆</i></span>4,3 · 58 avis</span><span class="g__trait"></span></li>
                  <li class="g__item"><span class="g__trait g__trait--nom"></span><span class="g__note"><span class="g__etoiles" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i class="g__etoile--vide">☆</i></span>4,1 · 24 avis</span><span class="g__trait g__trait--court"></span></li>
                </ol>
              </div>
              <button type="button" class="ecran__loupe" aria-expanded="false" aria-controls="mesure-google">Ce qu’on mesure</button>
              <p class="ecran__mesure" id="mesure-google">Ce qu’on mesure ici : fiche à jour, horaires, photos, avis et réponses, bouton de précommande.</p>
            </figure>
          )}

          {e.id === 'ia' && (
            <figure class="ecran" aria-label="Exemple fictif de réponse d’un assistant IA qui recommande le cabinet accompagné">
              <span class="ecran__chip" aria-hidden="true">Exemple fictif</span>
              <div class="ia">
                <p class="ia__q">Un physiothérapeute à Lausanne, ouvert le samedi matin&#8239;?</p>
                <div class="ia__r">
                  <p><b>Cabinet Aubépine</b>, à Lausanne, reçoit le samedi de 8&nbsp;h à 12&nbsp;h et permet de prendre rendez-vous en ligne depuis sa fiche Google. Les avis mentionnent l’accueil et la ponctualité.</p>
                  <p class="ia__src"><span>Sources</span><span class="ia__chip">cabinet-aubepine.ch</span><span class="ia__chip">Fiche Google</span><span class="ia__chip">Avis patients</span></p>
                </div>
              </div>
              <button type="button" class="ecran__loupe" aria-expanded="false" aria-controls="mesure-ia">Ce qu’on mesure</button>
              <p class="ecran__mesure" id="mesure-ia">Ce qu’on mesure ici : si les assistants citent votre cabinet, avec quelles sources, et si elles sont à jour.</p>
            </figure>
          )}

          {e.id === 'ads' && (
            <figure class="ecran" aria-label="Exemple fictif d’annonce Google Ads en tête des résultats, avec les actions mesurées">
              <span class="ecran__chip" aria-hidden="true">Exemple fictif</span>
              <div class="ad">
                <p class="ad__tag">Sponsorisé</p>
                <p class="ad__url"><span class="ad__fav" aria-hidden="true">M</span>maisonfeve.ch</p>
                <p class="ad__titre">Maison Fève · Pain au levain à Carouge · Précommande pour demain</p>
                <p class="ad__texte">Retrait dès 7&nbsp;h. Boulangerie artisanale, pains, viennoiseries et tartes. Ouvert 7&nbsp;jours sur&nbsp;7.</p>
                <p class="ad__liens"><span>Précommander</span><span>Itinéraire</span><span>Appeler</span></p>
                <ul class="ad__suivi" aria-label="Actions mesurées"><li>Appels</li><li>Itinéraires</li><li>Commandes</li><li>Rendez-vous</li></ul>
              </div>
              <button type="button" class="ecran__loupe" aria-expanded="false" aria-controls="mesure-ads">Ce qu’on mesure</button>
              <p class="ecran__mesure" id="mesure-ads">Ce qu’on mesure ici : appels, itinéraires, commandes et rendez-vous venus de l’annonce, et leur coût.</p>
            </figure>
          )}

          {e.id === 'meta' && (
            <figure class="ecran" aria-label="Exemple de publication Instagram sponsorisée, avec une vraie photo Pasta Mo’, la marque de pâtes fraîches de la famille">
              <span class="ecran__chip" aria-hidden="true">Exemple · photo Pasta Mo’</span>
              <div class="ig">
                <div class="ig__tete"><span class="ig__avatar" aria-hidden="true">PM</span><span class="ig__qui"><b>pastamo</b><small>Sponsorisé · Genève, 3&nbsp;km</small></span></div>
                <div class="ig__media">
                  <img src="/accueil/pm/052.webp" alt="" width="960" height="540" loading="lazy" decoding="async" />
                  <span class="ig__duree" aria-hidden="true">0:15</span>
                  <span class="ig__play" aria-hidden="true"></span>
                  <span class="ig__legende">Réel tourné en cuisine · sans musique</span>
                  <span class="ig__barre" aria-hidden="true"></span>
                </div>
                <p class="ig__texte"><b>pastamo</b> Le pesto du matin, pignons et basilic frais. Pâtes fraîches pour vos événements et vos équipes, commande en ligne.</p>
                <p class="ig__cta">Commander</p>
              </div>
              <button type="button" class="ecran__loupe" aria-expanded="false" aria-controls="mesure-meta">Ce qu’on mesure</button>
              <p class="ecran__mesure" id="mesure-meta">Ce qu’on mesure ici : vues, enregistrements et clics vers la commande ; réels tournés chez vous, sans musique.</p>
            </figure>
          )}

          {e.id === 'dev' && (
            <figure class="ecran ecran--centre" aria-label="Exemple fictif d’une prise de rendez-vous en ligne sur le site d’un cabinet de physiothérapie">
              <span class="ecran__chip" aria-hidden="true">Exemple fictif</span>
              <div class="ph">
                <div class="ph__tete"><b>Cabinet Aubépine</b><span>Rendez-vous</span></div>
                <ul class="ph__liste"><li><span>Physiothérapie</span><span>30&nbsp;min</span></li><li><span>Première séance</span><span>Bilan inclus</span></li><li><span>Rappel</span><span>SMS la veille</span></li></ul>
                <div class="ph__quand"><span>Créneau</span><b>Jeudi · 8&nbsp;h&nbsp;30</b></div>
                <p class="ph__btn">Confirmer</p>
                <p class="ph__note">Agenda relié à la fiche Google et au site. Même socle pour une commande à retirer ou un devis.</p>
              </div>
              <button type="button" class="ecran__loupe" aria-expanded="false" aria-controls="mesure-dev">Ce qu’on mesure</button>
              <p class="ecran__mesure" id="mesure-dev">Ce qu’on mesure ici : rendez-vous et commandes pris en ligne, rappels envoyés, vitesse du site sur téléphone.</p>
            </figure>
          )}

          {e.id === 'photo' && (
            <figure class="ecran ecran--photo">
              <img src="/accueil/shooting.webp" alt="Une photographe cadre une composition de légumes et de fruits en studio, boîtier professionnel en main." width="1600" height="1067" loading="lazy" decoding="async" />
              <figcaption><span class="ecran__chip ecran__chip--photo">Photo de produits</span></figcaption>
            </figure>
          )}

          {e.id === 'bilan' && (
            <figure class="ecran" aria-label="Exemple fictif de bilan mensuel : les quatre voyants, la prochaine action et l’interlocuteur unique">
              <span class="ecran__chip" aria-hidden="true">Exemple fictif</span>
              <div class="bi">
                <div class="bi__tete"><b>Bilan mensuel</b><span>Octobre</span></div>
                <ul class="bi__voyants">
                  <li data-etat="bon"><span>Google</span><b>Bon</b></li>
                  <li data-etat="bon"><span>Site</span><b>Bon</b></li>
                  <li data-etat="moyen"><span>Instagram</span><b>À améliorer</b></li>
                  <li data-etat="bon"><span>Vente en ligne</span><b>En place</b></li>
                </ul>
                <p class="bi__suite"><span class="etiquette">Prochaine action</span>Tournage de deux réels dans l’atelier, mardi 8&nbsp;h.</p>
                <div class="bi__qui"><span class="bi__init" aria-hidden="true">M</span><span><b>Malik Younes</b><small>Votre interlocuteur · {TEL}</small></span></div>
              </div>
              <button type="button" class="ecran__loupe" aria-expanded="false" aria-controls="mesure-bilan">Ce qu’on mesure</button>
              <p class="ecran__mesure" id="mesure-bilan">Ce qu’on mesure ici : les quatre voyants chaque mois, l’écart avec l’objectif fixé, la prochaine action.</p>
            </figure>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="sec cadre" id="preuve" aria-labelledby="pr-titre">
    <div class="preuve">
      <figure class="preuve__image">
        <img src="/accueil/pm/001.webp" alt="Bol Pasta Mo’ : le parmesan tombe sur la sauce bolognaise, à côté d’un bol au pesto." width="960" height="540" loading="lazy" decoding="async" />
      </figure>
      <div class="preuve__texte">
        <p class="etiquette">Déjà en place</p>
        <h2 id="pr-titre">Pasta Mo’, <em>notre laboratoire.</em></h2>
        <p>Une marque familiale de pâtes fraîches et de street food italienne. Tout ce qu’on propose, on l’a d’abord fait tourner chez nous&#8239;: identité et emballages, site et commande en ligne, réels sans musique, appli de pilotage pour la production, les événements et les clients.</p>
        <p class="preuve__note">Les autres restaurants de nos maquettes sont des exemples fictifs, et nous le disons sur chaque page.</p>
        <a class="btn btn--creux" href="/realisations/">Voir les réalisations <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec cadre" id="metiers" aria-labelledby="met-titre">
    <div class="sec__tete">
      <p class="etiquette">Huit métiers</p>
      <h2 id="met-titre">Le même socle pour tous, <em>l’outil qui fait vendre pour chacun.</em></h2>
      <p class="chapo">Tout commerce doit être trouvé, inspirer confiance et vendre. Fiche Google, site, Instagram, photo et vidéo, bilan mensuel&#8239;: c’est le socle. Ce qui change d’un métier à l’autre, c’est l’outil qu’on ajoute.</p>
    </div>
    <ul class="metiers">
      {METIERS.map((m) => (
        <li class:list={['metier', { 'metier--phare': m.specialite }]}>
          <div class="metier__nom">
            <h3>{m.nom}{m.specialite && <span class="metier__badge">Notre spécialité</span>}</h3>
            {m.lien && <a class="metier__lien" href={m.lien}>{m.ancre} <span aria-hidden="true">→</span></a>}
          </div>
          <p class="metier__besoin">{m.besoin}</p>
          <p class="metier__plus"><span class="etiquette">En plus pour vous</span>{m.plus}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="nuit" id="carte" aria-labelledby="carte-titre">
    <div class="cadre nuit__grille">
      <div class="nuit__texte">
        <p class="etiquette">Zone d’intervention</p>
        <h2 id="carte-titre">De Genève à Montreux,<br /><em>on vient chez vous.</em></h2>
        <p>Étude du quartier, shooting, tournage, rendez-vous&#8239;: on se déplace dans tout le canton de Genève et dans le canton de Vaud. Ailleurs en Suisse romande, on travaille en visio et on vient pour les tournages.</p>
        <ul class="villes" aria-label="Villes où nous intervenons">
          {['Genève', 'Carouge', 'Onex', 'Meyrin', 'Lancy', 'Versoix', 'Nyon', 'Gland', 'Rolle', 'Morges', 'Lausanne', 'Vevey', 'Montreux', 'Yverdon-les-Bains'].map((n) => <li>{n}</li>)}
        </ul>
        <a class="btn btn--craie" href="#test" data-cta>Tester ma visibilité</a>
      </div>
      <figure class="carte" aria-label="Carte du canton de Genève, du Léman et du canton de Vaud avec les villes où nous intervenons">
        <svg viewBox={`0 0 ${carte.w} ${carte.h}`} role="img" aria-hidden="true">
          <path class="carte__vd" d={carte.vd} />
          <path class="carte__ge" d={carte.ge} />
          <path class="carte__lac" d={carte.lac} />
          <path class="carte__route" d={route} pathLength="1" />
          {carte.villes.map((v) => (
            <g class:list={['carte__ville', { 'carte__ville--siege': v.nom === 'Genève', 'carte__ville--petit': v.petit }]} style={`--d:${delai(v.nom)}s`} transform={`translate(${v.x} ${v.y})`}>
              {v.nom === 'Genève' && <circle class="carte__onde" r="10" />}
              <circle class="carte__point" r={v.petit ? 5 : 8} />
              {!v.petit && <text x={GAUCHE.includes(v.nom) ? -14 : 14} y={v.nom === 'Morges' ? -8 : 8} text-anchor={GAUCHE.includes(v.nom) ? 'end' : 'start'}>{v.nom}</text>}
            </g>
          ))}
          <text class="carte__lac-nom" x="430" y="610">Léman</text>
        </svg>
        <figcaption><span class="carte__item"><span class="carte__cle carte__cle--ge"></span>Canton de Genève, notre base</span><span class="carte__item"><span class="carte__cle"></span>Canton de Vaud</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="sec cadre" id="methode" aria-labelledby="meth-titre">
    <div class="sec__tete">
      <p class="etiquette">La méthode</p>
      <h2 id="meth-titre">Peu de choses, bien faites, mesurées.</h2>
      <p class="chapo">Pas de forfait fourre-tout. Trois temps, toujours dans cet ordre, et un objectif qu’on peut vérifier.</p>
    </div>
    <ol class="etapes">
      {ETAPES.map((e, i) => (
        <li class="etape"><span class="etape__n" aria-hidden="true">{i + 1}</span><h3>{e.titre}</h3><p>{e.texte}</p></li>
      ))}
    </ol>
  </section>

  <section class="sec cadre" id="interlocuteur" aria-labelledby="qui-titre">
    <div class="qui">
      <div class="qui__portrait" aria-hidden="true"><span>M</span></div>
      <div class="qui__texte">
        <p class="etiquette">Un seul interlocuteur</p>
        <h2 id="qui-titre">Malik Younes, <em>fondateur.</em></h2>
        <p>Graphiste de formation, passé par la vente et le commerce de détail, Malik a monté Nouvelle Ardoise à Genève pour les commerçants qu’il croise tous les jours. Il mène le diagnostic, fixe les priorités avec vous et coordonne les experts. Pasta Mo’, la marque de pâtes fraîches de sa famille, lui sert de laboratoire.</p>
        <p>Autour de lui, des indépendants qui excellent chacun dans leur domaine&#8239;: photographe et vidéaste avec drone, experts du référencement et de la publicité Google et Meta, développeurs.</p>
        <p class="qui__contact"><a href="tel:+41782133868">{TEL}</a><span aria-hidden="true"> · </span><a href={'mailto:' + SITE.email}>{SITE.email}</a></p>
      </div>
    </div>
  </section>

  <section class="sec cadre" id="specialite" aria-labelledby="spe-titre">
    <a class="spe" href="/restauration/">
      <div>
        <p class="etiquette">Notre spécialité</p>
        <h2 id="spe-titre">La restauration et les métiers de bouche.</h2>
        <p>Une branche à part, née dans une cuisine&#8239;: carte en ligne, commande à retirer sans commission, paiement par QR code, shootings et réels tournés pendant le service.</p>
      </div>
      <span class="spe__fleche" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="sec cadre" id="questions" aria-labelledby="faq-titre">
    <div class="sec__tete">
      <p class="etiquette">Questions fréquentes</p>
      <h2 id="faq-titre">Ce qu’on nous demande d’abord.</h2>
    </div>
    <div class="faq">
      {FAQ.map((f) => (
        <details class="faq__item" name="faq">
          <summary><span>{f.q}</span><span class="faq__plus" aria-hidden="true"></span></summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
    <p class="faq__suite"><a href="/questions/">Toutes les questions fréquentes <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="fin cadre" id="contact" aria-labelledby="fin-titre">
    <p class="etiquette">On en parle</p>
    <h2 id="fin-titre">Trente secondes de test,<br /><em>un café pour le reste.</em></h2>
    <div class="fin__actions">
      <a class="btn btn--craie" href="#test" data-cta>Tester ma visibilité</a>
      <a class="btn btn--creux" href="tel:+41782133868">{TEL}</a>
      <a class="btn btn--creux" href={'mailto:' + SITE.email}>{SITE.email}</a>
    </div>
  </section>
</Cartographe>

<style>
/* Ouverture : titre et test côte à côte ; sur téléphone le test arrive juste sous le titre, les engagements après */
.ouv { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; padding-block: clamp(32px, 6vw, 88px) clamp(56px, 8vw, 112px); }
.ouv__texte { padding-top: clamp(0px, 2vw, 24px); }
h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(46px, 7.2vw, 88px); line-height: .94; letter-spacing: -.035em; margin: 0; text-wrap: balance; }
.h1__sur { display: block; line-height: 1.4; font-style: normal; margin-bottom: 22px; text-wrap: initial; }
h1 em, h2 em { font-style: italic; }
.ouv__chapo { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.4; max-width: 34ch; margin: 28px 0 0; }
.ouv__preuves { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 0; border-top: 1px solid var(--encre); }
.ouv__preuves li { padding: 14px 28px 0 0; margin-right: 28px; border-right: 1px solid var(--filet); display: grid; font-size: 14px; }
.ouv__preuves li:last-child { border-right: 0; margin-right: 0; }
.ouv__preuves b { font-weight: 600; }
.ouv__preuves span { color: var(--gris); }
.ouv__test { position: relative; }

.sec { position: relative; padding-block: clamp(72px, 10vw, 136px); }
.sec::before, .fin::before { content: ""; position: absolute; top: 0; left: max(20px, env(safe-area-inset-left, 0px)); right: max(20px, env(safe-area-inset-right, 0px)); border-top: 1px solid var(--filet); }
.sec__tete { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }
.sec__tete .etiquette { grid-column: 1 / span 3; padding-top: 14px; }
.sec__tete h2 { grid-column: 4 / span 9; }
.sec__tete .chapo { grid-column: 4 / span 6; margin: 0; font-size: 19px; color: var(--gris); max-width: 46ch; }
h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(42px, 5.6vw, 84px); line-height: .96; letter-spacing: -.03em; margin: 0; text-wrap: balance; }
h3 { margin: 0; }

/* Le savoir-faire : texte à gauche (collé pendant qu'on fait défiler l'écran), écran d'exemple à droite */
.exps { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--encre); }
.exp { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 80px); align-items: start; padding-block: clamp(36px, 5vw, 64px); border-bottom: 1px solid var(--filet); }
.exp__texte { position: sticky; top: 96px; display: grid; gap: 16px; align-content: start; }
.exp__texte h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 3.2vw, 44px); line-height: 1.02; letter-spacing: -.025em; text-wrap: balance; max-width: 18ch; }
.exp__texte p { margin: 0; }
.exp__texte > p:not(.etiquette):not(.exp__objectif) { color: var(--gris); max-width: 46ch; }
.exp__objectif { display: grid; gap: 4px; padding-top: 12px; border-top: 1px solid var(--filet); max-width: 44ch; font-weight: 500; }
.ecran { position: relative; margin: 0; background: #FBF8F2; border: 1px solid var(--filet); border-radius: var(--r-l); padding: clamp(18px, 2.4vw, 32px); padding-top: 54px; min-height: 100%; box-shadow: 0 24px 48px -36px rgb(27 25 21 / .35); font-size: 15px; line-height: 1.4; }
.ecran--centre { display: grid; place-items: center; }
.ecran:not(.ecran--photo):not(.ecran--centre) { display: grid; align-content: center; }
.ecran__chip { position: absolute; top: 14px; right: 14px; z-index: 1; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--gris); background: var(--papier); border: 1px solid var(--filet); border-radius: 999px; padding: 4px 9px; }
.ecran--photo { padding: 0; overflow: hidden; }
.ecran--centre { padding-top: 54px; }
.ecran--photo img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3 / 2; }
.ecran--photo figcaption { position: absolute; left: 14px; bottom: 14px; }
.ecran__chip--photo { position: static; display: inline-block; color: var(--encre); background: var(--craie); border-color: var(--craie); }
/* Relevé : l'écran apparaît, puis ses lignes se posent dans l'ordre de lecture (rang --l posé par le script) ; la loupe dit ce qu'on y mesure */
:global(.js) .exp .ecran { opacity: 0; transition: opacity .35s var(--sortie); }
:global(.js) .exp.allume .ecran { opacity: 1; }
:global(.js) .exp .rl { opacity: 0; transform: translateY(6px); }
:global(.js) .exp.allume .rl { opacity: 1; transform: none; transition: opacity .4s var(--sortie), transform .4s var(--sortie); transition-delay: calc(160ms + var(--l, 0) * 60ms); }
/* Le bouton « Ce qu'on mesure » arrive en dernier, juste après la dernière ligne (--n lignes, posé par le script) */
:global(.js) .exp .ecran__loupe { opacity: 0; }
:global(.js) .exp.allume .ecran__loupe { opacity: 1; transition: opacity .4s var(--sortie), border-color .2s, background-color .2s, color .2s; transition-delay: calc(260ms + var(--n, 0) * 60ms), 0s, 0s, 0s; }
/* Le commerce accompagné se pose comme les autres, puis se marque « Vous » un demi-temps plus tard */
:global(.js) .exp.allume .g__item--vous { transition: opacity .4s var(--sortie), transform .4s var(--sortie), background-color .6s, border-color .6s; transition-delay: calc(160ms + var(--l, 0) * 60ms), calc(160ms + var(--l, 0) * 60ms), calc(620ms + var(--l, 0) * 60ms), calc(620ms + var(--l, 0) * 60ms); }
.ecran:has(.ecran__loupe) { padding-bottom: 62px; }
.ecran__loupe { position: absolute; left: 14px; bottom: 14px; z-index: 2; display: inline-flex; align-items: center; gap: 8px; min-height: 32px; margin: 0; padding: 0 12px 0 10px; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--encre); background: var(--papier); border: 1px solid var(--filet); border-radius: 999px; cursor: pointer; transition: border-color .2s, background-color .2s, color .2s; }
.ecran__loupe::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--craie); box-shadow: inset 0 0 0 1px var(--encre); }
.ecran__loupe::after { content: ""; position: absolute; inset: -6px; } /* zone de 44 px sous le pouce */
.ecran--ouvert .ecran__loupe { background: var(--encre); color: var(--papier); border-color: var(--encre); }
.ecran--ouvert .ecran__loupe::before { box-shadow: none; }
.ecran__mesure { position: absolute; left: 14px; right: 14px; bottom: 56px; z-index: 2; margin: 0; display: none; padding: 10px 12px; font-family: var(--mono); font-size: 12px; line-height: 1.45; letter-spacing: .02em; color: var(--papier); background: var(--encre); border-radius: var(--r-s); box-shadow: 0 16px 28px -16px rgb(27 25 21 / .55); }
.ecran--ouvert .ecran__mesure { display: block; animation: mesure .22s var(--sortie); }
@keyframes mesure { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@media (hover: hover) and (pointer: fine) { .ecran__loupe:hover { border-color: var(--encre); } }
html:not(.js) .ecran__loupe, html:not(.js) .ecran__mesure { display: none; }
html:not(.js) .ecran:has(.ecran__loupe) { padding-bottom: clamp(18px, 2.4vw, 32px); }

/* Google : le pack local, le commerce accompagné en premier */
.g { display: grid; gap: 12px; }
.g__barre { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--filet); background: #fff; color: var(--encre); font-size: 15px; }
.g__loupe { width: 14px; height: 14px; border: 2px solid var(--gris); border-radius: 50%; position: relative; flex: none; }
.g__loupe::after { content: ""; position: absolute; width: 2px; height: 7px; background: var(--gris); right: -4px; bottom: -6px; transform: rotate(-45deg); }
.g__carte { position: relative; height: 92px; border-radius: var(--r-s); background: linear-gradient(135deg, #E6E8E0, #D9DFD4 55%, #CFD9CF), repeating-linear-gradient(90deg, transparent 0 38px, rgb(255 255 255 / .55) 38px 40px); background-blend-mode: multiply; overflow: hidden; }
.g__carte::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, transparent 0 30px, rgb(255 255 255 / .5) 30px 32px); }
.g__pin { position: absolute; width: 14px; height: 14px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #8E877A; border: 2px solid #fff; }
.g__pin--vous { background: var(--encre); width: 20px; height: 20px; left: 44%; top: 32%; box-shadow: 0 0 0 5px rgb(255 210 63 / .35); }
.allume .g__pin--vous { animation: pin 1.6s ease-out .8s 1; }
@keyframes pin { 0% { box-shadow: 0 0 0 0 rgb(255 210 63 / .9); } 100% { box-shadow: 0 0 0 16px rgb(255 210 63 / 0); } }
.g__pin--2 { left: 18%; top: 58%; } .g__pin--3 { left: 72%; top: 22%; }
.g__liste { list-style: none; margin: 0; padding: 0; display: grid; }
.g__item { position: relative; display: grid; gap: 3px; padding: 12px 12px 12px 14px; border-top: 1px solid var(--filet); border-left: 3px solid transparent; }
.g__item--vous { background: #fff; border-left-color: var(--craie); border-radius: 0 var(--r-s) var(--r-s) 0; transition: background-color .6s, border-color .6s; transition-delay: .5s; }
:global(.js) .exp:not(.allume) .g__item--vous { background: transparent; border-left-color: transparent; }
.g__nom { font-weight: 600; font-size: 16px; }
.g__note { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--gris); }
.g__etoiles { color: #E0A400; letter-spacing: 1px; font-size: 12px; }
.g__etoiles i { display: inline-block; font-style: normal; }
.g__etoile--vide { color: #CFC6B5; }
.g__etoiles i:nth-child(2) { --e: 1 } .g__etoiles i:nth-child(3) { --e: 2 } .g__etoiles i:nth-child(4) { --e: 3 } .g__etoiles i:nth-child(5) { --e: 4 }
:global(.js) .exp .g__etoiles i { opacity: .25; transform: scale(.7); }
:global(.js) .exp.allume .g__etoiles i { opacity: 1; transform: none; transition: opacity .3s var(--sortie), transform .3s var(--sortie); transition-delay: calc(460ms + var(--l, 0) * 60ms + var(--e, 0) * 80ms); }
.g__meta { font-size: 13px; color: var(--gris); }
.g__vous { position: absolute; right: 12px; top: 12px; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; background: var(--craie); border-radius: 999px; padding: 3px 8px; }
.g__trait { height: 10px; width: 70%; border-radius: 999px; background: var(--filet); }
.g__trait--nom { width: 42%; height: 12px; background: #CFC6B5; }
.g__trait--court { width: 52%; }

/* Assistant IA : la question, la réponse qui cite le commerce, les sources */
.ia { display: grid; gap: 14px; max-width: 520px; }
.ia__q { margin: 0; justify-self: end; max-width: 80%; background: var(--encre); color: var(--papier); border-radius: var(--r-m) var(--r-m) 4px var(--r-m); padding: 10px 14px; }
.ia__r { display: grid; gap: 10px; background: #fff; border: 1px solid var(--filet); border-radius: 4px var(--r-m) var(--r-m) var(--r-m); padding: 14px 16px; }
.ia__r p { margin: 0; }
.ia__r b { background: linear-gradient(transparent 60%, var(--craie) 60% 92%, transparent 92%); font-weight: 600; }
.ia__src { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: var(--gris); }
.ia__src > span:first-child { font-family: var(--mono); letter-spacing: .06em; text-transform: uppercase; font-size: 11px; margin-right: 4px; }
.ia__chip { border: 1px solid var(--filet); border-radius: 999px; padding: 2px 8px; }

/* Google Ads : l'annonce en tête, les actions mesurées */
.ad { display: grid; gap: 6px; max-width: 560px; }
.ad__tag { margin: 0 0 4px; font-weight: 700; font-size: 13px; }
.ad__url { margin: 0; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--gris); }
.ad__fav { width: 22px; height: 22px; border-radius: 50%; background: var(--craie); display: inline-grid; place-items: center; font-family: var(--serif); font-size: 14px; color: var(--encre); }
.ad__titre { margin: 0; font-size: 18px; font-weight: 500; color: #1A0DAB; line-height: 1.25; }
.ad__texte { margin: 0; color: var(--encre-2); }
.ad__liens { margin: 2px 0 0; display: flex; flex-wrap: wrap; gap: 14px; color: #1A0DAB; font-size: 14px; }
.ad__suivi { list-style: none; margin: 14px 0 0; padding: 12px 0 0; border-top: 1px dashed var(--filet); display: flex; flex-wrap: wrap; gap: 8px; }
.ad__suivi li { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 12px; border: 1px solid var(--filet); border-radius: 999px; padding: 4px 10px; color: var(--gris); }
.ad__suivi li::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--craie); border: 1px solid var(--encre); }

/* Instagram : publication sponsorisée avec un réel tourné sur place */
.ig { max-width: 360px; margin-inline: auto; background: #fff; border: 1px solid var(--filet); border-radius: var(--r-m); overflow: hidden; }
.ig__tete { display: flex; align-items: center; gap: 10px; padding: 12px 14px; }
.ig__avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--craie); display: grid; place-items: center; font-family: var(--serif); font-size: 15px; }
.ig__qui { display: grid; line-height: 1.2; } .ig__qui small { color: var(--gris); font-size: 12px; }
.ig__media { position: relative; aspect-ratio: 1 / 1; background: var(--encre); display: grid; place-items: center; color: var(--papier); overflow: hidden; }
.ig__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 23% 50%; }
.ig__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(27 25 21 / .28), transparent 28% 62%, rgb(27 25 21 / .6)); }
.ig__play { position: relative; z-index: 1; width: 56px; height: 56px; border-radius: 50%; border: 2px solid var(--papier); background: rgb(27 25 21 / .35); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); display: grid; place-items: center; }
.ig__play::after { content: ""; border-left: 16px solid var(--papier); border-top: 10px solid transparent; border-bottom: 10px solid transparent; margin-left: 4px; }
.ig__duree { position: absolute; z-index: 1; top: 12px; right: 12px; font-family: var(--mono); font-size: 12px; color: var(--papier); background: rgb(27 25 21 / .55); padding: 3px 8px; border-radius: 999px; }
.ig__legende { position: absolute; z-index: 1; left: 14px; right: 14px; bottom: 16px; font-family: var(--mono); font-size: 12px; letter-spacing: .04em; color: var(--papier); text-shadow: 0 1px 2px rgb(0 0 0 / .5); }
.ig__barre { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 3px; background: rgb(255 255 255 / .3); }
.ig__barre::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 34%; background: var(--papier); }
.ig__texte { margin: 0; padding: 12px 14px 4px; font-size: 14px; }
.ig__cta { margin: 0; padding: 10px 14px 14px; color: #0A66C2; font-weight: 600; font-size: 14px; }

/* Développeur : la commande à retirer, sur téléphone */
.ph { width: min(100%, 300px); background: #fff; border: 1px solid var(--filet); border-radius: 28px; padding: 18px; display: grid; gap: 12px; box-shadow: inset 0 0 0 6px #F2EDE4; }
.ph__tete { display: flex; justify-content: space-between; align-items: baseline; padding: 8px 4px 0; }
.ph__tete span { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--gris); }
.ph__liste { list-style: none; margin: 0; padding: 0; display: grid; }
.ph__liste li { display: flex; justify-content: space-between; padding: 10px 4px; border-top: 1px solid var(--filet); font-size: 14px; }
.ph__quand { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--papier); border-radius: var(--r-s); font-size: 14px; }
.ph__quand span { color: var(--gris); }
.ph__btn { margin: 0; text-align: center; background: var(--encre); color: var(--papier); border-radius: 999px; padding: 12px; font-weight: 600; }
.ph__note { margin: 0; font-size: 12px; color: var(--gris); text-align: center; padding: 0 4px 4px; }

/* Bilan mensuel : voyants, prochaine action, interlocuteur */
.bi { display: grid; gap: 16px; max-width: 520px; }
.bi__tete { display: flex; justify-content: space-between; align-items: baseline; }
.bi__tete span { font-family: var(--mono); font-size: 12px; color: var(--gris); }
.bi__voyants { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.bi__voyants li { display: grid; gap: 2px; padding: 12px 12px 12px 30px; background: #fff; border: 1px solid var(--filet); border-radius: var(--r-s); font-size: 14px; position: relative; }
.bi__voyants li::before { content: ""; position: absolute; left: 12px; top: 18px; width: 10px; height: 10px; border-radius: 50%; background: var(--filet); transition: background-color .5s, box-shadow .5s; transition-delay: calc(.4s + var(--v, 0) * 150ms); }
.bi__voyants li:nth-child(2) { --v: 1 } .bi__voyants li:nth-child(3) { --v: 2 } .bi__voyants li:nth-child(4) { --v: 3 }
.bi__voyants li[data-etat="bon"]::before { background: var(--craie); box-shadow: 0 0 0 3px rgb(255 210 63 / .25); }
.bi__voyants li[data-etat="moyen"]::before { background: #fff; box-shadow: inset 0 0 0 2px var(--craie); }
:global(.js) .exp:not(.allume) .bi__voyants li::before { background: var(--filet); box-shadow: none; }
.bi__voyants span { color: var(--gris); }
.bi__suite { margin: 0; display: grid; gap: 4px; }
.bi__qui { display: flex; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid var(--filet); }
.bi__qui span:last-child { display: grid; line-height: 1.25; } .bi__qui small { color: var(--gris); font-size: 13px; }
.bi__init { width: 40px; height: 40px; border-radius: 50%; background: var(--encre); color: var(--craie); display: grid; place-items: center; font-family: var(--serif); font-size: 20px; flex: none; }

/* Preuve : Pasta Mo' */
.preuve { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
.preuve__image { margin: 0; border-radius: var(--r-l); overflow: hidden; }
.preuve__image img { width: 100%; height: auto; }
.preuve__texte { display: grid; gap: 18px; justify-items: start; }
.preuve__texte h2 { margin-top: 0; }
.preuve__texte p { margin: 0; max-width: 48ch; }
.preuve__note { font-size: 14px; color: var(--gris); }

/* Métiers */
.metiers { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--encre); }
.metier { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 3.6fr); gap: 20px 28px; align-items: baseline; padding-block: 24px; border-bottom: 1px solid var(--filet); }
.metier__nom { display: grid; gap: 10px; justify-items: start; }
.metier::before { content: ""; position: absolute; z-index: -1; inset: 0 -16px; border-radius: var(--r-s); background: var(--papier-2); opacity: 0; transition: opacity .25s; }
.metier h3 { font-size: clamp(22px, 2.2vw, 28px); font-weight: 650; letter-spacing: -.025em; line-height: 1.1; }
.metier__badge { display: inline-block; vertical-align: middle; margin-left: 10px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; background: var(--craie); padding: 3px 8px; border-radius: 999px; }
.metier__besoin { margin: 0; color: var(--gris); }
.metier__plus { margin: 0; display: grid; gap: 2px; font-size: 15px; }
.metier__lien { font-size: 15px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; text-decoration-color: color-mix(in srgb, var(--encre) 30%, transparent); transition: text-decoration-color .2s; }
.metier__lien::after { content: ""; position: absolute; inset: 0; }
@media (hover: hover) and (pointer: fine) { .metier:has(.metier__lien):hover::before { opacity: 1; } .metier:has(.metier__lien):hover .metier__lien { text-decoration-color: currentColor; } }
.metier--phare h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 2.8vw, 36px); letter-spacing: -.02em; }

/* Carte */
.nuit { background: var(--encre); color: var(--papier); padding-block: clamp(72px, 10vw, 136px); overflow: hidden; }
.nuit .etiquette { color: var(--gris-nuit); }
.nuit__grille { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
.nuit__texte p:not(.etiquette) { color: #CFC7B8; max-width: 44ch; margin: 24px 0 0; }
