---
// Accueil « Ardoise vivante » (31.10.2026, choisi par Malik sur maquette) : la promesse du titre en cinq chapitres plein écran,
// un geste = un chapitre (Trouvé : Google ; Cité : assistants IA ; Vu : réseaux, vraies images ; Choisi : site et commande, vrai écran
// Pasta Mo’ ; Mesuré : bilan mensuel, tableau de bord d'exemple sans chiffres inventés). Puis le test en direct, les huit métiers,
// la zone (Suisse romande), les deux branches, les questions fréquentes (balisées FAQPage) et le numéro.
// Grands aplats ardoise, vert tableau, brique et papier ; le jaune craie seulement en accent. Jamais « sept experts » :
// Malik est l'interlocuteur unique et s'entoure d'indépendants. Aucun prix, aucune image de nourriture générée par IA.
// Mouvement : GSAP (scènes, piste épinglée) et Lenis à la souris seulement ; tout est coupé sous « mouvement réduit »,
// et la page reste entièrement lisible sans JavaScript (chapitres empilés).
import '@fontsource/ibm-plex-mono/500.css';
import Cartographe from '../layouts/Cartographe.astro';
import TestVisibilite from '../components/TestVisibilite.astro';
import carte from '../data/carte-romande.json';
import { SITE } from '../config.js';
import { FAQ_GENERALE as FAQ } from '../data/questions-generales.js';
import { AGENCE, SITE_WEB, VILLES_ACCUEIL } from '../data/agence.js';
import { VILLES_SEO } from '../data/villes-seo.js';
const PAGE_VILLE = Object.fromEntries(VILLES_SEO.map((v) => [v.ville, `/agence-marketing/${v.id}/`]));

const title = 'Agence marketing Genève et Suisse romande · Nouvelle Ardoise';
const description = 'Agence marketing Genève et Suisse romande : fiche Google, site, Instagram, publicité, un seul interlocuteur pour commerces et cabinets. Test gratuit en 30 secondes.';
const TEL = '078 213 38 68';


// Les 8 métiers accompagnés (même liste que l'appli de prospection). Jamais : bars et alcool, esthétique, onglerie, coiffure, fiduciaires, jeux, crédit.
const METIERS = [
  { nom: 'Restauration et cafés', besoin: 'Être trouvé à midi et recevoir des commandes sans commission.', plus: 'Commande à retirer, paiement par QR code à table, carte en ligne', lien: '/restauration/', ancre: 'Agence marketing restaurant', specialite: true },
  { nom: 'Artisans de bouche et épiceries', besoin: 'Montrer le savoir-faire et prendre les commandes à l’avance.', plus: 'Précommande en ligne, courtes vidéos du geste', lien: '/artisans/', ancre: 'Boulangers, pâtissiers, chocolatiers, traiteurs' },
  { nom: 'Santé et bien-être', besoin: 'Être trouvé par les patients du quartier et prendre les rendez-vous en ligne.', plus: 'Agenda en ligne relié au site et à la fiche Google, dans le respect des règles de la profession' },
  { nom: 'Mode et boutiques', besoin: 'Vendre aussi en ligne, pas seulement en vitrine.', plus: 'Boutique en ligne ou retrait en magasin, catalogue Instagram' },
  { nom: 'Services de quartier', besoin: 'Être trouvé au moment où l’on a besoin de vous.', plus: 'Fiche Google, avis, site avec demande de devis' },
  { nom: 'Hébergement et loisirs', besoin: 'Plus de réservations en direct, moins de commissions.', plus: 'Réservation directe, photos et vidéo drone' },
  { nom: 'Bâtiment et second œuvre', besoin: 'Recevoir des demandes de devis sérieuses.', plus: 'Google Ads local, chantiers en photos avant et après' },
  { nom: 'Entreprises et bureaux', besoin: 'Inspirer confiance et recruter.', plus: 'LinkedIn, site institutionnel, contenu régulier' },
];

// Le réseau part de Genève : le long du Léman jusqu'à Montreux, puis les branches (Valais, pied du Jura, Fribourg, Broye, Chablais, vallée de Moutier).
// Chaque branche démarre quand le trait de sa branche mère atteint sa première ville ; vitesse constante ; chaque ville s'allume quand le trait l'atteint.
const ROUTES = [
  ['Genève', 'Versoix', 'Nyon', 'Gland', 'Rolle', 'Morges', 'Lausanne', 'Vevey', 'Montreux'],
  ['Montreux', 'Aigle', 'Martigny', 'Sion', 'Sierre', 'Brig-Glis'],
  ['Lausanne', 'Yverdon-les-Bains', 'Neuchâtel', 'La Chaux-de-Fonds', 'Saignelégier', 'Delémont', 'Porrentruy'],
  ['Vevey', 'Bulle', 'Fribourg'],
  ['Yverdon-les-Bains', 'Payerne'],
  ['Aigle', 'Monthey'],
  ['Delémont', 'Moutier'],
];
const ville = Object.fromEntries(carte.villes.map((v) => [v.nom, v]));
const dist = (a, b) => Math.hypot(ville[a].x - ville[b].x, ville[a].y - ville[b].y);
const DEPART = 0.2, DUREE_MAX = 3.4; // secondes : attente après l'allumage, puis durée de la plus longue chaîne
const arrivee = { [ROUTES[0][0]]: 0 }; // distance parcourue par le trait quand il atteint chaque ville
const routes = ROUTES.map((noms) => {
  const debut = arrivee[noms[0]];
  let d = 0;
  noms.forEach((n, i) => { if (i) d += dist(noms[i - 1], n); if (!(n in arrivee) || debut + d < arrivee[n]) arrivee[n] = debut + d; });
  return { d: 'M' + noms.map((n) => `${ville[n].x} ${ville[n].y}`).join(' L'), debut, longueur: d };
});
const vitesse = Math.max(...Object.values(arrivee)) / DUREE_MAX; // unités par seconde
const sec = (u) => (DEPART + u / vitesse).toFixed(2);
// Délai d'allumage en secondes ; les villes hors réseau (autour de Genève) après la fin.
const delai = (n) => (n in arrivee ? sec(arrivee[n]) : (DEPART + DUREE_MAX + 0.1).toFixed(2));
const leman = carte.lacs.find((l) => l.nom === 'Léman');

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    AGENCE,
    SITE_WEB,
    { '@type': 'WebPage', '@id': SITE.url + '/#page', url: SITE.url + '/', name: title, description, isPartOf: { '@id': SITE.url + '/#site' }, about: { '@id': SITE.url + '/#agence' }, inLanguage: 'fr-CH' },
    { '@type': 'FAQPage', '@id': SITE.url + '/#faq', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.r } })) },
  ],
});
---
<Cartographe title={title} description={description} jsonLd={jsonLd} image="/partage-commerces.jpg" imageAlt="Qu’on vous trouve. Qu’on vous choisisse. Nouvelle Ardoise, agence de marketing à Genève et en Suisse romande" entete="flottant" teinte="#1E2427">
  <script is:inline>(function () { if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; var d = document.documentElement; d.classList.add('attente'); setTimeout(function () { if (!window.__vivante) d.classList.remove('attente'); }, 3000); })();</script>

  <section class="ouv" data-fond="ardoise" aria-labelledby="titre">
    <div class="g">
      <h1 class="titre" id="titre">
        <span class="ouv__sur">Agence de marketing et de communication · Genève et Suisse romande</span>
        <span class="l l1"><span>Qu’on vous</span></span>
        <span class="l l2"><span>trouve.</span></span>
        <span class="l l3"><span>Qu’on vous</span></span>
        <span class="l l4"><span><em>choisisse.<svg class="trait" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14 C 70 4, 160 18, 296 6"/></svg></em></span></span>
      </h1>
      <div class="ouv__bas">
        <p>Restaurants, boulangeries, cabinets, artisans&#8239;: on trouve où vos clients vous ratent, puis on corrige d’abord ce qui rapporte.</p>
      </div>
    </div>
    <div class="ruban" aria-hidden="true">
      <div class="rang rang--a" data-fond="craie"><div class="defile"><span>Restaurants</span><span>Boulangeries</span><span>Physios</span><span>Garages</span><span>Fleuristes</span><span>Hôtels</span><span>Chocolatiers</span><span>Opticiens</span><span>Menuisiers</span><span>Épiceries fines</span></div></div>
      <div class="rang rang--b" data-fond="papier"><div class="defile"><span>Traiteurs</span><span>Boutiques</span><span>Cabinets dentaires</span><span>Cafés</span><span>Peintres</span><span>Pâtisseries</span><span>Gîtes</span><span>Électriciens</span><span>Fromageries</span><span>Ostéopathes</span></div></div>
    </div>
  </section>

  <section class="mani g" data-fond="brique" aria-labelledby="mani-titre">
    <div class="mani__un" aria-hidden="true">1</div>
    <p class="etiq">Comment on travaille</p>
    <h2 id="mani-titre"><span class="a">Un seul interlocuteur.</span><span class="b">Tout votre marketing local.</span></h2>
    <p class="mani__txt">Vous parlez toujours à Malik. Il fixe l’objectif avec vous, pilote chaque chantier et vous fait un bilan chaque mois.</p>
    <ul class="puces">
      <li>Google Maps</li><li>ChatGPT et les IA</li><li>Publicité Google</li><li>Instagram et Facebook</li><li>Site et outils sur mesure</li><li>Photo, vidéo, drone</li><li>Bilan mensuel</li>
    </ul>
  </section>

  <section class="piste" id="savoir-faire" aria-labelledby="sf-titre">
    <h2 class="sr" id="sf-titre">Ce qu’on fait pour vous, en cinq chapitres</h2>
    <div class="piste__vue">
      <div class="piste__rail">
        <article class="pan pan--papier g" data-fond="papier" data-fig="trouve">
          <p class="pan__etiq etiq"><span class="pan__n" aria-hidden="true">01 / 05</span>Google Maps · Publicité Google</p>
          <h3 class="pan__mot">Trouvé.</h3>
          <p class="pan__txt">En haut de la carte quand on cherche votre métier dans le quartier.</p>
          <ul class="pan__faits"><li>Fiche Google complète</li><li>Avis et réponses</li><li>Annonces dans le quartier</li></ul>
          <div class="pan__fig" aria-hidden="true">
            <div class="recherche"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg><span class="tape" data-texte="boulangerie Carouge">boulangerie Carouge</span><span class="caret"></span></div>
            <div class="plan"><svg viewBox="0 0 400 160"><path class="riv" d="M-20 128C70 96 130 150 220 118S350 66 420 86"/><g class="rues"><path d="M-10 36H410"/><path d="M-10 88L410 62"/><path d="M58-10V170"/><path d="M168-10L196 170"/><path d="M304-10L282 170"/><path d="M-10 150L410 158"/></g><g transform="translate(96 74)"><g class="chute e-gris"><path d="M0 0C-4-8-13-14-13-24a13 13 0 1 1 26 0c0 10-9 16-13 24z"/><circle cy="-24" r="5"/></g></g><g transform="translate(330 46)"><g class="chute e-gris"><path d="M0 0C-4-8-13-14-13-24a13 13 0 1 1 26 0c0 10-9 16-13 24z"/><circle cy="-24" r="5"/></g></g><g transform="translate(122 138)"><g class="chute e-gris"><path d="M0 0C-4-8-13-14-13-24a13 13 0 1 1 26 0c0 10-9 16-13 24z"/><circle cy="-24" r="5"/></g></g><g transform="translate(236 92)"><circle class="halo" cy="-31" r="22"/><g class="chute e-1"><path d="M0 0C-5-10-17-18-17-31a17 17 0 1 1 34 0c0 13-12 21-17 31z"/><text y="-26">1</text></g></g></svg></div>
            <div class="vignette fiche">
              <b>Votre boulangerie</b>
              <span class="rang-1">1</span>
              <div class="etoiles"><svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/></svg><svg viewBox="0 0 24 24"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/></svg></div>
              <span class="etiq">Ouvert · itinéraire · appeler</span>
            </div>
          </div>
        </article>

        <article class="pan pan--ardoise g" data-fond="ardoise" data-fig="cite">
          <p class="pan__etiq etiq"><span class="pan__n" aria-hidden="true">02 / 05</span>ChatGPT · Gemini · Perplexity</p>
          <h3 class="pan__mot">Cité.</h3>
          <p class="pan__txt">Votre nom dans la réponse quand on demande conseil à une IA.</p>
          <ul class="pan__faits"><li>Infos justes partout</li><li>Pages lisibles par les IA</li><li>Suivi des réponses</li></ul>
          <div class="pan__fig" aria-hidden="true">
            <div class="bulle"><span class="tape" data-texte="Un physio ouvert le samedi à Lausanne ?">Un physio ouvert le samedi à Lausanne ?</span></div>
            <div class="reponse">
              <span class="etiq">Réponse de l’IA · exemple</span>
              <p><mark>Votre cabinet</mark>, à deux pas de la gare, prend des rendez-vous le samedi matin.</p>
            </div>
          </div>
        </article>

        <article class="pan pan--tableau g" data-fond="tableau" data-fig="vu">
          <p class="pan__etiq etiq"><span class="pan__n" aria-hidden="true">03 / 05</span>Instagram · Facebook · photo et vidéo</p>
          <h3 class="pan__mot">Vu.</h3>
          <p class="pan__txt">Le quartier vous voit avant même de vous chercher. Avec de vraies images, jamais d’IA.</p>
          <ul class="pan__faits"><li>Tournages chez vous</li><li>Publications régulières</li><li>Publicité locale ciblée</li></ul>
          <figure class="pan__fig photo">
            <div class="photo__cadre"><img src="/accueil/shooting.webp" width="1600" height="1067" loading="lazy" decoding="async" alt="Une photographe cadre une composition de légumes et de fruits, appareil professionnel en main."></div>
            <div class="photo__qui" aria-hidden="true"><span class="vous">Vous</span><span>Nouveaux arrivants</span><span>Familles</span><span>Bureaux voisins</span></div>
          </figure>
        </article>

        <article class="pan pan--brique g" data-fond="brique" data-fig="choisi">
          <p class="pan__etiq etiq"><span class="pan__n" aria-hidden="true">04 / 05</span>Site · commande · rendez-vous</p>
          <h3 class="pan__mot">Choisi.</h3>
          <p class="pan__txt">On commande et on réserve chez vous, sans commission à une plateforme.</p>
          <ul class="pan__faits"><li>Site rapide sur téléphone</li><li>Commande ou rendez-vous</li><li>Vos clients restent à vous</li></ul>
          <figure class="pan__fig ecran">
            <img src="/accueil/pm-pret.webp" width="1100" height="996" loading="lazy" decoding="async" alt="Écran de commande Pasta&nbsp;Mo’ : les numéros prêts s’affichent, un code QR permet de commander depuis son téléphone.">
            <figcaption class="etiq">Vrai projet · écran de commande Pasta&nbsp;Mo’</figcaption>
          </figure>
        </article>
        <article class="pan pan--papier g" data-fond="papier" data-fig="mesure">
          <p class="pan__etiq etiq"><span class="pan__n" aria-hidden="true">05 / 05</span>Bilan mensuel · tableau de bord</p>
          <h3 class="pan__mot">Mesuré.</h3>
          <p class="pan__txt">Chaque mois, un tableau de bord clair&#8239;: ce qui rapporte, ce qu’on ajuste.</p>
          <ul class="pan__faits"><li>Tableau de bord en ligne</li><li>Bilan d’une page</li><li>Trois priorités par mois</li></ul>
          <div class="pan__fig tdb" aria-hidden="true">
            <div class="tdb__tete"><span class="etiq">Bilan du mois · exemple</span><span class="tdb__direct etiq"><i></i>À jour</span></div>
            <div class="tdb__tuiles"><div class="tuile"><span>Appels</span><svg viewBox="0 0 120 30"><path class="aire" d="M0 24C15 22 22 18 34 19S55 14 68 15S92 8 104 9S116 5 120 4L120 30L0 30Z"/><path class="courbe" pathLength="1" d="M0 24C15 22 22 18 34 19S55 14 68 15S92 8 104 9S116 5 120 4"/><circle class="point" cx="120" cy="4" r="3.5"/></svg><b>↗ En hausse</b></div><div class="tuile"><span>Itinéraires</span><svg viewBox="0 0 120 30"><path class="aire" d="M0 26C12 25 20 21 32 22S52 17 64 18S86 12 98 11S114 8 120 6L120 30L0 30Z"/><path class="courbe" pathLength="1" d="M0 26C12 25 20 21 32 22S52 17 64 18S86 12 98 11S114 8 120 6"/><circle class="point" cx="120" cy="6" r="3.5"/></svg><b>↗ En hausse</b></div><div class="tuile"><span>Visites du site</span><svg viewBox="0 0 120 30"><path class="aire" d="M0 22C14 24 24 18 36 20S58 13 70 14S90 10 102 7S116 6 120 5L120 30L0 30Z"/><path class="courbe" pathLength="1" d="M0 22C14 24 24 18 36 20S58 13 70 14S90 10 102 7S116 6 120 5"/><circle class="point" cx="120" cy="5" r="3.5"/></svg><b>↗ En hausse</b></div><div class="tuile"><span>Avis</span><svg viewBox="0 0 120 30"><path class="aire" d="M0 16C14 15 26 17 40 15S64 14 78 15S100 13 120 13L120 30L0 30Z"/><path class="courbe" pathLength="1" d="M0 16C14 15 26 17 40 15S64 14 78 15S100 13 120 13"/><circle class="point" cx="120" cy="13" r="3.5"/></svg><b>→ Stable</b></div></div>
            <div class="tdb__barres"><i style="--h:34%"></i><i style="--h:40%"></i><i style="--h:38%"></i><i style="--h:46%"></i><i style="--h:44%"></i><i style="--h:52%"></i><i style="--h:50%"></i><i style="--h:58%"></i><i style="--h:62%"></i><i style="--h:60%"></i><i style="--h:70%"></i><i style="--h:78%"></i></div>
            <ul class="tdb__prio"><li><svg viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="5"/><path class="coche" pathLength="1" d="M5.5 10.5l3 3 6-7"/></svg>Répondre aux nouveaux avis</li><li><svg viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="5"/><path class="coche" pathLength="1" d="M5.5 10.5l3 3 6-7"/></svg>Nouvelles photos de la vitrine</li><li><svg viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="5"/><path class="coche" pathLength="1" d="M5.5 10.5l3 3 6-7"/></svg>Annonce pour le samedi</li></ul>
          </div>
        </article>
      </div>
      <div class="compteur" aria-hidden="true"><span><b>01</b> / 05</span><i></i></div>
    </div>
  </section>

  <section class="essai g" data-fond="papier" aria-labelledby="essai-titre">
    <div>
      <p class="etiq">Le test · en direct · gratuit</p>
      <h2 class="v-titre" id="essai-titre"><span>Trente secondes.</span> <em><span>Quatre voyants.</span></em></h2>
      <p class="essai__txt">Tapez le nom de votre commerce&#8239;: Google, site, Instagram et vente en ligne s’allument, avec vos trois priorités.</p>
    </div>
    <div class="essai__test"><TestVisibilite titre="h3" titreTexte="Testez votre visibilité." /></div>
  </section>

  <section class="metiers g" id="metiers" data-fond="ardoise" aria-labelledby="met-titre">
    <p class="etiq">Huit familles de métiers</p>
    <h2 class="v-titre" id="met-titre">Le même socle. <em>L’outil qui fait vendre chez vous.</em></h2>
    <ul class="metiers__liste">
      {METIERS.map((m) => (
        <li class:list={['metier', { 'metier--phare': m.specialite }]}>
          <h3>{m.nom}{m.specialite && <span class="metier__badge">Notre spécialité</span>}</h3>
          <p>{m.besoin}</p>
          <p class="metier__plus"><span class="etiq">En plus</span>{m.plus}</p>
          {m.lien && <a class="metier__lien" href={m.lien}>{m.ancre} <span aria-hidden="true">→</span></a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="zone g" id="carte" data-fond="papier" aria-labelledby="carte-titre">
    <div>
      <p class="etiq">Zone d’intervention</p>
      <h2 class="v-titre" id="carte-titre">Toute la Suisse romande. <em>On vient chez vous.</em></h2>
      <p class="zone__txt">Étude du quartier, shooting, tournage, rendez-vous&#8239;: on se déplace dans les six cantons romands. La base est à Genève&#8239;; entre deux visites, on avance en visio.</p>
      <ul class="villes" aria-label="Villes où nous intervenons">
        {VILLES_ACCUEIL.map((v) => <li>{PAGE_VILLE[v] ? <a href={PAGE_VILLE[v]}>{v}</a> : v}</li>)}
      </ul>
    </div>
      <figure class="carte" aria-label="Carte de la Suisse romande, du Léman au Jura et au Valais, avec les villes où nous intervenons">
        <svg viewBox={`0 0 ${carte.w} ${carte.h}`} role="img" aria-hidden="true">
          {carte.cantons.filter((c) => c.id !== 'ge').map((c) => <path class="carte__canton" d={c.d} />)}
          <path class="carte__ge" d={carte.cantons.find((c) => c.id === 'ge').d} />
          {carte.lacs.map((l) => <path class="carte__lac" d={l.d} />)}
          {routes.map((r) => <path class="carte__route" d={r.d} pathLength="1" style={`--debut:${sec(r.debut)}s;--duree:${(r.longueur / vitesse).toFixed(2)}s`} />)}
          {carte.villes.map((v) => (
            <g class:list={['carte__ville', { 'carte__ville--siege': v.nom === 'Genève', 'carte__ville--petit': v.petit }]} style={`--d:${delai(v.nom)}s`} transform={`translate(${v.x} ${v.y})`}>
              {v.nom === 'Genève' && <circle class="carte__onde" r="10" />}
              <circle class="carte__point" r={v.petit ? 5 : 8} />
              {!v.petit && <text x={v.cote === 'g' ? -14 : 14} y={v.dy} text-anchor={v.cote === 'g' ? 'end' : 'start'}>{v.label}</text>}
            </g>
          ))}
          {/* Le nom du lac au large, sous l’axe Lausanne–Vevey, pour ne gêner aucune étiquette de ville */}
          {leman && <text class="carte__lac-nom" x={leman.cx - 30} y={leman.cy + 46} text-anchor="middle">Léman</text>}
        </svg>
        <figcaption><span class="carte__item"><span class="carte__cle carte__cle--ge"></span>Canton de Genève, notre base</span><span class="carte__item"><span class="carte__cle"></span>Vaud, Valais, Fribourg, Neuchâtel, Jura</span></figcaption>
      </figure>
  </section>

  <section class="branches g" data-fond="brique" aria-label="Nos deux branches">
    <a class="branche" href="/restauration/">
