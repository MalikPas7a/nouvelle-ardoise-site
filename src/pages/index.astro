<script is:inline>
(function () {
  const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CMD = [
    ['Click & Collect', 'Retrait 19 h 15', '60.–'],
    ['Payé à table', 'Table 6, par QR code', '84.–'],
    ['Click & Collect', 'Plateau pour 2', '48.–'],
    ['Fidélité', '10e plat offert', '0.–'],
    ['Click & Collect', 'Retrait 19 h 40', '36.–'],
    ['Payé à table', 'Table 2, par QR code', '57.–'],
  ];
  const notif = ([t, s, m]) => `<div class="notif"><i></i><span>${t}<small>${s}</small></span><b>${m}</b></div>`;
  function flux(el, n, delai) {
    if (!el) return;
    let i = 0;
    const garde = el.querySelector('.tuile__nom');
    const rendre = () => { el.innerHTML = ''; if (garde) el.appendChild(garde); for (let k = 0; k < n; k++) el.insertAdjacentHTML('beforeend', notif(CMD[(i + k) % CMD.length])); };
    rendre();
    if (!calme) setInterval(() => { i = (i + 1) % CMD.length; rendre(); }, delai);
  }
  flux(document.getElementById('mur-cmd'), 3, 2600);
  flux(document.getElementById('flux'), 4, 2200);

  // Compteur et courbe : valeur finale visible au repos, on rejoue quand la section arrive
  const c = document.getElementById('compteur'), courbe = document.getElementById('courbe');
  if (!calme && 'IntersectionObserver' in window && c) {
    let fait = false;
    new IntersectionObserver((e) => {
      if (fait || !e[0].isIntersecting) return; fait = true;
      courbe.classList.add('anime');
      const t0 = performance.now(), fin = 23;
      const pas = (t) => { const p = Math.min(1, (t - t0) / 1600); c.textContent = Math.round(fin * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(pas); };
      requestAnimationFrame(pas);
    }, { threshold: .4 }).observe(c);
  }

  // Onglets de l'équipe
  const tabs = [...document.querySelectorAll('.onglets [role="tab"]')], media = document.getElementById('eq-media'), panneau = document.getElementById('p-equipe');
  function choisir(b) {
    tabs.forEach((t) => { const ok = t === b; t.setAttribute('aria-selected', ok); t.tabIndex = ok ? 0 : -1; });
    panneau.setAttribute('aria-labelledby', b.id);
    const d = b.dataset;
    media.classList.toggle('vertical', d.type === 'video');
    media.innerHTML = d.type === 'video'
      ? `<video src="${d.media}" poster="${d.poster}" autoplay muted loop playsinline aria-label="${d.alt}"></video>`
      : `<img src="${d.media}" alt="${d.alt}">`;
    document.getElementById('eq-titre-p').textContent = d.titre;
    document.getElementById('eq-texte').textContent = d.texte;
  }
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => choisir(b));
    b.addEventListener('keydown', (e) => {
      const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (!k) return;
      const n = tabs[(i + k + tabs.length) % tabs.length]; n.focus(); choisir(n);
    });
  });

  // Pasta Mo' : petit film image par image (parmesan puis huile d'olive)
  const film = document.getElementById('pm-film');
  if (film && !calme) {
    const imgs = []; for (let k = 1; k <= 72; k += 3) imgs.push('/accueil/pm/' + String(k).padStart(3, '0') + '.webp');
    imgs.forEach((u) => { const im = new Image(); im.src = u; });
    let f = 0; setInterval(() => { f = (f + 1) % imgs.length; film.src = imgs[f]; }, f === 0 ? 160 : 160);
  }

  // Identité : défilement horizontal piloté par le défilement vertical (ordinateur), au doigt ailleurs
  const mes = document.getElementById('mes');
  if (mes) {
    const colle = mes.querySelector('.mes__colle'), piste = mes.querySelector('.mes__piste'), barre = document.getElementById('mes-barre');
    const grand = matchMedia('(min-width: 901px)');
    let dist = 0;
    const mesure = () => {
      if (calme || !grand.matches) { mes.classList.remove('epingle'); piste.style.transform = ''; return; }
      mes.classList.add('epingle');
      dist = Math.max(0, piste.scrollWidth - colle.clientWidth);
      mes.style.setProperty('--h', (colle.offsetHeight + dist) + 'px');
      bouge();
    };
    const bouge = () => {
      if (mes.classList.contains('epingle')) {
        const r = mes.getBoundingClientRect(), p = Math.min(1, Math.max(0, (90 - r.top) / Math.max(1, dist)));
        piste.style.transform = `translate3d(${-p * dist}px,0,0)`; barre.style.width = (p * 100) + '%';
      } else {
        barre.style.width = (colle.scrollLeft / Math.max(1, colle.scrollWidth - colle.clientWidth) * 100) + '%';
      }
    };
    addEventListener('scroll', bouge, { passive: true }); colle.addEventListener('scroll', bouge, { passive: true });
    addEventListener('resize', mesure); grand.addEventListener('change', mesure);
    addEventListener('load', mesure); mesure();
  }
})();
</script>

