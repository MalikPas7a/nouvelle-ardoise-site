---
import '@fontsource-variable/bodoni-moda/standard-italic.css';
import '@fontsource-variable/bodoni-moda/standard.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/syne/wght.css';
import '@fontsource/caveat/600.css';
import Base from '../layouts/Base.astro';
import MiniSite from '../components/MiniSite.astro';
import { getImage } from 'astro:assets';
import QRCode from 'qrcode';
import imgRagu from '../assets/photo-ragu.jpg';
import imgPerche from '../assets/photo-perche.jpg';
import imgRamen from '../assets/photo-ramen.jpg';
import imgSalle from '../assets/photo-salle.jpg';
import imgComptoir from '../assets/photo-comptoir.jpg';
import { RESTAURANTS, parId } from '../data/restaurants.js';
import { SITE } from '../config.js';
import { ANIMATIONS } from '../data/animations.js';

// Photos converties en WebP à la compilation, à la taille où elles sont affichées
const webp = (src, width) => getImage({ src, format: 'webp', width, quality: 72 });
const [ragu, perche, ramen, salle] = await Promise.all([webp(imgRagu, 1100), webp(imgPerche, 1100), webp(imgRamen, 1000), webp(imgSalle, 1200)]);
const comptoir = await webp(imgComptoir, 1600);
const photos = { osteria: ragu.src, leonie: perche.src, sora: ramen.src };

// Photo d'ouverture, en trois tailles : le téléphone ne charge que la petite
const ouverture = await Promise.all([800, 1200, 1600].map((w) => webp(imgRagu, w)));
const ouvertureSrcset = ouverture.map((o, i) => `${o.src} ${[800, 1200, 1600][i]}w`).join(', ');

// QR code vers le plat en 3D : il suit l'adresse du site définie dans config.js
const qr = (await QRCode.toString(SITE.url + '/demos/carte-3d/', { type: 'svg', margin: 0, color: { dark: '#1E2A2C', light: '#0000' } }))
  .replace('<svg ', '<svg role="img" aria-label="QR code vers le plat en 3D" ');

const sora = parId('sora');
const nbSora = sora.carte.reduce((n, s) => n + s.plats.length, 0);

// Données lues par Google pour comprendre qui est Nouvelle Ardoise
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nom,
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.telephone || undefined,
  areaServed: ['Genève', 'Vaud'],
  description: 'Sites web, gestion des réseaux sociaux, vidéo et menus en 3D pour les restaurants.',
  priceRange: 'CHF 999 – 3490',
});
---
<Base page="accueil" title="Nouvelle Ardoise | Sites, réseaux sociaux et menus 3D pour restaurants à Genève" description="Marketing digital pour les restaurants de Genève et Vaud : sites web, gestion des réseaux sociaux, vidéo et menus en 3D. Prix affichés, sites dès CHF 999.">
<script slot="head" type="application/ld+json" is:inline set:html={jsonLd}></script>

<!-- ============ Ouverture : un plat plein écran, tout est visible dès l'arrivée ============ -->
<section class="ouvre" aria-labelledby="titre-accueil">
  <img class="ouvre__photo" src={ouverture[1].src} srcset={ouvertureSrcset} sizes="100vw" alt="" width="1600" height="1194" fetchpriority="high" decoding="async" />
  <div class="ouvre__voile" aria-hidden="true"></div>
  <div class="cadre ouvre__contenu">
    <p class="ouvre__sur"><svg class="ouvre__n" viewBox="0 0 28 28" width="30" height="30" aria-hidden="true"><path d="M7.4 21.6V6.4l13.2 15.2V6.4" fill="none" stroke="#FFD23F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Sites, réseaux sociaux et menus 3D · Genève et Vaud</p>
    <h1 class="ouvre__titre" id="titre-accueil">Envie de passer l’éponge sur votre <span class="efface"><span class="efface__mot">ancien site</span><span class="efface__trace" aria-hidden="true">ancien site</span></span>&nbsp;?</h1>
    <p class="ouvre__nouveau">Place à votre <mark>nouveau site.</mark></p>
    <p class="chapo ouvre__chapo">Un site rapide, une carte lisible au pouce et vos plats en mouvement, pour les restaurants de Genève et Vaud. Sites dès CHF 999, prix affichés.</p>
    <div class="actions"><a class="btn btn--jaune" href="#contact">Demander un devis</a><a class="lien" href="#essayer">Essayer trois exemples</a></div>
  </div>
</section>

<!-- ============ Déjà fait : Pasta Mo', au défilement ============ -->
<section class="sequence sequence--pastamo" data-sequence="pastamo" data-images="72" data-tailles="p,g" data-sujet="0.385,0.58" aria-label="Pasta Mo’ : le parmesan tombe sur la bolognese, puis l’huile d’olive coule sur le pesto, au rythme du défilement">
  <div class="sequence__colle">
    <canvas class="sequence__toile" aria-hidden="true"></canvas>
    <div class="sequence__voile" aria-hidden="true"></div>
    <div class="cadre sequence__textes">
      <div class="sequence__texte sequence__texte--droite" data-de="-0.2" data-a="0.42">
        <h2 class="titre-2">Déjà fait : Pasta Mo’</h2>
        <p class="chapo">Notre propre enseigne de street food italienne, à Genève, et son site fait par nous. Faites défiler : le parmesan tombe sur la bolognese.</p>
      </div>
      <div class="sequence__texte sequence__texte--droite" data-de="0.52" data-a="1.2">
        <p class="titre-2">Puis l’huile d’olive, sur le pesto.</p>
        <p class="chapo">C’est le principe du site de Pasta Mo’ : un geste, un plan. Nous connaissons le service du midi de l’intérieur.</p>
        <div class="actions"><a class="btn btn--jaune" href="https://pastamo.ch" target="_blank" rel="noopener">Voir pastamo.ch</a></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ Le téléphone : trois restaurants à essayer ============ -->
<section class="ouverture" id="essayer">
  <div class="cadre ouverture__grille">
    <div class="ouverture__texte">
      <h2 class="titre-2">Trois restaurants, trois univers</h2>
      <p class="chapo">Choisissez un restaurant inventé pour l’occasion : le site, la carte et les couleurs changent. Faites défiler l’écran du téléphone, c’est un vrai site.</p>

      <div class="choix" role="group" aria-label="Choisir un restaurant de démonstration">
        {RESTAURANTS.map((r) => (
          <button type="button" class="choix__btn" data-choix={r.id} aria-pressed={r.id === 'osteria' ? 'true' : 'false'}>
            <b>{r.nom}</b>
            <span>{r.genre}, {r.quartier}</span>
          </button>
        ))}
      </div>

      <div class="actions">
        <a class="lien" href="#offres">Voir les offres, dès CHF 999</a>
      </div>
    </div>

    <div class="scene">
      <div class="telephone">
        <div class="telephone__ecran" data-ecran tabindex="0" aria-label="Aperçu du site sur téléphone, à faire défiler">
          {RESTAURANTS.map((r) => <MiniSite resto={r} photos={photos} />)}
        </div>
      </div>
      <p class="scene__note">Faites défiler l’écran : c’est un vrai site, pas une image.</p>
    </div>
  </div>
</section>

<!-- ============ Exemples : quatre choses que vos clients pourront faire ============ -->
<section class="bloc" id="exemples">
  <div class="cadre">
    <header class="bloc__tete">
      <h2 class="titre-2">Ce que vos clients pourront faire</h2>
      <p>Quatre exemples à essayer. Tout fonctionne sur téléphone, là où vos clients vous cherchent.</p>
    </header>

    <!-- 1. La carte filtrable -->
    <article class="demo">
      <div class="demo__texte">
        <h3 class="titre-3">Lire la carte sans zoomer</h3>
        <p>La carte s’affiche en texte, lisible au pouce. Vos clients filtrent les plats végétariens ou épicés et passent en anglais d’un geste. Google lit chaque plat, ce qu’il ne fait pas dans un PDF.</p>
        <p class="demo__ou">Carte en ligne incluse dans toutes les offres. Deuxième langue incluse dans l’offre Maison.</p>
      </div>
      <div class="demo__live vitrine vitrine--sora" data-carte>
        <img class="vitrine__photo" src={ramen.src} alt="Ramen shoyu de Sora, vu de dessus" width="1000" height="1000" loading="lazy" decoding="async" />
        <div class="vitrine__tete">
          <span class="vitrine__nom">Sora</span>
          <div class="langue" role="group" aria-label="Langue de la carte">
            <button type="button" data-langue="fr" aria-pressed="true">FR</button>
            <button type="button" data-langue="en" aria-pressed="false">EN</button>
          </div>
        </div>
        <div class="filtres" role="group" aria-label="Filtrer la carte">
          <button type="button" data-filtre="tout" aria-pressed="true" data-fr="Tout" data-en="All">Tout</button>
          <button type="button" data-filtre="vege" aria-pressed="false" data-fr="Végétarien" data-en="Vegetarian">Végétarien</button>
          <button type="button" data-filtre="epice" aria-pressed="false" data-fr="Épicé" data-en="Spicy">Épicé</button>
          <span class="filtres__n" aria-live="polite"><span data-compte>{nbSora}</span> <span data-fr="plats" data-en="dishes">plats</span></span>
        </div>
        {sora.carte.map((section) => (
          <div class="carte__section">
            <h4 data-fr={section.titre} data-en={section.en}>{section.titre}</h4>
            <ul>
              {section.plats.map((p) => (
                <li data-plat data-vege={p.vege ? '1' : '0'} data-epice={p.epice ? '1' : '0'}>
                  <div>
                    <b data-fr={p.nom} data-en={p.nomEn ?? p.nom}>{p.nom}</b>
                    {p.vege && <span class="pastille pastille--vege" data-fr="végé" data-en="veggie">végé</span>}
                    {p.epice && <span class="pastille pastille--epice" data-fr="épicé" data-en="spicy">épicé</span>}
                    <small data-fr={p.desc} data-en={p.en}>{p.desc}</small>
                  </div>
                  <span class="carte__prix">{p.prix}.–</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </article>

    <!-- 2. L'ardoise du jour -->
    <article class="demo demo--inverse">
      <div class="demo__texte">
        <h3 class="titre-3">Voir le plat du jour, à jour</h3>
        <p>Le matin, vous nous envoyez une photo de votre ardoise ou un simple message. Nous mettons votre plat du jour en ligne le matin même, sur votre site et sur vos réseaux. Essayez : écrivez le vôtre, il s’inscrit sur l’ardoise et sur le site de Chez Léonie, dans le téléphone en haut de page.</p>
        <form class="saisie" data-ardoise-form>
          <label>Plat du jour<input name="plat" maxlength="32" value="Filets de perche meunière" autocomplete="off"></label>
          <label class="saisie__prix">Prix (CHF)<input name="prix" inputmode="numeric" maxlength="3" value="36" autocomplete="off"></label>
        </form>
        <p class="demo__ou">Plat du jour mis en ligne chaque matin, inclus dans les offres Signature et Maison.</p>
      </div>
      <div class="demo__live ardoise" aria-live="polite">
        <p class="ardoise__resto">Chez Léonie</p>
        <p class="ardoise__titre">Plat du jour</p>
        <p class="ardoise__plat" data-ardoise-tableau>Filets de perche meunière</p>
        <svg class="ardoise__trait" viewBox="0 0 300 16" aria-hidden="true"><path d="M3 10C60 2 120 15 180 7s90-3 117 3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" pathLength="1"/></svg>
        <p class="ardoise__prix">CHF <span data-ardoise-prix>36</span></p>
        <p class="ardoise__suite">Entrée du jour, velouté de courge 9.–<br>Dessert, tarte Tatin 12.–</p>
      </div>
    </article>

    <!-- 3. Le plat en 3D -->
    <article class="demo">
      <div class="demo__texte">
        <h3 class="titre-3">Tourner le plat avant de le commander</h3>
        <p>Votre plat signature en 3D, à faire tourner du doigt. Sur téléphone, le client le pose sur sa table en réalité augmentée, à sa taille réelle. Un photographe vient chez vous, nous faisons le reste.</p>
        <div class="qr">
          <Fragment set:html={qr} />
          <p>Sur ordinateur ? Scannez ce code avec votre téléphone pour poser le plat sur votre table.</p>
        </div>
        <p class="demo__ou">Plats en 3D inclus dans l’offre Maison.</p>
      </div>
      <div class="demo__live plat3d" data-plat3d style={`--comptoir:url(${comptoir.src})`}>
        <model-viewer
          data-src="/models/tagliatelle-ragu-v2.glb"
          alt="Tagliatelle al ragù de l’Osteria del Lago, en 3D, posées sur un comptoir"
          camera-controls touch-action="pan-y" disable-zoom disable-pan
          shadow-intensity="2" shadow-softness="0.55" exposure="0.68" tone-mapping="aces" environment-image="neutral"
          camera-orbit="-30deg 60deg 0.78m" min-camera-orbit="auto 60deg 0.78m" max-camera-orbit="auto 60deg 0.78m"
          camera-target="0m 0.045m 0.02m" field-of-view="26deg" interpolation-decay="120"
          ar ar-modes="webxr quick-look" ar-scale="fixed" interaction-prompt="none">
          <button slot="ar-button" class="btn btn--jaune plat3d__ar" type="button">Voir sur ma table</button>
        </model-viewer>
        <div class="plat3d__lumiere" aria-hidden="true"></div>
        <p class="plat3d__legende"><b>Tagliatelle al ragù</b><span>Osteria del Lago, CHF 24</span></p>
        <p class="plat3d__aide" aria-hidden="true">Glissez pour tourner l’assiette</p>
      </div>
    </article>

    <!-- 4. La réservation -->
    <article class="demo demo--inverse">
      <div class="demo__texte">
        <h3 class="titre-3">Réserver en trois gestes</h3>
        <p>Le jour, l’heure, le nombre de couverts : la table est réservée sans appel pendant le service. Nous branchons l’outil que vous utilisez déjà, Zenchef, foratable ou TheFork, ou nous vous aidons à en choisir un.</p>
        <p class="demo__ou">Branchement de la réservation inclus dans les offres Signature et Maison.</p>
      </div>
      <div class="demo__live vitrine vitrine--leonie resa" data-resa>
        <div class="vitrine__tete"><span class="vitrine__nom">Chez Léonie</span><span>Réserver une table</span></div>
        <div class="resa__ligne" role="group" aria-label="Jour">
          <button type="button" data-jour aria-pressed="true">Ven.</button>
          <button type="button" data-jour aria-pressed="false">Sam.</button>
          <button type="button" data-jour aria-pressed="false">Dim.</button>
        </div>
        <div class="resa__ligne" role="group" aria-label="Heure">
          <button type="button" data-heure aria-pressed="false">19:00</button>
          <button type="button" data-heure aria-pressed="true">19:30</button>
          <button type="button" data-heure aria-pressed="false">20:30</button>
        </div>
        <div class="resa__couverts">
          <button type="button" data-moins aria-label="Une personne de moins">−</button>
          <output data-couverts>2</output>
          <button type="button" data-plus aria-label="Une personne de plus">+</button>
          <span>personnes</span>
        </div>
        <button type="button" class="resa__ok" data-reserver>Réserver</button>
        <p class="resa__msg" role="status" aria-live="polite" data-resa-msg></p>
      </div>
    </article>

      </div>
</section>

<!-- ============ Vos plats en mouvement : un onglet par animation, chacune s'ouvre sur sa propre page ============ -->
<section class="bloc bloc--ardoise mouvement" id="en-mouvement">
  <div class="cadre">
    <div class="mouvement__tete">
      <h2 class="titre-2">Vos plats, en mouvement</h2>
      <p>Des animations qui avancent au rythme du doigt, en plein écran. Choisissez un exemple, puis ouvrez-le.</p>
    </div>
    <div class="onglets onglets--sombre" role="tablist" aria-label="Choisir une animation" data-onglets>
      {ANIMATIONS.map((a, i) => (
        <button type="button" role="tab" id={`onglet-${a.id}`} aria-controls={`anim-${a.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}><b>{a.onglet}</b><span>{a.sous}</span></button>
      ))}
    </div>
    {ANIMATIONS.map((a) => (
      <div class="anim" id={`anim-${a.id}`} role="tabpanel" aria-labelledby={`onglet-${a.id}`}>
        <a class="anim__apercu" href={`/animations/${a.id}/`} target="_blank" rel="noopener">
          <img src={a.apercu} alt="" width="1600" height="900" loading="lazy" decoding="async" />
          <span class="anim__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
        </a>
        <div class="anim__texte">
          <h3>{a.titre}</h3>
          <p>{a.resume}</p>
          <a class="btn btn--jaune" href={`/animations/${a.id}/`} target="_blank" rel="noopener">Lancer l’animation</a>
          <p class="anim__note">S’ouvre en plein écran dans un nouvel onglet. Faites défiler pour la faire avancer.</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ============ Avant / après ============ -->
<section class="bloc bloc--ardoise">
  <div class="cadre">
    <header class="bloc__tete">
      <h2 class="titre-2">Le même restaurant, avant et après</h2>
      <p>Faites glisser le curseur. À gauche, un site comme on en voit encore beaucoup. À droite, Chez Léonie tel que nous le ferions.</p>
    </header>
    <div class="compare" data-compare style="--p:30%">
      <div class="compare__avant" aria-hidden="true">
        <div class="vieux__barre">Accueil | Menu (PDF) | Contact | Plan d’accès</div>
        <p class="vieux__titre">Bienvenue sur le site du Restaurant</p>
        <p>Notre restaurant vous accueille dans un cadre agréable. Cuisine traditionnelle, ambiance familiale.</p>
        <p>Ouvert du lundi au samedi. Fermé le dimanche.</p>
        <p class="vieux__lien">Télécharger notre menu (PDF, 4.2 Mo)</p>
        <p class="vieux__pied">© 2014 – Tous droits réservés</p>
      </div>
      <div class="compare__apres" aria-hidden="true">
        <p class="apres__genre">Bistrot de quartier, Carouge</p>
        <p class="apres__nom">Chez Léonie</p>
        <p class="apres__jour">Plat du jour : <span data-ardoise-nom>Filets de perche meunière</span>, CHF <span data-ardoise-prix>36</span></p>
        <p class="apres__btns"><span>Réserver une table</span><span>Voir la carte</span></p>
        <p class="apres__h">Service de midi jusqu’à 14 h</p>
        <img class="apres__photo" src={salle.src} alt="" width="1200" height="800" loading="lazy" decoding="async" />
      </div>
      <input class="compare__curseur" type="range" min="0" max="100" value="30" aria-label="Comparer avant et après">
      <span class="compare__poignee" aria-hidden="true"></span>
    </div>
  </div>
</section>

<!-- ============ Offres ============ -->
<section class="bloc" id="offres">
  <div class="cadre">
    <header class="bloc__tete">
      <h2 class="titre-2">Nos offres, des prix affichés</h2>
      <p>Un prix fixe, annoncé avant de commencer. Pas d’options à cocher, pas de surprise sur la facture.</p>
    </header>
    <div class="onglets" role="tablist" aria-label="Choisir le type d’offre" data-onglets>
      <button type="button" role="tab" id="onglet-site" aria-controls="offres-site" aria-selected="true"><b>Créer votre site</b><span>3 offres, dès CHF 999</span></button>
      <button type="button" role="tab" id="onglet-reseaux" data-ancres="#reseaux #exemple-sora" aria-controls="offres-reseaux" aria-selected="false" tabindex="-1"><b>Vidéo et réseaux sociaux</b><span>Dès CHF 490 par mois</span></button>
    </div>
    <div class="offres__panneau" id="offres-site" role="tabpanel" aria-labelledby="onglet-site">
    <p class="demo__ou offres__note">Nous réalisons la carte des plats et des boissons sans alcool. La carte des vins et des alcools n’entre pas dans nos prestations : elle se découvre sur place.</p>
    <div class="offres">
      <article class="offre">
        <h3>Essentiel</h3>
        <p class="offre__prix">CHF 999</p>
        <p class="offre__pour">Pour être trouvé et joignable, vite.</p>
        <ul>
          <li>Une page sur mesure, pensée pour le téléphone</li>
          <li>Votre carte en ligne, lisible et à jour</li>
          <li>Horaires, plan, appel en un geste</li>
          <li>Fiche Google mise à jour</li>
        </ul>
        <p class="offre__suivi">Vous êtes autonome après la livraison.</p>
        <a class="btn btn--clair" href="#contact" data-offre="Essentiel">Choisir Essentiel</a>
      </article>
      <article class="offre offre--phare">
        <h3>Signature</h3>
        <p class="offre__prix">CHF 1’999</p>
        <p class="offre__pour">Pour donner faim avant même d’entrer.</p>
        <ul>
          <li>Tout l’Essentiel</li>
          <li>Votre plat signature animé au défilement</li>
          <li>Carte redessinée : web, imprimable, QR codes</li>
          <li>Ardoise du jour modifiable par vous</li>
          <li>Réservation branchée sur votre outil</li>
        </ul>
        <p class="offre__suivi">Entretien en option, CHF 89 par mois : carte et horaires mis à jour sous 48 heures.</p>
        <a class="btn btn--jaune" href="#contact" data-offre="Signature">Choisir Signature</a>
      </article>
      <article class="offre">
        <h3>Maison</h3>
        <p class="offre__prix">CHF 3’490 <small>puis CHF 790 par mois</small></p>
        <p class="offre__pour">Pour que vos plats se vendent tout seuls.</p>
        <ul>
          <li>Tout le Signature, entretien compris</li>
          <li>Un photographe chez vous, toute la carte</li>
          <li>Vos plats en 3D et en réalité augmentée</li>
          <li>Photos, vidéos et réseaux chaque mois</li>
          <li>Carte en deux langues</li>
        </ul>
        <p class="offre__suivi">Suivi complet, pour un petit nombre de restaurants.</p>
        <a class="btn btn--clair" href="#contact" data-offre="Maison">Choisir Maison</a>
      </article>
    </div>
    </div>
    <div class="offres__panneau" id="offres-reseaux" role="tabpanel" aria-labelledby="onglet-reseaux">
    <div class="reseaux">
      <figure class="reseaux__exemple">
        <button type="button" class="reseaux__lecture" data-ouvrir-video aria-label="Regarder la vidéo d’exemple, avec le son">
          <video src="/media/exemple-sora.mp4" poster="/media/exemple-sora.jpg" muted loop playsinline preload="none" width="432" height="768" data-video-exemple aria-hidden="true"></video>
          <span class="reseaux__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
        </button>
        <figcaption><b>Exemple : Sora, comptoir à ramen</b> On filme la salle et le plat du jour, puis la même vidéo part sur le site et en réel sur Instagram, aux couleurs du restaurant. <a class="reseaux__voir" href="/media/exemple-sora-hd.mp4" data-ouvrir-video>Regarder la vidéo</a></figcaption>
      </figure>
      <dialog class="visionneuse" data-visionneuse aria-label="Vidéo d’exemple : Sora, comptoir à ramen">
        <video controls playsinline preload="none" poster="/media/exemple-sora.jpg" width="720" height="1280" data-video-grande></video>
        <form method="dialog"><button class="visionneuse__fermer" aria-label="Fermer la vidéo">×</button></form>
      </dialog>
      <div class="offres">
        <article class="offre">
          <h3>Essentiel</h3>
          <p class="offre__prix">CHF 490 <small>par mois</small></p>
          <p class="offre__pour">Pour être vu chaque semaine, sans y penser.</p>
          <ul>
            <li>Une heure de tournage chez vous chaque mois</li>
            <li>4 réels montés et publiés par mois</li>
            <li>Votre menu du jour publié chaque matin</li>
          </ul>
          <p class="offre__suivi">Trois mois minimum, puis sans engagement.</p>
          <a class="btn btn--clair" href="#contact" data-offre="Réseaux Essentiel">Choisir Essentiel</a>
        </article>
        <article class="offre offre--phare">
          <h3>Premium</h3>
          <p class="offre__prix">CHF 990 <small>par mois</small></p>
          <p class="offre__pour">Pour remplir la salle, avec la publicité.</p>
          <ul>
            <li>Deux heures de tournage chaque mois</li>
            <li>4 réels et 8 publications par mois</li>
            <li>Toute votre carte en photo</li>
            <li>Votre menu du jour publié chaque matin</li>
            <li>Publicité Facebook et Instagram gérée</li>
          </ul>
          <p class="offre__suivi">Trois mois minimum, puis sans engagement.</p>
          <a class="btn btn--jaune" href="#contact" data-offre="Réseaux Premium">Choisir Premium</a>
        </article>
        <article class="offre">
          <h3>Pack lancement</h3>
          <p class="offre__prix">CHF 990 <small>une seule fois</small></p>
          <p class="offre__pour">Sans abonnement : un tournage, et c’est parti.</p>
          <ul>
            <li>Deux heures de tournage au restaurant</li>
            <li>4 réels montés, prêts à publier</li>
            <li>Photos de vos plats, sans limite pendant le tournage</li>
          </ul>
          <p class="offre__suivi">Les images sont à vous.</p>
          <a class="btn btn--clair" href="#contact" data-offre="Pack lancement">Choisir le pack</a>
        </article>
      </div>
    </div>
    <details class="pub">
      <summary>Et le budget de la publicité ?</summary>
      <p>Dans l’offre Premium, nous gérons votre publicité. Le budget, vous le payez directement à Facebook (Meta), avec votre carte, dans votre propre compte : vous gardez la main et vous ne payez aucune commission dessus. On vous conseille de commencer avec 10 à 15 francs par jour. Nous créons les campagnes, ciblons les gens autour du restaurant à l’heure des repas, et vous envoyons un bilan clair chaque mois.</p>
    </details>
    </div>
  </div>
</section>

<!-- ============ Méthode ============ -->
<section class="bloc bloc--nappe" id="methode">
  <div class="cadre">
    <header class="bloc__tete">
      <h2 class="titre-2">En ligne en deux semaines</h2>
    </header>
    <ol class="etapes" data-etapes>
      <li><h3>Un café chez vous</h3><p>Vingt minutes au restaurant, hors service. On choisit l’offre et les options, vous recevez un devis clair.</p></li>
      <li><h3>Une première version en cinq jours</h3><p>Vous voyez votre site sur votre téléphone, avec votre carte. Puis deux allers-retours de corrections.</p></li>
      <li><h3>Mise en ligne, et on reste là</h3><p>Nom de domaine, réservation branchée, fiche Google à jour. Vous savez comment demander une modification.</p></li>
    </ol>
  </div>
</section>

<!-- ============ Contact ============ -->
<section class="bloc bloc--ardoise" id="contact">
  <div class="cadre contact">
    <div>
      <h2 class="titre-2">Parlons de votre restaurant</h2>
      <p>Réponse sous 24 heures avec un devis clair. Le premier rendez-vous est offert, chez vous.</p>
      {(SITE.telephone || SITE.whatsapp) && (
        <div class="actions contact__direct">
          {SITE.telephone && <a class="btn btn--clair" href={'tel:' + SITE.telephone.replace(/[^+\d]/g, '')}>Appeler le {SITE.telephone}</a>}
          {SITE.whatsapp && <a class="btn btn--jaune" href={'https://wa.me/' + SITE.whatsapp.replace(/\D/g, '')} target="_blank" rel="noopener">Écrire sur WhatsApp</a>}
        </div>
      )}
    </div>
    <form class="formulaire" data-contact>
      <label>Votre nom<input name="nom" autocomplete="name" required></label>
      <label>Restaurant<input name="resto" autocomplete="organization" required></label>
      <label>Téléphone<input name="tel" type="tel" autocomplete="tel"></label>
      <label>Email<input name="email" type="email" autocomplete="email" required></label>
      <label class="formulaire__large">Offre qui vous intéresse
        <select name="offre" data-offre-choix>
          <option value="">Je ne sais pas encore</option>
          <option>Essentiel</option>
          <option>Signature</option>
          <option>Maison</option>
          <option>Réseaux Essentiel</option>
          <option>Réseaux Premium</option>
          <option>Pack lancement</option>
        </select>
      </label>
      <label class="formulaire__large">Votre projet<textarea name="msg" rows="3"></textarea></label>
      <button class="btn btn--jaune" type="submit">Envoyer ma demande</button>
      <p class="formulaire__msg" role="status" aria-live="polite" data-contact-msg></p>
      <p class="formulaire__note">Vos coordonnées servent uniquement à vous répondre. <a href="/confidentialite/">Confidentialité et cookies</a></p>
    </form>
  </div>
</section>

