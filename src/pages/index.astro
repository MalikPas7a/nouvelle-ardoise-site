.m-fid { background: #1a2233; }
.m-fid .c { width: 62%; aspect-ratio: 1.6; border-radius: 14px; background: var(--iz-or); padding: 18px; display: grid; align-content: space-between; color: var(--iz-creme); box-shadow: 0 30px 40px -20px rgb(0 0 0 / .8); transform: rotate(4deg); }
.m-fid .c b { font-size: 18px; letter-spacing: .1em; }
.m-fid .tampons span { border-color: var(--iz-creme); }
