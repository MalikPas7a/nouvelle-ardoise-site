</style>

<script is:inline>
// La carte et les voyants s'allument quand on arrive dessus (état final direct si mouvement réduit ou sans observateur)
(function () {
  const els = document.querySelectorAll('.carte, .voyants');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('allume')); return; }
  const io = new IntersectionObserver((entrees) => entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('allume'); io.unobserve(e.target); } }), { threshold: .35 });
  els.forEach((e) => io.observe(e));
})();
</script>
