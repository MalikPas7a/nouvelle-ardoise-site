---
// Accueil : le film « La mise en place » lu au scroll, puis les pièces, les portes vers chaque page, la preuve et l'appel.
import Base from '../layouts/Base.astro';
import Appel from '../components/Appel.astro';
import { getImage } from 'astro:assets';
import imgRagu from '../assets/photo-ragu.jpg';
import imgComptoir from '../assets/photo-comptoir.jpg';
import { SITE } from '../config.js';

// photo-comptoir.jpg sur la porte « Offres et prix » : la photo de la salle montrait des verres et des carafes (règle : ni verre ni bouteille)
const [ragu, comptoir] = await Promise.all([imgRagu, imgComptoir].map((src) => getImage({ src, format: 'webp', width: 900, quality: 72 })));

// Données lues par Google pour comprendre qui est Nouvelle Ardoise
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nom,
  url: SITE.url,
  email: SITE.email,
  telephone: '+41 78 213 38 68',
  sameAs: ['https://www.instagram.com/' + SITE.instagram + '/'],
  image: SITE.url + '/partage.jpg',
  founder: { '@type': 'Person', name: SITE.responsable },
  address: { '@type': 'PostalAddress', streetAddress: SITE.adresse, postalCode: SITE.localite.split(' ')[0], addressLocality: 'Genève', addressCountry: 'CH' },
  areaServed: ['Genève', 'Vaud'],
  knowsAbout: ['Stratégie marketing pour restaurants', 'Acquisition et fidélisation de clients', 'Création de sites web pour restaurants', 'Gestion des réseaux sociaux', 'Réels Instagram', 'Shooting photo culinaire', 'Publicité Facebook, Instagram et Google'],
  description: 'Agence de marketing et de communication pour la restauration et les métiers de bouche : stratégie, acquisition de clients, réseaux sociaux, vidéo, sites web et fidélisation.',
  priceRange: 'CHF 999 – 3490',
});
---
<Base page="accueil" title="Nouvelle Ardoise | Marketing et communication pour la restauration à Genève" description="Votre cuisine est belle. Montrons-la. Site, photos et vidéos, réseaux sociaux, publicité et design pour les restaurants, cafés, boulangeries et chocolatiers de Genève et Vaud. Prix affichés, −20 % jusqu’au 31 octobre 2026.">
<script slot="head" type="application/ld+json" is:inline set:html={jsonLd}></script>
<!-- Les anciens liens (nouvelleardoise.ch/#offres, envoyés dans les emails) mènent à la bonne page -->
<script slot="head" is:inline>
  (function () {
    var vers = { '#offres': '/offres/', '#reseaux': '/offres/#reseaux', '#exemple-sora': '/offres/#exemple-sora', '#methode': '/offres/#methode', '#contact': '/contact/', '#exemples': '/restaurants/#exemples', '#essayer': '/restaurants/#essayer', '#en-mouvement': '/realisations/#en-mouvement' };
    if (vers[location.hash]) location.replace(vers[location.hash]);
  })();
</script>
<!-- L'affiche du film (l'ardoise vide) part avec la page : c'est elle que l'on voit en premier -->
<link slot="head" rel="preload" as="image" href="/sequences/mise-en-place-v1/m/001.webp" fetchpriority="high" />
<!-- phase 2 : deux preload avec media="(max-width: 899px)" pour m et media="(min-width: 900px)" pour g/001.webp -->

<!-- ============ Le film « La mise en place » : la craie écrit, le passe, tout s'élève, le site, les images, l'éponge, « Envoyez. » ============ -->
<section class="film" data-film="mise-en-place-v1" data-images="264" data-tailles="m" data-source-m="720,1280" data-source-g="1920,1080"
         data-jalons="0,0.213,0.361,0.483,0.650,0.772,0.871,1" aria-labelledby="titre-accueil" aria-describedby="film-description">
  <!-- le lien « Passer le film » (#pieces) est dans Base.astro, juste après « Aller au contenu » : au deuxième Tab, avant la nav -->
  <!-- jalons du défilement au doigt : une image stable par arrêt (1, 57, 96, 128, 172, 204, 230, 264) -->
  <div class="film__jalons" aria-hidden="true"><i style="--p:0"></i><i style="--p:0.213"></i><i style="--p:0.361"></i><i style="--p:0.483"></i><i style="--p:0.650"></i><i style="--p:0.772"></i><i style="--p:0.871"></i><i style="--p:1"></i></div>
  <div class="film__colle">
    <canvas class="film__halo" width="36" height="64" aria-hidden="true"></canvas>
    <div class="film__scene">
      <picture>
        <!-- sans JavaScript ou mouvement réduit : la phrase écrite ; sinon l'ardoise vide, que la toile recouvre sans saut -->
        <source media="(prefers-reduced-motion: reduce), (scripting: none)" srcset="/sequences/mise-en-place-v1/m/057.webp">
        <img class="film__affiche" src="/sequences/mise-en-place-v1/m/001.webp" width="720" height="1280" fetchpriority="high" decoding="async"
             alt="Une ardoise sur chevalet dans une cuisine sombre, devant un comptoir en noyer, des croissants et un gâteau aux fraises sur une planche. À la craie : « Votre cuisine est belle. Montrons-la. »">
      </picture>
      <canvas class="film__toile" aria-hidden="true"></canvas>
      <!-- les objets du film deviennent des liens (coordonnées en fractions de l'image 9:16, interpolées entre les clés p) -->
      <a class="film__zone" href="/restaurants/" data-de="0.61" data-a="0.71" data-f="0.015" data-etiquette="Voir le site"
         data-zone-m="0.61:0.40,0.26,0.40,0.50;0.65:0.26,0.22,0.48,0.55;0.71:0.26,0.22,0.48,0.55" aria-label="Le téléphone : essayer un site de restaurant"></a>
      <a class="film__zone" href="/realisations/" data-de="0.70" data-a="0.80" data-f="0.015" data-etiquette="Voir les shootings"
         data-zone-m="0.70:0.20,0.30,0.55,0.25;0.772:0.12,0.27,0.62,0.30;0.80:0.12,0.27,0.62,0.30" aria-label="L’appareil photo : voir nos shootings"></a>
      <a class="film__zone film__zone--repos" href="/restaurants/" data-de="0.875" data-a="9" data-f="0.02" data-etiquette="Voir le site"
         data-zone-m="0.875:0.41,0.63,0.17,0.18" aria-label="Le téléphone posé sur le passe : essayer un site"></a>
      <a class="film__zone film__zone--repos" href="/realisations/" data-de="0.875" data-a="9" data-f="0.02" data-etiquette="Voir les shootings"
         data-zone-m="0.875:0.66,0.74,0.30,0.13" aria-label="L’appareil photo posé sur le passe : voir nos shootings"></a>
      <div class="film__voile" aria-hidden="true"></div>
    </div>
    <div class="film__flash" aria-hidden="true"></div>
    <p class="sr-only" id="film-description">Film de présentation : la craie écrit « Votre cuisine est belle. Montrons-la. » sur l’ardoise. La caméra descend vers le passe ; croissants, gâteau et fruits s’élèvent et flottent. Un téléphone descend et s’allume sur le site d’un restaurant. Un appareil photo arrive, se tourne vers nous et déclenche son flash. L’éponge efface la phrase, la craie écrit « Envoyez. », tout se repose sur le passe.</p>

    <div class="cadre film__textes">
      <!-- Poste 0 · l'ardoise (images 1-61) : rien ne bouge pendant que la craie écrit (6-54) ni au jalon 57 ; le sur-titre et l'indice sortent pendant la descente de la caméra (61 → 67), avec la phrase -->
      <p class="film__sur" data-de="-1" data-a="0.25" data-f="0.02" data-toujours>Restaurants, cafés, boulangeries, chocolatiers · Genève et Vaud</p>
      <p class="film__indice" data-de="-1" data-a="0.25" data-f="0.02" aria-hidden="true"><span></span>Faites défiler</p>

      <!-- Poste 1 · le relais (jalon 96) : la craie est floue derrière, la typo reprend la phrase, nette -->
      <h1 class="film__titre" id="titre-accueil" data-de="0.32" data-a="0.44" data-f="0.03" data-encre="ardoise" data-toujours>Votre cuisine est belle. <em>Montrons-la.</em></h1>

      <!-- Poste 2 · la mise en place (jalon 128) -->
      <div class="film__texte" data-de="0.445" data-a="0.57" data-f="0.03" data-encre="ardoise">
        <p class="film__kicker">la mise en place</p>
        <h2>Alors on fait la mise en place.</h2>
        <p>Site, photos et vidéos, réseaux, publicité, design : chaque pièce à sa place, dans l’ordre du service. Vous restez en cuisine.</p>
        <a class="lien" href="/offres/">Voir les offres et les prix</a>
      </div>

      <!-- Poste 3 · le téléphone (jalon 172) : n'entre qu'une fois l'écran allumé (166) -->
      <div class="film__texte film__texte--court" data-de="0.615" data-a="0.715" data-f="0.02" data-encre="ardoise">
        <p class="film__kicker">le site</p>
        <h2>Votre carte, dans leur poche.</h2>
        <p class="film__prix">Sites dès CHF 799 pendant le lancement.</p>
        <p class="film__desc">Rapide, pensé pour le téléphone : la carte, les horaires, la réservation en un geste. En ligne en deux semaines.</p>
        <div class="actions"><a class="btn btn--jaune" href="/restaurants/">Essayer un exemple</a><a class="lien film__desc" href="/offres/#reseaux">Voir l’abonnement réseaux</a></div>
      </div>

      <!-- Poste 4 · l'appareil photo (jalon 204) : révélé par le flash, effacé par l'éponge (pas de fondu de sortie) -->
      <div class="film__texte" data-de="0.735" data-a="0.8707" data-f="0.02" data-encre="ardoise" data-efface>
        <p class="film__kicker">les photos et les vidéos</p>
        <h2>On vient chez vous, pendant la mise en place.</h2>
        <p>Vos plats et vos gestes, photographiés et filmés à la lumière de votre cuisine. Ce sont ces images qui donnent envie.</p>
        <a class="lien" href="/realisations/">Voir nos réalisations</a>
      </div>

      <!-- Le cliché : la photo que le flash vient de prendre, épinglée -->
      <a class="film__cliche" href="/realisations/" data-de="0.75" data-a="0.85" data-f="0.02">
        <img src="/sequences/mise-en-place-v1/m/096.webp" width="720" height="1280" alt="" loading="lazy" decoding="async">
        <span>Prise sur place. Comme chez vous.</span>
      </a>

      <!-- Poste 5 · l'éponge et « Envoyez. » (216-258) : écran nu, la craie parle seule -->

      <!-- Poste 6 · le service (jalon 264) -->
      <div class="film__fin" data-de="0.975" data-a="9" data-f="0.02" data-encre="craie">
        <h2>Vous cuisinez, <em>on remplit la salle.</em></h2>
        <p class="film__desc">Devis clair sous 24 heures. Premier rendez-vous offert, chez vous.</p>
        <div class="actions"><a class="btn btn--jaune" href="/contact/">Demander un devis</a><a class="lien" href="https://wa.me/41782133868">WhatsApp · 078 213 38 68</a></div>
        <p class="film__offre"><span class="offre__remise">−20 %</span> sur toutes les offres jusqu’au 31 octobre 2026</p>
      </div>

      <!-- le bon : où en est-on (ticket de commande) -->
      <ol class="film__bon" aria-hidden="true"><li data-s="0">L’ardoise</li><li data-s="0.32">Montrons-la.</li><li data-s="0.445">La mise en place</li><li data-s="0.615">Le site</li><li data-s="0.735">Les images</li><li data-s="0.8175">Envoyez.</li><li data-s="0.975">La salle</li></ol>
    </div>
  </div>
</section>

<!-- ============ La mise en place, pièce par pièce ============ -->
<section class="bloc pieces-bloc" id="pieces" aria-labelledby="titre-pieces">
  <div class="cadre">
    <header class="bloc__tete"><h2 class="titre-2" id="titre-pieces">La mise en place, pièce par pièce</h2><p>Dans l’ordre du service. Une pièce ou toute la mise en place ; les prix sont affichés.</p></header>
    <ul class="pieces" data-revele>
      <li><p class="pieces__mot">le site</p><h3>Site web</h3><p>Votre carte, dans la poche de vos clients. Rapide, pensé pour le téléphone : la carte, les horaires, la réservation ou la commande en un geste. En ligne en deux semaines, dès CHF 799 pendant le lancement.</p><a class="lien" href="/restaurants/">Essayer trois exemples</a></li>
      <li><p class="pieces__mot">les images</p><h3>Photos et vidéos</h3><p>On vient chez vous, pendant la mise en place. Vos plats, vos gestes, votre équipe, à la lumière de votre cuisine. Les photos et les vidéos vous appartiennent.</p><a class="lien" href="/realisations/">Voir nos réalisations</a></li>
      <li><p class="pieces__mot">envoyez.</p><h3>Réseaux sociaux</h3><p>Chaque semaine, on envoie : quatre réels par mois, le menu du jour chaque matin sur Instagram et Facebook, et l’entretien du site. Dès CHF 392 par mois pendant le lancement.</p><a class="lien" href="/offres/#reseaux">Voir l’abonnement</a></li>
      <li><p class="pieces__mot">la salle</p><h3>Faire venir, faire revenir</h3><p>Publicité ciblée autour du restaurant, avis Google suivis, fidélité, et un bilan clair chaque mois : on sait ce qui ramène du monde.</p><a class="lien" href="/contact/">En parler autour d’un café</a></li>
      <li><p class="pieces__mot">la carte</p><h3>Design</h3><p>Carte, logo, ardoise, supports en salle, emballages : une image cohérente, de la vitrine à l’addition.</p><a class="lien" href="/offres/#design">Voir les offres</a></li>
    </ul>
  </div>
</section>

<!-- ============ Les portes : une page par sujet ============ -->
<section class="bloc portes-bloc">
  <div class="cadre">
    <header class="bloc__tete">
      <h2 class="titre-2">Par où commencer ?</h2>
    </header>
    <div class="portes" data-revele>
      <a class="porte" href="/restaurants/">
        <img src={ragu.src} alt="" width="900" height="563" loading="lazy" decoding="async" />
        <div><h3>Restaurants</h3><p>Essayez trois sites de restaurants, la carte, le plat du jour, le plat en 3D et la réservation.</p><span>Essayer</span></div>
      </a>
      <a class="porte" href="/artisans/">
        <img src="/artisans/tarte-framboise.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" />
        <div><h3>Artisans</h3><p>Chocolatiers, pâtissiers, boulangers : vos créations en grand, vos gestes en vidéo.</p><span>Découvrir</span></div>
      </a>
      <a class="porte" href="/realisations/">
        <img src="/sequences/pastamo/g/019.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" />
        <div><h3>Réalisations</h3><p>Pasta Mo’, nos animations au défilement et une vidéo pour les réseaux.</p><span>Voir</span></div>
      </a>
      <a class="porte porte--ardoise" href="/offres/">
        <!-- la photo du comptoir : la photo de la salle montrait des verres et des carafes (phase 2 : l'image 57 du rendu 16:9 recadrée 16/10) -->
        <img src={comptoir.src} alt="" width="900" height="563" loading="lazy" decoding="async" />
        <div><h3>Offres et prix</h3><p>Des prix affichés, sites dès CHF 799 et réseaux dès CHF 392 par mois pendant l’offre de lancement.</p><span>Voir les offres</span></div>
      </a>
    </div>
  </div>
</section>

<!-- ============ Preuve : on tient aussi une cuisine ============ -->
<section class="bloc bloc--nappe preuve"><div class="cadre preuve__in"><p class="pieces__mot">déjà en salle</p><p class="titre-3">Nous tenons aussi une cuisine. Pasta Mo’, street food italienne à Genève : notre propre site, notre propre service du midi.</p><a class="lien" href="/realisations/">Voir Pasta Mo’</a></div></section>

<Appel titre="Un café chez vous, hors service ?" texte="Vingt minutes pour comprendre votre cuisine, un devis clair sous 24 heures. −20 % sur toutes les offres jusqu’au 31 octobre 2026." whatsapp />

<script>
  import '../scripts/defilement.js';
  import '../scripts/film.js';
  import '../scripts/motion.js';
</script>
</Base>

<style>
  /* Les pièces sont stylées dans global.css (bloc « Accueil : le film ») ; ici, seulement le repos quand le mouvement est réduit */
  @media (prefers-reduced-motion: reduce) { .pieces li, .pieces li:hover { transition: none; transform: none; } }
</style>
