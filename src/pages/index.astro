.panneau { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; padding-top: 28px; align-items: end; }
.panneau__media { grid-column: 1 / span 8; aspect-ratio: 16 / 9; overflow: hidden; background: var(--encre); min-width: 0; position: relative; }
.panneau__media img, .panneau__media video { width: 100%; height: 100%; object-fit: cover; animation: apparait .6s ease both; }
.panneau__media.vertical video { object-fit: contain; background: var(--encre); }
@keyframes apparait { from { opacity: .3; transform: scale(1.03); } to { opacity: 1; transform: none; } }
.panneau__texte { grid-column: 9 / span 4; min-width: 0; }
.panneau__texte h3 { font-size: clamp(26px, 2.6vw, 36px); letter-spacing: -.035em; line-height: 1.02; margin: 10px 0 12px; }
.panneau__texte p { color: var(--gris); margin: 0 0 14px; }

/* Cas Pasta Mo' */
.pm { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; align-items: start; }
.pm__film { grid-column: 1 / span 6; margin: 0; position: sticky; top: 90px; min-width: 0; }
.pm__film img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #1d1a17; }
.pm__film figcaption { margin-top: 10px; }
.pm__canaux { grid-column: 8 / span 5; display: grid; min-width: 0; border-top: 1px solid var(--encre); }
.canal { padding-block: 20px; border-bottom: 1px solid var(--filet); }
.canal h3 { font-size: 22px; letter-spacing: -.02em; margin: 8px 0 6px; }
.canal p { margin: 0; color: var(--gris); }
.canal .chiffre { font-weight: 800; color: var(--encre); font-variant-numeric: tabular-nums; }

/* Canaux */
.canaux { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--encre); border-left: 1px solid var(--filet); }
.canaux article { border-right: 1px solid var(--filet); border-bottom: 1px solid var(--filet); padding: 24px 22px; display: grid; gap: 10px; align-content: start; min-width: 0; transition: background .2s; }
.canaux article:hover { background: var(--blanc); }
.canaux h3 { margin: 0; font-size: clamp(22px, 2.2vw, 30px); letter-spacing: -.03em; line-height: 1.05; }
.canaux p { margin: 0; color: var(--gris); }
.canaux .mesure { font-family: var(--mono); font-size: 12px; color: var(--encre); border-top: 1px dashed var(--filet); padding-top: 10px; margin-top: 6px; }
.canaux .mesure b { background: var(--craie-clair); font-weight: 500; padding: 1px 5px; }
.canaux article.large { grid-column: 1 / -1; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 40px; align-items: center; }
.canaux article.large figure { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
.canaux article.large img { width: 100%; height: 100%; object-fit: cover; display: block; }
.canaux article.large > div { display: grid; gap: 10px; max-width: 62ch; }
@media (max-width: 560px) { .canaux article.large { grid-template-columns: minmax(0, 110px) minmax(0, 1fr); gap: 16px; } }
@media (max-width: 900px) { .canaux { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .canaux { grid-template-columns: 1fr; } }


/* Identité Izgara : défilement horizontal de mises en situation (épinglé sur ordinateur, au doigt sur téléphone) */
