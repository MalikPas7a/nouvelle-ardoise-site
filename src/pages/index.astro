.flottant main a, .flottant main button { scroll-margin-block: 110px; }
.g { padding-left: var(--gout); padding-right: var(--goutd); }
.etiq { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
