---
import AccueilV4 from '../components/AccueilV4.astro';
import styles from '../styles/accueil-v4.css?raw';
import { SITE } from '../config.js';
import { catalogueOffres } from '../data/offres.js';
const title = 'Agence marketing restaurants Genève | Nouvelle Ardoise';
const description = 'Marketing et communication pour restaurants et artisans de bouche à Genève et Vaud : sites web, menus, réseaux sociaux, photos, vidéos et fidélisation.';
const canonical = SITE.url + '/';
const image = SITE.url + '/partage.jpg';
const jsonLd = JSON.stringify({
  '@context':'https://schema.org', '@type':'ProfessionalService', '@id':SITE.url+'/#agence',
  name:SITE.nom, url:canonical, description, email:SITE.email, image,
  founder:{'@type':'Person',name:SITE.responsable},
  address:{'@type':'PostalAddress',streetAddress:SITE.adresse,postalCode:SITE.localite.split(' ')[0],addressLocality:'Genève',addressCountry:'CH'},
  areaServed:[{'@type':'AdministrativeArea',name:'Genève'},{'@type':'AdministrativeArea',name:'Vaud'}],
  sameAs:['https://www.instagram.com/'+SITE.instagram+'/'],
  hasOfferCatalog:catalogueOffres(SITE.url),
});
---
<!doctype html>
<html lang="fr-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#14201e" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.nom} />
  <meta property="og:locale" content="fr_CH" />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nouvelle Ardoise, marketing et communication pour restaurants et artisans" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/v4/assets/ab735c6ecc7ed2ab14715cc44e83abe51639a7dc1eb160758e5f35e17b6b18cb.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/v4/assets/ca2a54b8fc222595fad59f7e87a9a6af25fb7248462c7e87253c9c2ddc984477.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={styles}></style>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
</head>
<body data-version="motion-v4-mobile-20261014">
  <AccueilV4 />
  <script is:inline defer src="/v4/ui.82319e759d0b.js"></script>
  <script is:inline defer src="/v4/scene.26e523fcb23a.js"></script>
</body>
</html>
