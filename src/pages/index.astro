.pan__mot { margin: 0; font-family: var(--affiche); font-style: italic; font-weight: 400; font-size: clamp(92px, 25vw, 300px); line-height: .82; letter-spacing: -.04em; color: var(--mot); white-space: nowrap; }
.pan__txt { margin: 0; font-family: var(--affiche); font-weight: 400; font-size: clamp(30px, 8.4vw, 54px); line-height: 1.04; letter-spacing: -.015em; max-width: 19ch; text-wrap: balance; }
.pan__fig { margin: 10px 0 0; width: 100%; max-width: 440px; }
.compteur { position: absolute; z-index: 5; left: 50%; translate: -50% 0; top: calc(env(safe-area-inset-top, 0px) + 21px); display: flex; align-items: center; gap: 10px; padding: 7px 12px; border-radius: 999px; background: var(--ardoise); color: var(--papier); font-family: var(--mono); font-size: 12px; }
