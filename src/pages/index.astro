.prix p { color: var(--gris); margin: 12px 0 0; max-width: 32ch; font-size: 15px; }
.prix .remise { display: inline-block; margin-top: 10px; font-family: var(--mono); font-size: 11px; background: var(--craie); padding: 3px 7px; }

/* Contact */
.contact { padding-block: clamp(72px, 11vw, 160px); border-top: 1px solid var(--filet); }
