---
// « Testez votre visibilité » : le commerçant tape son nom, choisit sa fiche Google, et voit en direct
// 4 voyants (Google, site, Instagram, vente en ligne) puis ses 3 priorités. Il peut ensuite laisser son contact :
// la demande arrive dans l'appli de prospection (relance téléphonique le lendemain).
// Les routes publiques vivent dans l'appli (nouvelle-ardoise-app, /api/public/*) et n'acceptent que ce site.
const { api = 'https://nouvelle-ardoise-app.vercel.app/api/public', titre = 'h2' } = Astro.props;
const Titre = titre;
const VOYANTS = [['google', 'Google'], ['site', 'Site'], ['instagram', 'Instagram'], ['vente', 'Vente en ligne']];
---
<section class="tv" id="test" aria-labelledby="tv-titre" data-api={api}>
  <div class="tv__tete">
    <p class="tv__sur"><span class="tv__direct" aria-hidden="true"></span>En direct · 30 secondes · gratuit</p>
    <Titre class="tv__titre" id="tv-titre">Testez votre visibilité.</Titre>
  </div>

  <form class="tv__cherche" id="tv-form" autocomplete="off">
    <label class="tv__label" for="tv-q">Le nom de votre commerce, et sa ville</label>
    <div class="tv__ligne">
      <input id="tv-q" name="q" type="search" required minlength="3" maxlength="120" placeholder="Ex. Le Fournil, Carouge" enterkeyhint="search" />
      <button class="btn btn--craie" type="submit">Lancer</button>
    </div>
  </form>

  <ul class="tv__trouves" id="tv-trouves" hidden></ul>

  <div class="tv__voyants" id="tv-voyants" aria-live="polite">
    {VOYANTS.map(([id, nom]) => (
      <div class="tv-v" data-id={id} data-etat="inconnu">
        <span class="tv-v__point" aria-hidden="true"></span>
        <span class="tv-v__nom">{nom}</span>
        <b class="tv-v__valeur tv-v__vide">à tester</b>
        <span class="tv-v__detail"></span>
      </div>
    ))}
  </div>

  <p class="tv__msg" id="tv-msg" role="status"></p>

  <div class="tv__axes" id="tv-axes" hidden>
    <p class="tv__sous">Vos trois priorités</p>
    <ol id="tv-liste"></ol>
  </div>

  <form class="tv__contact" id="tv-contact" hidden>
    <p class="tv__sous">Recevoir le plan détaillé, et en parler 15 minutes</p>
    <div class="tv__champs">
      <input name="contact" placeholder="Votre prénom" maxlength="120" autocomplete="given-name" />
      <input name="joindre" required placeholder="E-mail ou téléphone" maxlength="200" autocomplete="email" />
      <input class="tv__piege" name="site_web_confirmation" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </div>
    <button class="btn btn--craie" type="submit">Recevoir mon plan</button>
    <p class="tv__note">On vous rappelle le jour ouvré suivant. Pas de newsletter, pas de revente de vos données.</p>
  </form>
</section>

<style is:global>
.tv [hidden] { display: none !important; }
.tv { --nuit: var(--encre); background: var(--nuit); color: var(--papier); border-radius: 22px; padding: clamp(20px, 3vw, 32px); display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; box-shadow: 0 30px 60px -30px rgb(27 25 21 / .45); }
.tv__sur { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--gris-nuit); margin: 0; }
.tv__direct { width: 8px; height: 8px; border-radius: 50%; background: var(--craie); box-shadow: 0 0 0 0 rgb(255 210 63 / .6); animation: tv-pouls 2.4s ease-out infinite; }
@keyframes tv-pouls { 70% { box-shadow: 0 0 0 9px rgb(255 210 63 / 0); } 100% { box-shadow: 0 0 0 0 rgb(255 210 63 / 0); } }
.tv__titre { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 3.6vw, 48px); line-height: 1; letter-spacing: -.02em; margin: 8px 0 0; }
.tv__label { display: block; font-size: 14px; color: var(--gris-nuit); margin-bottom: 8px; }
.tv__ligne { display: flex; gap: 8px; }
.tv input { flex: 1; min-width: 0; min-height: 52px; padding: 0 16px; border-radius: 14px; border: 1px solid var(--filet-nuit); background: var(--encre-2); color: var(--papier); font-size: 16px; }
.tv input::placeholder { color: #7D7568; }
.tv input:focus { outline: none; border-color: var(--craie); }
.tv .btn--craie:hover { background: var(--papier); color: var(--encre); }
.tv .btn[disabled] { opacity: .6; cursor: progress; }

.tv__trouves { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
.tv__trouves button { width: 100%; text-align: left; display: grid; gap: 2px; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--filet-nuit); background: transparent; cursor: pointer; transition: border-color .2s, background-color .2s; }
.tv__trouves button:hover, .tv__trouves button:focus-visible { border-color: var(--craie); background: var(--encre-2); }
.tv__trouves b { font-weight: 600; }
.tv__trouves small { color: var(--gris-nuit); font-size: 13px; }
.tv__trouves .hors { opacity: .55; cursor: not-allowed; }
.tv__autre { font-size: 14px; color: var(--gris-nuit); background: none; border: 0; padding: 4px 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; justify-self: start; }

.tv__voyants { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1px; background: var(--filet-nuit); border: 1px solid var(--filet-nuit); border-radius: 14px; overflow: hidden; }
.tv-v { min-width: 0; background: var(--nuit); padding: 14px; display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "p n" "v v" "d d"; column-gap: 8px; align-items: center; min-height: 104px; align-content: start; }
.tv-v__point { grid-area: p; width: 10px; height: 10px; border-radius: 50%; background: #4A443A; transition: background-color .5s, box-shadow .5s; }
.tv-v__nom { grid-area: n; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--gris-nuit); }
.tv-v__valeur { grid-area: v; font-family: var(--serif); font-weight: 400; font-size: 30px; line-height: 1.1; margin-top: 6px; }
.tv-v__vide { font-family: var(--grotesk); font-size: 15px; color: #7D7568; margin-top: 14px; }
.tv-v__detail { grid-area: d; font-size: 13px; line-height: 1.35; color: var(--gris-nuit); margin-top: 2px; }
.tv-v[data-etat="bon"] .tv-v__point { background: #4FBF7A; box-shadow: 0 0 12px #4FBF7A; }
.tv-v[data-etat="moyen"] .tv-v__point { background: var(--craie); box-shadow: 0 0 12px var(--craie); }
.tv-v[data-etat="faible"] .tv-v__point { background: #F06A2C; box-shadow: 0 0 12px #F06A2C; }
.tv-v.revele { animation: tv-revele .5s var(--sortie) both; animation-delay: calc(var(--i) * 140ms); }
@keyframes tv-revele { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.tv.cherche .tv-v__point { animation: tv-scan 1.2s ease-in-out infinite; animation-delay: calc(var(--i) * 200ms); }
@keyframes tv-scan { 50% { background: var(--craie); box-shadow: 0 0 10px var(--craie); } }

.tv__msg { margin: 0; font-size: 14px; color: var(--gris-nuit); min-height: 1.4em; }
.tv__msg:empty { display: none; }
.tv__msg a { color: var(--craie); }
.tv__sous { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--craie); margin: 0 0 10px; }
.tv__axes ol { margin: 0; padding: 0; list-style: none; counter-reset: axe; display: grid; gap: 10px; }
.tv__axes li { counter-increment: axe; display: grid; grid-template-columns: 30px 1fr; gap: 2px 8px; animation: tv-revele .5s var(--sortie) both; animation-delay: calc(560ms + var(--i) * 140ms); }
.tv__axes li::before { content: counter(axe, decimal-leading-zero); font-family: var(--mono); font-size: 12px; color: var(--gris-nuit); padding-top: 3px; grid-row: span 2; }
.tv__axes b { font-weight: 600; }
.tv__axes span { font-size: 14px; color: var(--gris-nuit); }
.tv__contact { display: grid; gap: 10px; border-top: 1px solid var(--filet-nuit); padding-top: 18px; }
.tv__contact .tv__sous { margin: 0; }
.tv__champs { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8px; }
.tv__piege { position: absolute; left: -9999px; width: 1px; height: 1px; }
.tv__note { margin: 0; font-size: 12px; color: var(--gris-nuit); }
@media (max-width: 520px) { .tv__champs { grid-template-columns: 1fr; } .tv-v__valeur { font-size: 26px; } .tv-v { min-height: 96px; } }
@media (prefers-reduced-motion: reduce) { .tv__direct, .tv.cherche .tv-v__point, .tv-v.revele, .tv__axes li { animation: none; } }
</style>

<script is:inline>
(function () {
  const tv = document.getElementById('test'); if (!tv || tv.dataset.pret) return; tv.dataset.pret = '1';
  const API = tv.dataset.api;
  const $ = (id) => document.getElementById(id);
  const form = $('tv-form'), q = $('tv-q'), trouves = $('tv-trouves'), msg = $('tv-msg');
  const axesBloc = $('tv-axes'), liste = $('tv-liste'), contact = $('tv-contact');
  const cases = [...tv.querySelectorAll('.tv-v')];
  cases.forEach((c, i) => c.style.setProperty('--i', i));
  const TEL = '<a href="tel:+41782133868">078 213 38 68</a>';
  let choix = null, resultat = null;

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const dire = (html) => { msg.innerHTML = html; };
  async function appel(route, corps) {
    const r = await fetch(API + route, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corps) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.erreur || 'Le test ne répond pas.');
    return d;
  }
  function remettre() {
    cases.forEach((c) => { c.dataset.etat = 'inconnu'; c.classList.remove('revele'); const val = c.querySelector('.tv-v__valeur'); val.textContent = 'à tester'; val.classList.add('tv-v__vide'); c.querySelector('.tv-v__detail').textContent = ''; });
    axesBloc.hidden = true; contact.hidden = true; liste.innerHTML = '';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bouton = form.querySelector('button');
    remettre(); trouves.hidden = true; bouton.disabled = true; dire('On cherche votre fiche sur Google…');
    try {
      const { trouves: t } = await appel('/recherche', { q: q.value.trim() });
      if (!t.length) { dire('Aucune fiche Google trouvée. Ajoutez la ville, ou appelez-nous au ' + TEL + ' : c’est déjà un premier constat.'); return; }
      dire('C’est lequel ?');
      trouves.innerHTML = t.map((g, i) => `<li><button type="button" data-i="${i}" ${g.accompagne ? '' : 'class="hors" aria-disabled="true"'}><b>${esc(g.nom)}</b><small>${esc(g.adresse)}${g.accompagne ? '' : ' · métier que nous n’accompagnons pas'}</small></button></li>`).join('')
        + '<li><button type="button" class="tv__autre" data-autre>Il n’est pas dans la liste</button></li>';
      trouves.hidden = false;
      trouves.querySelectorAll('button[data-i]').forEach((b) => b.addEventListener('click', () => { const g = t[+b.dataset.i]; if (g.accompagne) diagnostiquer(g); }));
      trouves.querySelector('[data-autre]').addEventListener('click', () => { trouves.hidden = true; dire('Précisez le nom exact et la ville, ou appelez-nous au ' + TEL + '.'); q.focus(); });
      trouves.querySelector('button')?.focus();
    } catch (err) {
      dire(esc(err.message) + ' Vous pouvez aussi nous appeler au ' + TEL + '.');
    } finally { bouton.disabled = false; }
  });

  async function diagnostiquer(g) {
    choix = g; trouves.hidden = true; remettre();
    tv.classList.add('cherche');
    const etapes = ['On lit votre fiche Google…', 'On ouvre votre site sur téléphone…', 'On cherche votre Instagram…', 'On regarde si l’on peut acheter ou réserver en ligne…'];
    let k = 0; dire(etapes[0]);
    const minuterie = setInterval(() => { k = Math.min(etapes.length - 1, k + 1); dire(etapes[k]); }, 2600);
    try {
      resultat = await appel('/audit', { placeId: g.placeId });
      resultat.voyants.forEach((v) => {
        const c = tv.querySelector(`.tv-v[data-id="${v.id}"]`); if (!c) return;
        c.dataset.etat = v.etat; c.querySelector('.tv-v__nom').textContent = v.titre;
        const val = c.querySelector('.tv-v__valeur'); val.textContent = v.valeur; val.classList.remove('tv-v__vide'); c.querySelector('.tv-v__detail').textContent = v.detail;
        c.classList.add('revele');
      });
      liste.innerHTML = resultat.axes.map((a, i) => `<li style="--i:${i}"><b>${esc(a.titre)}</b><span>Pour ${esc(a.gain)}. ${esc(a.offre)}.</span></li>`).join('');
      axesBloc.hidden = !resultat.axes.length;
      dire(resultat.axes.length ? `${esc(g.nom)} · ${esc(resultat.secteur.nom)}` : `${esc(g.nom)} : tous les voyants sont au vert. Bravo, on peut quand même en parler.`);
      contact.hidden = false;
    } catch (err) {
      dire(esc(err.message) + ' Appelez-nous au ' + TEL + ', on le fait avec vous.');
    } finally { clearInterval(minuterie); tv.classList.remove('cherche'); }
  }

  contact.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(contact), joindre = String(f.get('joindre') || '').trim();
    const estMail = joindre.includes('@');
    const bouton = contact.querySelector('button'); bouton.disabled = true;
    try {
      await appel('/demande', {
        nom: choix?.nom, contact: f.get('contact'), email: estMail ? joindre : null, telephone: estMail ? null : joindre,
        site: resultat?.site, categorie: resultat?.secteur?.nom, placeId: choix?.placeId, site_web_confirmation: f.get('site_web_confirmation'),
        resume: resultat ? resultat.voyants.map((v) => `${v.titre} : ${v.valeur}`).join(' · ') + ' | Axes : ' + resultat.axes.map((a) => a.titre).join(', ') : null,
      });
      contact.innerHTML = '<p class="tv__sous">C’est noté.</p><p style="margin:0">Malik vous rappelle le jour ouvré suivant avec votre plan. À très vite.</p>';
    } catch (err) {
      dire(esc(err.message)); bouton.disabled = false;
    }
  });
})();
</script>
