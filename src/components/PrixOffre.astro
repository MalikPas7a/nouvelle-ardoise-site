---
// Règle de Malik : aucun prix sur le site. Chaque offre affiche « Sur devis » ; le montant est donné au rendez-vous.
import { OFFRES } from '../data/offres.js';
const { id, accueil = false } = Astro.props;
const offre = OFFRES[id];
---
<p class={accueil ? 'price' : 'offre__prix'}>
  Sur devis
  <small>{offre.mensuel ? 'Abonnement mensuel, prix fixe annoncé avant de commencer' : 'Prix fixe, annoncé avant de commencer'}</small>
</p>
