---
// Fin de page : une phrase et le bouton vers le formulaire de contact.
// Avec `whatsapp`, le lien WhatsApp (numéro de config.js) vient à côté du bouton.
import { SITE } from '../config.js';
const { titre = 'Parlons de votre restaurant ou de votre boutique', texte = 'Réponse sous 24 heures avec un devis clair. Le premier rendez-vous est offert, chez vous.', whatsapp = false } = Astro.props;
---
<section class="bloc bloc--ardoise appel">
  <div class="cadre appel__in">
    <h2 class="titre-2">{titre}</h2>
    <p>{texte}</p>
    {whatsapp
      ? <div class="actions"><a class="btn btn--jaune" href="/contact/">Demander un devis</a><a class="lien" href={'https://wa.me/' + SITE.whatsapp}>WhatsApp · {SITE.telephone}</a></div>
      : <a class="btn btn--jaune" href="/contact/">Demander un devis</a>}
  </div>
</section>
