---
import PrixOffre from './PrixOffre.astro';
import { PROMOTION_ACTIVE } from '../data/offres.js';
---

  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="header" id="header">
    <a class="brand" href="#" aria-label="Nouvelle Ardoise, accueil"><svg viewBox="0 0 32 36" aria-hidden="true"><path d="M6 30V6l20 24V6"/></svg><span>Nouvelle <strong>Ardoise</strong></span></a>
    <nav class="desktop-nav" aria-label="Navigation principale"><a href="#univers">Vos univers</a><a href="#strategie">Acquisition & fidélité</a><a href="#forfaits">Forfaits</a><a href="#realisations">Réalisations</a></nav>
    <a class="nav-contact" href="#contact">Construire ma stratégie <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav"><span>Menu</span><i aria-hidden="true"></i></button>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Navigation sur téléphone" hidden><a href="#univers">Restaurants & artisans</a><a href="#strategie">Acquisition & fidélité</a><a href="#parcours">Click & collect</a><a href="#forfaits">Forfaits et prix</a><a href="#realisations">Réalisations</a><a href="#contact">Construire ma stratégie</a></nav>
  </header>

  <main id="contenu">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image" aria-hidden="true"><img src="/v4/assets/17173b6250b73a7ecfaf73d343177ae4667286386cf724a9164a733440bec72f.webp" alt="" width="1536" height="1024" fetchpriority="high"></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span></span> Marketing, acquisition & fidélisation.</p>
        <h1 id="hero-title">On ressent<br>votre cuisine.<br><em>Avant même<br>d’y goûter.</em></h1>
        <p class="hero-description">De nouveaux clients. Des clients qui reviennent. <br>Une stratégie construite avec vous, pour votre établissement.</p>
        <div class="hero-actions"><a class="button" href="#strategie">Construire ma stratégie <span aria-hidden="true">↗</span></a><a class="text-link" href="#forfaits">Découvrir les forfaits <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="hero-bottom"><p>Genève & Vaud <span>—</span> Restaurants & métiers de bouche</p><a class="scroll-cue" href="#approche">Entrer dans l’histoire <span aria-hidden="true">↓</span></a></div>
      <span class="hero-note" aria-hidden="true">Le goût commence avec les yeux.</span>
    </section>

    <section class="introduction" id="approche" aria-labelledby="intro-title">
      <p class="eyebrow reveal">L’émotion donne envie. La stratégie donne une direction.</p>
      <h2 class="reveal" id="intro-title">Attirer. Convertir.<br><em>Faire revenir.</em></h2>
      <p class="intro-description reveal">Nouvelle Ardoise est une agence de marketing et de communication à Genève, dédiée aux restaurants et artisans de bouche de Genève et Vaud. Votre savoir-faire est le point de départ. Nous relions l’image, les bons canaux et les bons outils pour développer votre clientèle — en salle, en boutique et à emporter.</p>
      <div class="intro-line reveal" aria-hidden="true"></div>
    </section>

    <section class="universes section" id="univers" aria-labelledby="univers-title">
      <div class="work-heading reveal"><div><p class="eyebrow">Restaurants & artisans du goût</p><h2 id="univers-title">Votre métier.<br><em>Votre propre univers.</em></h2></div><p class="universes-intro">La même exigence, deux langages.<br>Votre image garde le caractère de votre maison.</p></div>
      <div class="universe-grid">
        <a class="universe-card universe-restaurant reveal" href="/restaurants/">
          <div class="universe-top"><span class="eyebrow">01 / Restaurants</span><span aria-hidden="true">↗</span></div>
          <h3>Donner envie<br><em>de passer la porte.</em></h3>
          <p>La carte, le plat du jour, la réservation.<br>Du premier regard au prochain service.</p>
          <div class="universe-media"><img src="/v4/assets/8594da7d55822cd8876d6a5014e998305cd5160ce2a5db154082cd3c15356378.jpg" alt="Tagliatelle au ragù, exemple de plat signature." width="1200" height="750" loading="lazy"><span class="universe-menu">Le plat du jour<br><b>Votre signature, en lumière.</b><i>La carte · La réservation · À emporter</i></span></div>
          <div class="universe-bottom"><span>Carte · réservation · commandes</span><b>Explorer les restaurants ↗</b></div>
        </a>
        <a class="universe-card universe-artisan reveal" href="/artisans/">
          <div class="universe-top"><span class="eyebrow">02 / Artisans</span><span aria-hidden="true">↗</span></div>
          <h3>Vos créations.<br><em>Votre signature.</em></h3>
          <p>Chocolatiers, pâtissiers, boulangers.<br>Le geste à l’atelier, l’envie en vitrine.</p>
          <div class="universe-media"><img src="/v4/assets/35f0b7495d8914ecec738f9fce1acddde95d554249e4b76898ce6c2bf1330dc7.webp" alt="Une tarte artisanale présentée seule sur un fond clair." width="900" height="719" loading="lazy"><span class="artisan-note">Une création.<br>Tout votre savoir-faire.</span></div>
          <div class="universe-bottom"><span>Vitrine · précommandes · fidélité</span><b>Explorer les artisans ↗</b></div>
        </a>
      </div>
      <p class="universe-disclaimer">Univers issus des démonstrations du site. Pour votre maison : vos créations, vos couleurs et vos vrais gestes.</p>
    </section>

    <section id="motion-core" class="motion-core motion-static" aria-label="Du geste à la clientèle : un parcours illustratif">
  <div class="motion-pin">
    <div class="motion-fallback" aria-hidden="true">
      <img src="/v4/assets/17173b6250b73a7ecfaf73d343177ae4667286386cf724a9164a733440bec72f.webp" alt="" loading="lazy" decoding="async">
    </div>
    <div class="motion-canvas" aria-hidden="true">
      <canvas id="motion-canvas"></canvas>
    </div>
    <div class="motion-light" aria-hidden="true"></div>
    <div class="motion-grain" aria-hidden="true"></div>

    <div class="motion-top">
      <div class="motion-signature">
        <svg class="motion-signature-mark" viewBox="0 0 32 36" aria-hidden="true"><path d="M6 30V6l20 24V6" fill="none" stroke="#FFD23F" stroke-width="2" stroke-linecap="round"/></svg>
        <div><strong>Nouvelle Ardoise</strong><span>Du geste à la clientèle</span></div>
      </div>
      <a class="motion-skip" href="#strategie">Passer la scène <span aria-hidden="true">↗</span></a>
    </div>
    <span class="motion-demo-badge">Parcours illustratif</span>

    <div class="motion-copy">
      <article class="motion-beat" data-motion-beat="0" aria-hidden="false" style="--reveal:1;--lift:0px;--opacity:1">
        <p class="motion-chapter"><span>01</span> Le savoir-faire</p>
        <h2 class="motion-title"><span class="motion-line"><span>Tout part</span></span><span class="motion-line"><span>de <em>vos mains.</em></span></span></h2>
        <p class="motion-description">Avant les campagnes, il y a un geste. Une cuisine. Une histoire qui mérite d’être rencontrée.</p>
        <span class="motion-annotation">Le cœur de votre maison.</span>
      </article>
      <article class="motion-beat" data-motion-beat="1">
        <p class="motion-chapter"><span>02</span> Acquisition</p>
        <h2 class="motion-title"><span class="motion-line"><span>Donner envie.</span></span><span class="motion-line"><span><em>Au bon endroit.</em></span></span></h2>
        <p class="motion-description">Votre savoir-faire mis en lumière, auprès des personnes que vous voulez accueillir.</p>
        <span class="motion-annotation">Votre savoir-faire trouve son public.</span>
      </article>
      <article class="motion-beat" data-motion-beat="2">
        <p class="motion-chapter"><span>03</span> Conversion</p>
        <h2 class="motion-title"><span class="motion-line"><span>De l’envie</span></span><span class="motion-line"><span><em>à la commande.</em></span></span></h2>
        <p class="motion-description">Réservation, click &amp; collect : un parcours adapté à votre clientèle et à votre façon de travailler.</p>
        <span class="motion-annotation">Une envie. Un premier pas.</span>
      </article>
      <article class="motion-beat" data-motion-beat="3">
        <p class="motion-chapter"><span>04</span> Fidélité</p>
        <h2 class="motion-title"><span class="motion-line"><span>Une visite.</span></span><span class="motion-line"><span><em>Puis une habitude.</em></span></span></h2>
        <p class="motion-description">Un programme de fidélité pensé avec vous. Une relation qui grandit et donne envie de revenir.</p>
        <span class="motion-annotation">La suite d’une belle rencontre.</span>
      </article>
      <article class="motion-beat motion-beat-final" data-motion-beat="4">
        <p class="motion-chapter"><span>05</span> Sur mesure</p>
        <h2 class="motion-title"><span class="motion-line"><span>Votre restaurant.</span></span><span class="motion-line"><span>Votre rythme.</span></span><span class="motion-line"><span><em>Votre stratégie.</em></span></span></h2>
        <p class="motion-description">Votre clientèle, votre capacité, votre budget. Une stratégie d’acquisition 100 % personnalisable, dessinée ensemble.</p>
        <a class="motion-cta" href="#strategie">Dessiner votre stratégie <span aria-hidden="true">↗</span></a>
      </article>
    </div>

    <div class="motion-bottom">
      <div class="motion-progress" aria-hidden="true"><span></span></div>
      <nav class="motion-timeline" aria-label="Étapes de la scène">
        <button type="button" data-motion-go="0" class="is-active" aria-current="step"><span>01</span><span>Savoir-faire</span></button>
        <button type="button" data-motion-go="1"><span>02</span><span>Acquisition</span></button>
        <button type="button" data-motion-go="2"><span>03</span><span>Conversion</span></button>
        <button type="button" data-motion-go="3"><span>04</span><span>Fidélité</span></button>
        <button type="button" data-motion-go="4"><span>05</span><span>Sur mesure</span></button>
      </nav>
      <div class="motion-playback">
        <button id="motion-play" type="button" aria-pressed="false"><span class="motion-play-icon" aria-hidden="true"></span><span>Lire la scène</span></button>
        <button id="motion-reset" type="button" aria-label="Revenir au début de la scène"><span aria-hidden="true">↺</span></button>
      </div>
      <p class="motion-scroll-note">Faites défiler pour entrer dans l’histoire <span aria-hidden="true">↓</span></p>
    </div>
  </div>
</section>


    <section class="strategy section" id="strategie" aria-labelledby="strategy-title">
      <div class="strategy-heading reveal"><p class="eyebrow">On vient chez vous. On réfléchit avec vous.</p><span class="personal-badge">Stratégie 100 % personnalisable</span><h2 id="strategy-title">Votre établissement.<br>Vos objectifs.<br><em>Votre stratégie.</em></h2><p>Vos clients, vos services creux, votre capacité, votre marge et votre budget : on commence par vous écouter. Puis on choisit les leviers, le calendrier et l’accompagnement ensemble.</p></div>
      <div class="strategy-path reveal">
        <article><span>01</span><h3>Comprendre</h3><p>Votre clientèle, votre fonctionnement et ce que vous voulez développer.</p></article>
        <article><span>02</span><h3>Attirer</h3><p>Images, réseaux, présence locale et publicité auprès des bonnes personnes.</p></article>
        <article><span>03</span><h3>Convertir</h3><p>Un site, une réservation ou une commande en direct, selon votre métier.</p></article>
        <article><span>04</span><h3>Fidéliser</h3><p>Un programme adapté à votre marge, des nouvelles et un bilan pour ajuster.</p></article>
      </div>
      <div class="goal-picker reveal">
        <div class="goal-heading"><h3>Votre priorité, aujourd’hui ?</h3><p>Un point de départ à affiner lors de notre rencontre.</p></div>
        <div class="goal-buttons" role="group" aria-label="Choisir votre priorité"><button type="button" data-goal="salle" aria-pressed="true">Les services creux</button><button type="button" data-goal="commande" aria-pressed="false">Les commandes directes</button><button type="button" data-goal="fidelite" aria-pressed="false">Les clients qui reviennent</button></div>
        <div class="goal-result" aria-live="polite" aria-atomic="true"><span class="eyebrow" data-goal-label>Votre objectif / acquisition locale</span><h4 data-goal-title>Donner une raison de venir au bon moment.</h4><p data-goal-description>On étudie les créneaux à développer, la clientèle du quartier et votre capacité. Puis on relie contenus, ciblage local et réservation.</p><p class="goal-measure" data-goal-measure>Ce que l’on suit : demandes, appels et réservations sur les créneaux choisis.</p></div>
        <a class="text-link" href="#contact">Construire mon plan d’acquisition <span aria-hidden="true">↗</span></a>
      </div>
      <p class="strategy-boundary">Vos priorités, vos canaux et votre rythme sont personnalisables. Les prestations, le budget et le périmètre sont définis dans un devis clair.</p>
    </section>

    <section class="customer-paths section" id="parcours" aria-labelledby="paths-title">
      <div class="work-heading reveal"><div><p class="eyebrow">Des outils au service de la stratégie</p><h2 id="paths-title">Réserver. Commander.<br><em>Avoir envie de revenir.</em></h2></div><p class="universes-intro">L’image attire.<br>Le parcours client fait le lien avec votre activité.</p></div>
      <div class="customer-path-grid">
        <article class="customer-path-card collect-card reveal">
          <div class="path-copy"><span class="eyebrow">Click & collect / option sur devis</span><h3>Votre cuisine,<br><em>à leur rythme.</em></h3><p>Commander sur votre site, choisir un retrait et venir chercher son plat ou ses créations. Le parcours se choisit avec vous ; paiement carte ou TWINT selon la solution retenue.</p></div>
          <div class="collect-demo"><span class="demo-label">Exemple de commande</span><div class="demo-product"><img src="/v4/assets/8594da7d55822cd8876d6a5014e998305cd5160ce2a5db154082cd3c15356378.jpg" alt="Exemple de plat à emporter." width="1200" height="750" loading="lazy"><div><b>Votre plat du jour</b><span>Préparé chez vous. Retiré sur place.</span></div></div><label for="pickup-slot">Choisir un retrait</label><select id="pickup-slot"><option>12:00</option><option>12:30</option><option>13:00</option></select><button class="demo-button" type="button" id="collect-test">Essayer le retrait</button><p class="demo-status" id="collect-result" role="status">Exemple interactif, aucune commande envoyée.</p></div>
          <a class="text-link" href="/contact/">Étudier mon click & collect <span aria-hidden="true">↗</span></a>
        </article>
        <article class="customer-path-card loyalty-card reveal" id="fidelite">
          <div class="path-copy"><span class="eyebrow">Programme de fidélité / sur mesure</span><h3>Une première visite.<br><em>Une belle habitude.</em></h3><p>Nous définissons ensemble le programme : inscription volontaire, visites ou achats pris en compte, avantages et invitations. Les règles et les récompenses respectent votre activité et votre marge.</p></div>
          <div class="loyalty-demo"><span class="demo-label">Exemple de programme à concevoir</span><div class="loyalty-title"><b>Votre maison.</b><span>Le plaisir de revenir.</span></div><div class="loyalty-stamps" aria-label="Deux visites sur six dans cet exemple"><i class="stamped">✓</i><i class="stamped">✓</i><i>03</i><i>04</i><i>05</i><i>06</i></div><p class="loyalty-progress" role="status">2 / 6 visites · avantage à définir ensemble</p><div class="loyalty-actions"><button class="demo-button" type="button" id="loyalty-test">Simuler une visite</button><button class="demo-reset" type="button" id="loyalty-reset">Recommencer</button></div></div>
          <a class="text-link" href="/contact/">Concevoir mon programme <span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <p class="universe-disclaimer">Ces exemples illustrent le parcours. Solution technique, conditions, intégration et coût sont définis avec vous dans le devis.</p>
    </section>

    <section class="expertise section" id="savoir-faire" aria-labelledby="expertise-title">
      <div class="section-heading reveal"><p class="eyebrow">Toutes les pièces de votre accompagnement</p><h2 id="expertise-title">Une stratégie.<br><em>Les bons leviers.</em></h2><p>Une seule prestation ou tout un accompagnement.<br>Chaque levier répond à un objectif défini ensemble.</p></div>
      <div class="services reveal">
        <details open><summary><span class="service-number">01</span><h3>Photos & vidéos</h3><span class="service-short">Votre savoir-faire, en lumière</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Vos plats, vos gestes, votre équipe. Nous venons chez vous pour créer les images qui racontent votre cuisine et nourrissent votre communication.</p><a class="text-link" href="/realisations/">Voir nos réalisations <span aria-hidden="true">↗</span></a></div></details>
        <details><summary><span class="service-number">02</span><h3>Sites web</h3><span class="service-short">De l’envie à la réservation</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Une carte lisible, vos horaires, votre univers et la réservation en un geste. Un site pensé pour le téléphone, qui rend la visite simple.</p><a class="text-link" href="/restaurants/">Essayer trois exemples <span aria-hidden="true">↗</span></a></div></details>
        <details><summary><span class="service-number">03</span><h3>Réseaux sociaux</h3><span class="service-short">Votre cuisine, au quotidien</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Reels, publications et menu du jour : des contenus cohérents, publiés régulièrement pour faire découvrir vos plats et garder le lien.</p><a class="text-link" href="/offres/#reseaux">Découvrir les abonnements <span aria-hidden="true">↗</span></a></div></details>
        <details><summary><span class="service-number">04</span><h3>Design & identité</h3><span class="service-short">Une signature qui vous ressemble</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Logo, carte, menus, supports en salle et emballages : une image cohérente, de votre première publication à la dernière bouchée.</p><a class="text-link" href="/offres/#design">Parlons de votre identité <span aria-hidden="true">↗</span></a></div></details>
        <details><summary><span class="service-number">05</span><h3>Acquisition & publicité</h3><span class="service-short">Les bonnes personnes, au bon moment</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Ciblage local, campagnes Meta et Google, avis et bilan mensuel : on choisit les canaux avec vous. La gestion des publicités est proposée dans Réseaux Premium ; le budget média est séparé.</p><a class="text-link" href="#forfaits">Comparer les forfaits <span aria-hidden="true">↗</span></a></div></details>
        <details><summary><span class="service-number">06</span><h3>Fidélité & relation client</h3><span class="service-short">Du premier client à l’habitué</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Un programme à concevoir avec vous : règles, avantages, outil et rythme de communication. Le périmètre et le coût se définissent sur devis, en fonction de votre activité.</p><a class="text-link" href="#fidelite">Essayer le parcours de fidélité <span aria-hidden="true">↗</span></a></div></details>
        <details><summary><span class="service-number">07</span><h3>Click & collect et commande</h3><span class="service-short">Faciliter la commande en direct</span><span class="service-plus" aria-hidden="true">+</span></summary><div class="service-content"><p>Nous branchons la solution adaptée à votre site : commande, retrait, carte ou TWINT. Click & collect, paiement en ligne et réservation sont des options chiffrées sur devis.</p><a class="text-link" href="#parcours">Découvrir un exemple <span aria-hidden="true">↗</span></a></div></details>
      </div>
      <a class="offers-link" href="/offres/">Des prix affichés. Un devis clair. <span>Voir les offres ↗</span></a>
    </section>

    <section class="packages section" id="forfaits" aria-labelledby="packages-title">
      <div class="work-heading reveal"><div><p class="eyebrow">Forfaits disponibles & accompagnement sur mesure</p><h2 id="packages-title">Un cadre clair.<br><em>Une stratégie à vous.</em></h2></div><p class="universes-intro">Des points de départ lisibles.<br>Un accompagnement choisi selon vos objectifs.</p></div>
      <div class="package-tabs" role="group" aria-label="Choisir une famille de forfaits"><button type="button" data-package="sites" aria-pressed="true">Votre site</button><button type="button" data-package="reseaux" aria-pressed="false">Réseaux & acquisition</button><button type="button" data-package="ponctuel" aria-pressed="false">Ponctuel & sur mesure</button></div>
      <div class="package-panel" data-panel="sites"><h3 class="package-family">Les sites web</h3><div class="package-grid">
        <article class="package-card"><span class="eyebrow">Site Essentiel</span><h3>Le bon départ.</h3><PrixOffre id="essentiel" accueil /><ul><li>Site pensé pour le téléphone</li><li>Carte, horaires, plan</li><li>Fiche Google</li></ul><a class="text-link" href="/contact/?offre=Essentiel">Parler de mon site ↗</a></article>
        <article class="package-card package-featured"><span class="eyebrow">Site Signature</span><h3>Votre univers.</h3><PrixOffre id="signature" accueil /><ul><li>Tout l’Essentiel</li><li>Plat signature animé, carte redessinée</li><li>Deux heures de shooting offertes</li></ul><a class="text-link" href="/contact/?offre=Signature">Mettre ma signature en lumière ↗</a></article>
        <article class="package-card"><span class="eyebrow">Site Maison</span><h3>L’expérience complète.</h3><PrixOffre id="maison" accueil /><ul><li>Tout Signature, puis l’entretien</li><li>Photographe et plats en 3D</li><li>Carte en deux langues</li></ul><a class="text-link" href="/contact/?offre=Maison">Construire l’expérience ↗</a></article>
      </div></div>
      <div class="package-panel" data-panel="reseaux"><h3 class="package-family">Les réseaux et l’acquisition</h3><div class="package-grid">
        <article class="package-card"><span class="eyebrow">Réseaux Essentiel</span><h3>Présent au quotidien.</h3><PrixOffre id="reseauxEssentiel" accueil /><ul><li>Une heure de shooting par mois</li><li>Quatre Reels, menu du jour publié</li><li>Entretien du site</li></ul><a class="text-link" href="/contact/?offre=R%C3%A9seaux%20Essentiel">Parler de mes contenus ↗</a></article>
        <article class="package-card package-featured"><span class="eyebrow">Réseaux Premium</span><h3>Activer l’acquisition.</h3><PrixOffre id="reseauxPremium" accueil /><ul><li>Deux heures de tournage par mois</li><li>Quatre Reels et huit publications</li><li>Publicités Meta / Google gérées, bilan</li></ul><p class="package-extra">Budget publicitaire payé séparément.</p><a class="text-link" href="/contact/?offre=R%C3%A9seaux%20Premium">Construire mon acquisition ↗</a></article>
        <article class="package-card package-note"><span class="eyebrow">Un travail ensemble</span><h3>Vos priorités.<br>Votre rythme.</h3><p>Les canaux, les contenus et le calendrier suivent votre stratégie. Les moyens engagés restent annoncés clairement.</p><p class="package-extra">Réseaux Essentiel et Premium : trois mois minimum, puis sans engagement.</p><a class="text-link" href="/offres/#reseaux">Comparer les détails ↗</a></article>
      </div></div>
      <div class="package-panel" data-panel="ponctuel"><h3 class="package-family">Les projets ponctuels et les options</h3><div class="package-grid">
