---
// Gabarit « Cartographe » (29.10.2026) : l'accueil tous métiers et la page /test/.
// Papier et encre, Instrument Serif pour les titres, Inter Tight pour le texte, IBM Plex Mono pour les repères.
// L'appel à l'action « Tester ma visibilité » reste toujours à portée : bouton dans l'en-tête, barre fixe sur téléphone
// (un seul bouton jaune à la fois : celui de l'en-tête s'efface quand la barre apparaît).
// entete="flottant" (accueil « Ardoise vivante », 31.10.2026) : en-tête en pastilles posées sur les grands aplats de couleur,
// menu replié à toutes les tailles, barre du bas toujours là sur téléphone (sauf quand le test est à l'écran).
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter-tight';
import '@fontsource/ibm-plex-mono/400.css';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import grotesqueUrl from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import { SITE } from '../config.js';
import { VILLES_SEO } from '../data/villes-seo.js';

const {
  title, description, chemin = '/', jsonLd = null, test = '/#test',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1',
  cta = 'test', barre = true, image = '/partage.jpg', entete = 'classique', teinte = '#F2EDE4',
  imageAlt = 'Nouvelle Ardoise, agence de marketing et de communication à Genève et en Suisse romande',
} = Astro.props;
const flottant = entete === 'flottant';
const canonical = SITE.url + chemin;
const imageUrl = SITE.url + image;
const MENU = [
  { href: '/#savoir-faire', nom: 'Savoir-faire' },
  { href: '/#metiers', nom: 'Métiers' },
  { href: '/restauration/', nom: 'Restauration', page: '/restauration/' },
  { href: '/entreprises-ia/', nom: 'Entreprises & IA', page: '/entreprises-ia/' },
  { href: '/realisations/', nom: 'Réalisations', page: '/realisations/' },
  { href: '/contact/', nom: 'Contact', page: '/contact/' },
];
import Analytique from '../components/Analytique.astro';
---
<!doctype html>
<html lang="fr-CH">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="theme-color" content={teinte} />
  <meta name="robots" content={robots} />
  <meta name="geo.region" content="CH-GE" />
  <meta name="geo.placename" content="Genève" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" as="font" type="font/woff2" href={serifUrl} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={grotesqueUrl} crossorigin />
  <link rel="preconnect" href="https://nouvelle-ardoise-app.vercel.app" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.nom} />
  <meta property="og:locale" content="fr_CH" />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  <style is:global>
:root {
  --papier: #F2EDE4;
  --papier-2: #EAE3D6;
  --encre: #1B1915;
  --encre-2: #2A2620;
  --gris: #6A6359;
  --gris-nuit: #A39B8D;
  --filet: #DCD3C4;
  --filet-nuit: #3B362E;
  --craie: #FFD23F;
  --serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
  --grotesk: 'Inter Tight Variable', 'Inter Tight', 'Helvetica Neue', Arial, sans-serif;
  --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
  --max: 1240px;
  --r-s: 12px;
  --r-m: 16px;
  --r-l: 22px;
  --sortie: cubic-bezier(.2, .8, .2, 1);
  color-scheme: light;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 84px; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body { margin: 0; background: var(--papier); color: var(--encre); font-family: var(--grotesk); font-size: 17px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
a { color: inherit; }
img { display: block; max-width: 100%; height: auto; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--encre); outline-offset: 3px; }
.nuit :focus-visible { outline-color: var(--craie); }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.evitement { position: absolute; left: 16px; top: -200px; z-index: 50; padding: 10px 14px; background: var(--craie); color: var(--encre); border-radius: 999px; font-weight: 600; text-decoration: none; }
.evitement:focus-visible { top: 12px; }
.cadre { max-width: var(--max); margin-inline: auto; padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px)); }
.etiquette { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--gris); margin: 0; }
.serif { font-family: var(--serif); font-weight: 400; letter-spacing: -.01em; }
.surligne { background: linear-gradient(transparent 60%, var(--craie) 60% 92%, transparent 92%); padding-inline: .06em; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 999px; background: var(--encre); color: var(--papier); text-decoration: none; font-weight: 600; font-size: 15px; border: 1px solid var(--encre); cursor: pointer; transition: background-color .2s, color .2s, transform .15s var(--sortie); white-space: nowrap; }
.btn:active { transform: scale(.97); }
.btn--craie { background: var(--craie); color: var(--encre); }
.btn--creux { background: transparent; color: var(--encre); }
.btn--petit { min-height: 40px; padding: 0 16px; font-size: 14px; }
@media (hover: hover) and (pointer: fine) {
  .btn:hover { background: var(--craie); color: var(--encre); }
  .btn--craie:hover { background: var(--encre); color: var(--papier); }
}

body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--papier); }
.tete { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: color-mix(in srgb, var(--papier) 92%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--filet); }
.tete .cadre { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 66px; }
.marque { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; letter-spacing: -.01em; white-space: nowrap; }
.marque svg { width: 22px; height: 25px; flex: none; }
.marque svg path { fill: none; stroke: var(--encre); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.nav { display: flex; gap: 26px; align-items: center; font-size: 15px; }
.nav a:not(.btn) { text-decoration: none; }
.nav__lien[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
.nav .tel { font-family: var(--mono); font-size: 13px; }
@media (hover: hover) and (pointer: fine) { .nav a:not(.btn):hover { text-decoration: underline; text-underline-offset: 4px; } }
.cta__court { display: none; }
/* Menu replié sur tablette et téléphone : les mêmes entrées, sous le pouce */
.menu { display: none; position: relative; }
.menu summary { list-style: none; cursor: pointer; width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--encre); border-radius: 50%; }
.menu summary::-webkit-details-marker { display: none; }
.menu__trait { position: relative; display: block; width: 16px; height: 1.6px; background: var(--encre); border-radius: 2px; transition: background-color .2s; }
.menu__trait::before, .menu__trait::after { content: ""; position: absolute; left: 0; width: 16px; height: 1.6px; background: var(--encre); border-radius: 2px; transition: transform .25s var(--sortie); }
.menu__trait::before { top: -5px; } .menu__trait::after { top: 5px; }
.menu[open] .menu__trait { background: transparent; }
.menu[open] .menu__trait::before { transform: translateY(5px) rotate(45deg); }
.menu[open] .menu__trait::after { transform: translateY(-5px) rotate(-45deg); }
.menu__liste { position: absolute; right: 0; top: calc(100% + 10px); margin: 0; padding: 8px; list-style: none; min-width: 236px; background: var(--papier); border: 1px solid var(--filet); border-radius: var(--r-m); box-shadow: 0 24px 48px -24px rgb(27 25 21 / .45); }
.menu__liste a { display: flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 10px; text-decoration: none; font-size: 16px; font-weight: 500; }
.menu__liste a[aria-current="page"] { background: var(--papier-2); }
.menu__tel { font-family: var(--mono); font-size: 14px; color: var(--gris); }
@media (max-width: 960px) { .nav { gap: 8px; } .nav .nav__lien { display: none; } .menu { display: block; } }
/* Quand la barre fixe est ouverte, le bouton d'en-tête disparaît franchement : un fondu laissait un rectangle à moitié peint sur Safari iOS. */
@media (max-width: 760px) { body.barre-ouverte .nav .btn { display: none; } }
@media (max-width: 480px) { .cta__long { display: none; } .cta__court { display: inline; } .btn--petit { padding: 0 14px; } }
@media (max-width: 380px) { .tete .cadre { gap: 10px; } .marque { font-size: 16px; } }

.pied { border-top: 1px solid var(--filet); padding-block: 28px calc(28px + env(safe-area-inset-bottom, 0px)); font-size: 14px; color: var(--gris); }
.pied .cadre { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; }
.pied a { text-decoration: none; }
@media (hover: hover) and (pointer: fine) { .pied a:hover { text-decoration: underline; } }

/* Barre fixe sur téléphone : l'appel à l'action toujours sous le pouce (inerte et invisible tant qu'elle est rangée) */
.barre { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; display: none; gap: 8px; padding: 10px max(12px, env(safe-area-inset-left, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)); background: color-mix(in srgb, var(--papier) 94%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--filet); transform: translateY(110%); visibility: hidden; transition: transform .35s var(--sortie), visibility 0s linear .35s; }
.barre.visible { transform: none; visibility: visible; transition: transform .35s var(--sortie), visibility 0s; }
.barre .btn { flex: 1; }
.barre .btn--creux { flex: 0 0 auto; padding: 0 18px; }
@media (max-width: 760px) { .barre { display: flex; } body.a-barre .pied { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)); } }
@media (prefers-reduced-motion: reduce) { .barre, .menu__trait, .menu__trait::before, .menu__trait::after { transition: none; } }

/* En-tête flottant : marque, bouton du test et menu en pastilles ardoise, sans bandeau ; le contenu passe dessous */
body.flottant::before { background: #1E2427; }
.tete--flottante { position: fixed; top: 0; left: 0; right: 0; padding-top: calc(env(safe-area-inset-top, 0px) + 14px); background: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; pointer-events: none; }
.tete--flottante .cadre { max-width: none; min-height: 0; padding-left: max(clamp(20px, 5vw, 72px), env(safe-area-inset-left, 0px)); padding-right: max(clamp(20px, 5vw, 72px), env(safe-area-inset-right, 0px)); }
.tete--flottante .marque, .tete--flottante .nav { pointer-events: auto; }
.tete--flottante .marque { min-height: 44px; padding: 0 16px 0 12px; border-radius: 999px; background: #1E2427; color: var(--papier); border: 1px solid rgb(242 237 228 / .16); font-weight: 600; font-size: 15px; }
.tete--flottante .marque svg path { stroke: var(--papier); }
.tete--flottante .nav { gap: 8px; }
.tete--flottante .menu { display: block; }
.tete--flottante .menu summary { width: 44px; height: 44px; background: #1E2427; border-color: rgb(242 237 228 / .3); }
.tete--flottante .menu__trait, .tete--flottante .menu__trait::before, .tete--flottante .menu__trait::after { background: var(--papier); }
.tete--flottante .menu[open] .menu__trait { background: transparent; }
.cta__duree { font-family: var(--mono); font-size: 12px; font-weight: 400; padding: 3px 7px; border-radius: 999px; background: #1E2427; color: var(--craie); transition: inherit; }
.tete__cta { min-height: 44px; padding: 0 18px; font-size: 16px; }
body.flottant .barre { background: none; border: 0; -webkit-backdrop-filter: none; backdrop-filter: none; padding: 10px max(clamp(20px, 5vw, 72px), env(safe-area-inset-left, 0px)) calc(12px + env(safe-area-inset-bottom, 0px)); }
body.flottant .barre .btn { font-size: 16px; }
body.flottant .barre .btn--creux { background: #1E2427; color: var(--papier); border: 1.5px solid rgb(242 237 228 / .3); }
body.flottant .pied { background: #1F3D33; color: rgb(242 237 228 / .74); border-top-color: rgb(242 237 228 / .16); }
@media (max-width: 899px) {
  .tete--flottante .tete__cta { display: none; }
  body.flottant .barre { display: flex; }
  body.flottant.a-barre .pied { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)); }
}
/* Téléphone à l'horizontale : le bouton du test remonte dans l'en-tête, la barre du bas laisse la place */
@media (max-height: 520px) {
  .tete--flottante .tete__cta, body.flottant.barre-ouverte .nav .tete__cta { display: inline-flex; }
  body.flottant .barre { display: none; }
  body.flottant.a-barre .pied { padding-bottom: calc(28px + env(safe-area-inset-bottom, 0px)); }
}
@media (max-width: 370px) { body.flottant .barre { gap: 6px; } body.flottant .barre .btn { padding: 0 14px; font-size: 15px; } .barre .cta__duree { display: none; } }
  </style>
  <Analytique />
</head>
<body class:list={[{ 'a-barre': barre, flottant }]}>
<a class="evitement" href="#contenu">Aller au contenu</a>
<header class:list={['tete', { 'tete--flottante': flottant }]}>
  <div class="cadre">
    <a class="marque" href="/" aria-label="Nouvelle Ardoise, accueil"><svg viewBox="0 0 32 36" aria-hidden="true"><path d="M6 30V6l20 24V6"/></svg><span>Nouvelle Ardoise</span></a>
    <nav class="nav" aria-label="Navigation principale">
      {!flottant && MENU.map((m) => <a class="nav__lien" href={m.href} aria-current={m.page === chemin ? 'page' : undefined}>{m.nom}</a>)}
      {!flottant && <a class="tel nav__lien" href="tel:+41782133868">078 213 38 68</a>}
      {flottant ? <a class="btn btn--craie tete__cta" href={test} data-cta>Tester ma visibilité <small class="cta__duree">30&nbsp;s</small></a> : cta === 'test'
        ? <a class="btn btn--craie btn--petit" href={test} data-cta><span class="cta__long">Tester ma visibilité</span><span class="cta__court">Tester</span></a>
        : <a class="btn btn--creux btn--petit" href="tel:+41782133868">Appeler</a>}
      <details class="menu" id="menu">
        <summary aria-label="Menu"><span class="menu__trait" aria-hidden="true"></span></summary>
        <ul class="menu__liste">
          {MENU.map((m) => <li><a href={m.href} aria-current={m.page === chemin ? 'page' : undefined}>{m.nom}</a></li>)}
          <li><a class="menu__tel" href="tel:+41782133868">078 213 38 68</a></li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<main id="contenu">
  <slot />
</main>

<footer class="pied"><div class="cadre"><span>Nouvelle Ardoise · Agence de marketing et de communication · {SITE.adresse}, {SITE.localite} · 078 213 38 68 · Genève et toute la Suisse romande</span><span><a href="/restauration/">Restauration</a> · <a href="/entreprises-ia/">Entreprises &amp; IA</a> · <a href="/artisans/">Artisans</a> · <a href="/realisations/">Réalisations</a> · <a href="/contact/">Contact</a> · <a href="/questions/">Questions</a> · <a href="/mentions-legales/">Mentions légales</a> · <a href="/confidentialite/">Confidentialité</a></span><span>Agence marketing : <a href="/">Genève</a>{VILLES_SEO.map((v) => <> · <a href={`/agence-marketing/${v.id}/`}>{v.ville}</a></>)}</span></div></footer>

{barre && <nav class="barre" id="barre" aria-label="Actions rapides" data-toujours={flottant ? '' : undefined} inert>
  <a class="btn btn--craie" href={test} data-cta>Tester ma visibilité{flottant && <small class="cta__duree">30&nbsp;s</small>}</a>
  <a class="btn btn--creux" href="tel:+41782133868" aria-label="Appeler le 078 213 38 68">Appeler</a>
</nav>}

<script is:inline>
(function () {
  const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Les boutons « Tester ma visibilité » amènent au test et placent le curseur dans le champ, en un seul geste.
  document.querySelectorAll('[data-cta]').forEach((a) => a.addEventListener('click', (e) => {
    const cible = document.getElementById('test'); if (!cible) return;
    e.preventDefault();
    if (window.lenis) window.lenis.scrollTo(cible, { offset: -84 }); // défilement doux de l'accueil
    else cible.scrollIntoView({ block: 'start', behavior: calme ? 'auto' : 'smooth' });
    const champ = document.getElementById('tv-q'); if (champ) champ.focus({ preventScroll: true });
  }));
  // Le menu replié : se ferme après un choix, d'un clic à côté ou avec Échap.
  const menu = document.getElementById('menu');
  if (menu) {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));
    document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target)) menu.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus(); } });
  }
  // La barre du bas apparaît une fois l'ouverture dépassée, et se range quand le test ou la section finale (mêmes boutons) est à l'écran.
  const barre = document.getElementById('barre'); if (!barre) return;
  const toujours = barre.hasAttribute('data-toujours'); // accueil : le bouton du test reste sous le pouce dès l'ouverture
  const vus = new Set();
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? vus.add(e.target) : vus.delete(e.target))); maj(); }, { threshold: 0, rootMargin: '0px 0px -25% 0px' });
    (toujours ? ['test'] : ['test', 'contact']).map((id) => document.getElementById(id)).filter(Boolean).forEach((el) => io.observe(el));
  }
  function maj() {
    const on = (toujours || scrollY > innerHeight * .6) && !vus.size;
    barre.classList.toggle('visible', on); barre.inert = !on; document.body.classList.toggle('barre-ouverte', on);
  }
  addEventListener('scroll', maj, { passive: true }); maj();
})();
</script>
<script>
  import '../scripts/mesure.js';
</script>
</body>
</html>
