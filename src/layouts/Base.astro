---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import { SITE } from '../config.js';

const { title, description, page } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const lien = (ancre) => (page === 'accueil' ? ancre : '/' + ancre);
---
<!doctype html>
<html lang="fr" data-resto="osteria">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="fr_CH">
<meta name="theme-color" content="#1E2A2C">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<!-- Le navigateur prépare la page suivante dès qu'on survole un lien interne -->
<script type="speculationrules" is:inline>
{"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/demos/*"}}]},"eagerness":"moderate"}]}
</script>
<slot name="head" />
</head>
<body>
<a class="evite" href="#contenu">Aller au contenu</a>
<div class="avancee" aria-hidden="true"></div>
<header class="nav">
  <a class="logo" href="/" aria-label="Nouvelle Ardoise, accueil">
    <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true"><rect width="28" height="28" rx="6" fill="currentColor"/><path d="M7 20V8l14 12V8" fill="none" stroke="#FFD23F" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Nouvelle Ardoise</span>
  </a>
  <nav aria-label="Navigation principale">
    <a href={lien('#exemples')}>Exemples</a>
    <a href={lien('#offres')}>Offres</a>
    <a href={lien('#methode')}>Méthode</a>
    <a class="btn btn--petit" href={lien('#contact')}><span class="nav__long">Demander un devis</span><span class="nav__court">Devis</span></a>
  </nav>
</header>

<main id="contenu">
<slot />
</main>

<footer class="pied">
  <div class="cadre pied__in">
    <p><strong>Nouvelle Ardoise</strong><br>Sites, cartes et menus en 3D pour les restaurants de Genève et Vaud.</p>
    <p>Osteria del Lago, Chez Léonie et Sora sont des restaurants inventés pour ces démonstrations.</p>
    <p><a href={lien('#offres')}>Offres et prix</a><br><a href={'mailto:' + SITE.email}>{SITE.email}</a><br><a href="/mentions-legales/">Mentions légales</a><br><a href="/confidentialite/">Confidentialité et cookies</a></p>
  </div>
</footer>
</body>
</html>
