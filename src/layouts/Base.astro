---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE } from '../config.js';

const { title, description, page } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Le menu : une page par sujet. La page en cours est signalée (aria-current).
const MENU = [
  { href: '/restaurants/', nom: 'Restaurants', page: 'restaurants' },
  { href: '/artisans/', nom: 'Artisans', page: 'artisans' },
  { href: '/realisations/', nom: 'Réalisations', page: 'realisations' },
  { href: '/offres/', nom: 'Offres', page: 'offres' },
];
const actuel = (p) => (p === page ? 'page' : undefined);
// Le rappel de l'offre de lancement, en haut de chaque page (sauf les animations plein écran)
const lancement = page !== 'animation';
---
<!doctype html>
<html lang="fr" data-resto="osteria">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="fr_CH">
<meta name="theme-color" content="#1E2A2C">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<!-- Le navigateur prépare la page suivante dès qu'on survole un lien interne -->
<script type="speculationrules" is:inline>
{"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/demos/*"}}]},"eagerness":"moderate"}]}
</script>
<slot name="head" />
</head>
<body>
<a class="evite" href="#contenu">Aller au contenu</a>
<div class="avancee" aria-hidden="true"></div>
<header class="nav">
  <Logo />
  <nav class="nav__liens" aria-label="Navigation principale">
    {MENU.map((m) => <a href={m.href} aria-current={actuel(m.page)}>{m.nom}</a>)}
    <a class="btn btn--petit" href="/contact/" aria-current={actuel('contact')}><span class="nav__long">Demander un devis</span><span class="nav__court">Devis</span></a>
  </nav>
  <!-- Sur téléphone, les pages passent dans un menu déroulant (sans JavaScript) -->
  <details class="menu">
    <summary>Menu</summary>
    <nav class="menu__liste" aria-label="Menu">
      <a href="/" aria-current={actuel('accueil')}>Accueil</a>
      {MENU.map((m) => <a href={m.href} aria-current={actuel(m.page)}>{m.nom}</a>)}
      <a href="/contact/" aria-current={actuel('contact')}>Contact</a>
    </nav>
  </details>
</header>

<main id="contenu">
{lancement && <a class="lancement" href="/offres/"><b>Offre de lancement</b> −20 % sur toutes nos offres jusqu’au 31 octobre 2026 <span aria-hidden="true">→</span></a>}
<slot />
</main>

<footer class="pied">
  <div class="cadre pied__in">
    <div class="pied__marque">
      <Logo label="Nouvelle Ardoise, retour à l’accueil" />
      <p>Agence de marketing digital pour les restaurants et boutiques gourmandes de Genève et Vaud : sites, vidéo et réseaux sociaux.</p>
    </div>
    <p>Osteria del Lago, Chez Léonie, Sora et la pizzeria des animations sont des restaurants inventés pour ces démonstrations.</p>
    <p><a href="/restaurants/">Restaurants</a><br><a href="/artisans/">Artisans</a><br><a href="/realisations/">Réalisations</a><br><a href="/offres/">Offres et prix</a><br><a href="/contact/">Contact</a></p>
    <p><a href={'mailto:' + SITE.email}>{SITE.email}</a><br><a href="/mentions-legales/">Mentions légales</a><br><a href="/confidentialite/">Confidentialité et cookies</a></p>
  </div>
</footer>
<script>
  import '../scripts/boutons.js';
</script>
</body>
</html>
